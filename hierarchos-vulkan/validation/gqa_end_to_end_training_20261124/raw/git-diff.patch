+            "the grouped-query matrix did not run to completion"
+        );
+        assert_eq!(scalar_dispatches, 12);
+        assert_eq!(query_dispatches, 12);
+        assert_eq!(key_dispatches, 12);
+        Ok(())
+    }
+
+    /// The production route for a qualified grouped geometry, end to end.
+    ///
+    /// The numerical test above drives the pair directly so it can observe
+    /// scratch coverage between the passes; this one goes through
+    /// `VulkanTransformerLayer::record_backward`, which is the code path training
+    /// actually runs, and reads the dispatch counters the layer recorded. A
+    /// qualified geometry must select the pair, dispatch both passes exactly once
+    /// per backward call, never touch the scalar kernel, and allocate its scratch
+    /// once. A divisible-but-unmeasured geometry must do none of that.
+    #[test]
+    fn grouped_query_attention_production_route_dispatches_both_passes() -> Result<()> {
+        use two_pass_attention_test_hooks::ShaderFault;
+        let Ok(device) = VulkanDevice::new() else {
+            eprintln!(
+                "gqa production-route qualification: status=BLOCKED reason=no_vulkan_device"
+            );
+            return Ok(());
+        };
+        // 8 query heads / 2 KV heads at the qualified head dimension and
+        // sequence shape, through the real layer.
+        let (heads, kv_heads, head_dim, batch, seq) = (8, 2, 128, 2, 64);
+        let scalar = run_attention_backward_step(
+            &device,
+            Some(Some(false)),
+            None,
+            heads,
+            kv_heads,
+            head_dim,
+            batch,
+            seq,
+        )?;
+        assert!(scalar.counts.scalar > 0, "the =0 baseline never dispatched");
+        assert_eq!(scalar.counts.query, 0);
+        assert_eq!(scalar.counts.key, 0);
+        assert_eq!(scalar.counts.scratch_allocations, 0);
+
+        let accelerated = run_attention_backward_step(
+            &device,
+            Some(None),
+            None,
+            heads,
+            kv_heads,
+            head_dim,
+            batch,
+            seq,
+        )?;
+        assert_eq!(
+            accelerated.counts.query, 1,
+            "the query pass did not dispatch exactly once"
+        );
+        assert_eq!(
+            accelerated.counts.key, 1,
+            "the promoted key pass did not dispatch exactly once"
+        );
+        assert_eq!(
+            accelerated.counts.scalar, 0,
+            "a qualified grouped geometry fell back to the scalar kernel"
+        );
+        assert_eq!(
+            accelerated.counts.scratch_allocations, 1,
+            "two-pass scratch was not allocated exactly once"
+        );
+        assert_eq!(accelerated.optional_kernel_loads, 2);
+        assert_eq!(accelerated.pair_reason, Some("ready"));
+        assert_same_attention_gradients("gqa-production-route", &scalar, &accelerated);
+
+        // The same grouping at an unmeasured head dimension and sequence shape:
+        // divisible, still refused, and nothing optional is built or allocated --
+        // not even with the pair deliberately broken and the default on.
+        let unmeasured = run_attention_backward_step(
+            &device,
+            Some(None),
+            Some(ShaderFault::Both),
+            8,
+            2,
+            8,
+            2,
+            8,
+        )?;
+        assert_eq!(unmeasured.counts.query, 0);
+        assert_eq!(unmeasured.counts.key, 0);
+        assert_eq!(unmeasured.counts.scratch_allocations, 0);
+        assert!(unmeasured.counts.scalar > 0);
+        assert_eq!(
+            unmeasured.optional_kernel_loads, 0,
+            "an unqualified grouped geometry built an optional kernel"
+        );
+        assert_eq!(unmeasured.pair_reason, None);
+
+        eprintln!(
+            "gqa production-route qualification: status=PASS \
+             default_query={} default_key={} default_scalar={} scratch_allocations={} \
+             unmeasured_loads={}",
+            accelerated.counts.query,
+            accelerated.counts.key,
+            accelerated.counts.scalar,
+            accelerated.counts.scratch_allocations,
+            unmeasured.optional_kernel_loads,
+        );
+        Ok(())
+    }
