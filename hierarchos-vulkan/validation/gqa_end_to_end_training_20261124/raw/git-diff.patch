+    /// Focused kernel timing for the shipped two-pass pair.
+    ///
+    /// Only meaningful after parity, so it is a separate opt-in run that reports
+    /// GPU time from the shipped timestamp profiler rather than wall time. It
+    /// covers the qualified MHA geometry as well as the grouped ones, because the
+    /// key pass is a single artifact for both and a generic shader is only worth
+    /// its generality if it does not cost MHA anything:
+    ///
+    /// ```text
+    /// HIERARCHOS_ATTENTION_BACKWARD_KERNEL_TIMING=1 \
+    ///   HIERARCHOS_VULKAN_PROFILE_KERNELS=1 \
+    ///   cargo test --lib two_pass_attention_kernel_timing -- --nocapture
+    /// ```
+    ///
+    /// Each arm is one submission of `iterations` identical dispatches, and the
+    /// profiler block printed immediately after each `[two-pass-bench]` marker is that
+    /// submission's own GPU total, so the per-dispatch time is the total divided
+    /// by the dispatch count. Every conditional keeps the arms identical and the
+    /// kernels unchanged from the numerical run.
+    #[test]
+    fn two_pass_attention_kernel_timing() -> Result<()> {
+        let requested = std::env::var("HIERARCHOS_ATTENTION_BACKWARD_KERNEL_TIMING")
+            .map(|value| value.trim() == "1")
+            .unwrap_or(false);
+        if !requested {
+            eprintln!(
+                "two-pass kernel timing: status=SKIP reason=not_requested \
+                 (set HIERARCHOS_ATTENTION_BACKWARD_KERNEL_TIMING=1)"
+            );
+            return Ok(());
+        }
+        // The timestamp profile is a cross-check, not a precondition: without it
+        // the run still reports host-observed submission latency and says so.
+        let profiled = std::env::var_os("HIERARCHOS_VULKAN_PROFILE_KERNELS").is_some();
+        eprintln!(
+            "two-pass kernel timing: status=RUN timestamp_profile={profiled} \
+             (set HIERARCHOS_VULKAN_PROFILE_KERNELS=1 for the GPU-time cross-check)"
+        );
+        let device = VulkanDevice::new()?;
+        let query_kernel = vulkan::ComputeKernel::new(
+            &device,
+            TwoPassAttentionPass::Query.spirv(),
+            TwoPassAttentionPass::Query.binding_count(),
+            std::mem::size_of::<AttentionPush>() as u32,
+        )?;
+        // The shipped key pass: the same artifact production dispatch loads, so a
+        // number here is a statement about the production shader.
+        let key_kernel = vulkan::ComputeKernel::new(
+            &device,
+            TwoPassAttentionPass::Key.spirv(),
+            TwoPassAttentionPass::Key.binding_count(),
+            std::mem::size_of::<AttentionPush>() as u32,
+        )?;
+        let kernels = TransformerKernels::new(&device)?;
+
+        let seq = 64u32;
+        let batch = 2u32;
+        let head_dim = 128u32;
+        let iterations = std::env::var("HIERARCHOS_ATTENTION_BACKWARD_KERNEL_TIMING_ITERATIONS")
+            .ok()
+            .and_then(|value| value.trim().parse::<u32>().ok())
+            .unwrap_or(30);
+        let warmup = 5u32;
+        // `8q-8kv` is the qualified MHA geometry, measured with the same protocol
+        // as the grouped ones so the before/after comparison of the key pass is
+        // apples to apples.
+        for (label, heads, kv_heads) in [
+            ("8q-8kv", 8u32, 8u32),
+            ("8q-2kv", 8u32, 2u32),
+            ("4q-2kv", 4u32, 2u32),
+        ] {
+            let query_hidden = heads * head_dim;
+            let kv_hidden = kv_heads * head_dim;
+            let q_count = (batch * seq * query_hidden) as usize;
+            let kv_count = (batch * seq * kv_hidden) as usize;
+            let mask_count = (batch * seq) as usize;
+            let push = AttentionPush {
+                batch_size: batch,
+                query_seq_len: seq,
+                key_value_seq_len: seq,
+                query_hidden_size: query_hidden,
+                value_hidden_size: kv_hidden,
+                num_heads: heads,
+                num_key_value_heads: kv_heads,
+                window_size: 0,
+                scale: 1.0 / (head_dim as f32).sqrt(),
+                value_scale: 1.0,
+                softcap: 0.0,
+                alibi_mode: 0,
+                alibi_bias_max: 0.0,
+                dropout_p: 0.0,
+                rng_step: 0,
+                rng_site: 0,
+                rng_seed: 0,
+                has_sink: 0,
+                causal: 1,
+                relative_bias_mode: 0,
+                relative_bias_num_buckets: 0,
+                relative_bias_max_distance: 0,
+                query_position_offset: 0,
+                has_sparse_mask: 0,
+                compressed_key_count: 0,
+                compressed_key_rate: 0,
+                paged_kv: 0,
+                kv_page_size: 1,
+                kv_page_table_stride: 1,
+                unfused_qk: 0,
+            };
+            let query = GpuBuffer::from_f32(&device, &comparison_values(11, q_count))?;
+            let key = GpuBuffer::from_f32(&device, &comparison_values(12, kv_count))?;
+            let value = GpuBuffer::from_f32(&device, &comparison_values(13, kv_count))?;
+            let grad_output = GpuBuffer::from_f32(&device, &comparison_values(14, q_count))?;
+            let query_mask = GpuBuffer::from_f32(&device, &vec![1.0_f32; mask_count])?;
+            let key_mask = GpuBuffer::from_f32(&device, &vec![1.0_f32; mask_count])?;
+            let dummy = GpuBuffer::from_f32(&device, &[0.0_f32])?;
+            let grad_q = GpuBuffer::from_f32(&device, &vec![0.0_f32; q_count])?;
+            let grad_k = GpuBuffer::from_f32(&device, &vec![0.0_f32; kv_count])?;
+            let grad_v = GpuBuffer::from_f32(&device, &vec![0.0_f32; kv_count])?;
+            let scratch_capacity = two_pass_attention_scratch_elements(&push)
+                .context("grouped-query scratch size overflow")?;
+            let probability =
+                GpuBuffer::from_f32(&device, &vec![0.0_f32; scratch_capacity])?;
+            let ds = GpuBuffer::from_f32(&device, &vec![0.0_f32; scratch_capacity])?;
+
+            let query_grid = [((batch * heads * seq) + 63) / 64, 1, 1];
+            let key_grid = [((batch * kv_heads * seq) + 63) / 64, 1, 1];
+            let scalar_grid = [kv_heads, batch, 1];
+            let query_buffers: [&GpuBuffer; 9] = [
+                &query,
+                &key,
+                &value,
+                &query_mask,
+                &key_mask,
+                &grad_output,
+                &grad_q,
+                &probability,
+                &ds,
+            ];
+            let key_buffers: [&GpuBuffer; 8] = [
+                &query,
+                &grad_output,
+                &probability,
+                &ds,
+                &grad_k,
+                &grad_v,
+                &key_mask,
+                &query_mask,
+            ];
+            let scalar_buffers: [&GpuBuffer; 15] = [
+                &query,
+                &key,
+                &value,
+                &query_mask,
+                &key_mask,
+                &dummy,
+                &grad_output,
+                &grad_q,
+                &grad_k,
+                &grad_v,
+                &dummy,
+                &dummy,
+                &dummy,
+                &dummy,
+                &dummy,
+            ];
+            let backward_push = push.as_backward_push(0, 1);
+
+            // One dispatch per submission, so a submission's GPU total is one
+            // kernel's time and the profiler block that follows names it. The
+            // headline number is the median host-observed submission latency;
+            // the timestamp profiler's per-block gpu_ms is the cross-check.
+            let submit = |arm: &str, marker: &str| -> Result<()> {
+                eprintln!("[two-pass-bench{marker}] geometry={label} arm={arm}");
+                let mut commands = vulkan::ComputeBatch::new(&device)?;
+                match arm {
+                    "scalar" => kernels.attention_backward.record_dispatch(
+                        &mut commands,
+                        &scalar_buffers,
+                        bytemuck::bytes_of(&backward_push),
+                        scalar_grid,
+                    )?,
+                    "query" => query_kernel.record_dispatch(
+                        &mut commands,
+                        &query_buffers,
+                        bytemuck::bytes_of(&push),
+                        query_grid,
+                    )?,
+                    "key" => key_kernel.record_dispatch(
+                        &mut commands,
+                        &key_buffers,
+                        bytemuck::bytes_of(&push),
+                        key_grid,
+                    )?,
+                    _ => {
+                        query_kernel.record_dispatch(
+                            &mut commands,
+                            &query_buffers,
+                            bytemuck::bytes_of(&push),
+                            query_grid,
+                        )?;
+                        key_kernel.record_dispatch(
+                            &mut commands,
+                            &key_buffers,
+                            bytemuck::bytes_of(&push),
+                            key_grid,
+                        )?;
+                    }
+                }
+                commands.submit()?;
+                Ok(())
+            };
+            for arm in ["scalar", "query", "key", "combined"] {
+                for _ in 0..warmup {
+                    submit(arm, "-warmup")?;
+                }
+                let mut samples = Vec::with_capacity(iterations as usize);
+                for _ in 0..iterations {
+                    let start = std::time::Instant::now();
+                    submit(arm, "-sample")?;
+                    samples.push(start.elapsed().as_secs_f64() * 1e3);
+                }
+                samples.sort_by(|left, right| left.partial_cmp(right).unwrap());
+                let median = samples[samples.len() / 2];
+                let p25 = samples[samples.len() / 4];
+                eprintln!(
+                    "[two-pass-bench-result] geometry={label} arm={arm} iterations={iterations} \
+                     median_ms={median:.6} p25_ms={p25:.6} min_ms={:.6} max_ms={:.6}",
+                    samples[0],
+                    samples[samples.len() - 1]
+                );
+            }
+        }
+        Ok(())
+    }
+
+    /// The comparator that decides a gradient PASS must reject a one-ULP change;
+    /// otherwise the qualification would be vacuous.
+    #[test]
+    fn gradient_report_rejects_a_one_ulp_difference() {
+        let expected = vec![1.0_f32, -2.5, 0.75, 0.0];
+        let mut actual = expected.clone();
+        let (equal, _, _, max_ulp) = gradient_report("identical", &expected, &actual);
+        assert!(equal);
+        assert_eq!(max_ulp, 0);
+        actual[1] = f32::from_bits(actual[1].to_bits() ^ 1);
+        let (equal, report, _, max_ulp) = gradient_report("one-ulp", &expected, &actual);
+        assert!(!equal, "a one-ULP change must not pass: {report}");
+        assert!(max_ulp >= 1, "the report must carry the ULP distance");
+        assert!(report.contains("first_divergence=index 1"), "{report}");
+    }
+
+    fn eligibility_push(
+        batch: u32,
+        heads: u32,
+        kv_heads: u32,
+        seq: u32,
+        head_dim: u32,
+        mode: u32,
+    ) -> AttentionPush {
+        AttentionPush {
+            batch_size: batch,
+            query_seq_len: seq,
+            key_value_seq_len: seq,
+            query_hidden_size: heads * head_dim,
+            value_hidden_size: kv_heads * head_dim,
+            num_heads: heads,
+            num_key_value_heads: kv_heads,
+            window_size: 0,
+            scale: 1.0 / (head_dim as f32).sqrt(),
+            value_scale: 1.0,
+            softcap: 0.0,
+            alibi_mode: 0,
+            alibi_bias_max: 0.0,
+            dropout_p: 0.0,
+            rng_step: 0,
+            rng_site: 0,
+            rng_seed: 0,
+            has_sink: 0,
+            causal: 1,
+            relative_bias_mode: 0,
+            relative_bias_num_buckets: 0,
+            relative_bias_max_distance: 0,
+            query_position_offset: 0,
+            has_sparse_mask: 0,
+            compressed_key_count: 0,
+            compressed_key_rate: 0,
+            paged_kv: 0,
+            kv_page_size: 1,
+            kv_page_table_stride: 1,
+            unfused_qk: mode,
+        }
+    }
