+    /// Optional-kernel failures split into "this module cannot run here" and
+    /// "this device is broken". Only the first may degrade to scalar.
+    #[test]
+    fn optional_kernel_failures_are_classified_as_capability_or_device() {
+        use OptionalKernelOutcome::{Fatal, Incompatible};
+
+        // A module this driver will not build is the optional pair's problem.
+        for stage in [
+            "decoding embedded SPIR-V: invalid SPIR-V magic number",
+            "creating Vulkan shader module: ERROR_UNKNOWN",
+            "creating Vulkan compute pipeline: ERROR_UNKNOWN",
+        ] {
+            assert_eq!(
+                classify_optional_kernel_error(false, stage),
+                Incompatible,
+                "{stage}"
+            );
+        }
+
+        // A device that is gone cannot be rescued by falling back.
+        assert_eq!(
+            classify_optional_kernel_error(false, "creating Vulkan compute pipeline: ERROR_DEVICE_LOST"),
+            Fatal {
+                reason: "device_lost"
+            }
+        );
+        // The device's own sticky flag outranks an otherwise capability-shaped
+        // message: a lost device is lost whatever the last call said.
+        assert_eq!(
+            classify_optional_kernel_error(true, "creating Vulkan shader module: ERROR_UNKNOWN"),
+            Fatal {
+                reason: "device_lost"
+            }
+        );
+
+        // Allocation failure is a resource failure, not a capability one.
+        for out_of_memory in [
+            "creating Vulkan shader module: ERROR_OUT_OF_DEVICE_MEMORY",
+            "creating Vulkan compute pipeline: ERROR_OUT_OF_HOST_MEMORY",
+        ] {
+            assert_eq!(
+                classify_optional_kernel_error(false, out_of_memory),
+                Fatal {
+                    reason: "out_of_memory"
+                },
+                "{out_of_memory}"
+            );
+        }
+
+        // A poisoned device-wide lock means another thread panicked inside it.
+        assert_eq!(
+            classify_optional_kernel_error(false, "Vulkan layout interner lock was poisoned"),
+            Fatal {
+                reason: "invalid_device_state"
+            }
+        );
+
+        // An unrecognised failure must never be converted into a scalar success.
+        assert_eq!(
+            classify_optional_kernel_error(false, "creating Vulkan buffer: ERROR_UNKNOWN"),
+            Fatal {
+                reason: "unclassified"
+            }
+        );
+    }
+
+    /// One real forward+backward through a one-layer Llama-shaped graph.
+    ///
+    /// Every claim the fallback has to prove is read from this: the gradient
+    /// tensors, the dispatch the layer actually recorded on this thread, how
+    /// many optional kernels the loader built, and what the pair resolved to.
+    #[derive(Debug)]
+    struct AttentionBackwardStep {
+        grad_q: Vec<f32>,
+        grad_k: Vec<f32>,
+        grad_v: Vec<f32>,
+        counts: AttentionBackwardDispatchCounts,
+        optional_kernel_loads: u32,
+        pair_reason: Option<&'static str>,
+    }
+
+    fn two_pass_test_weights(len: usize, salt: usize) -> Vec<f32> {
+        (0..len)
+            .map(|index| (((index * 53 + salt * 29) % 197) as f32 - 98.0) / 113.0)
+            .collect()
+    }
+
+    fn two_pass_test_layer(
+        device: &VulkanDevice,
+        heads: u32,
+        kv_heads: u32,
+        head_dim: u32,
+        batch: u32,
+        seq: u32,
+    ) -> Result<(VulkanTransformerLayer, VulkanTransformerConfig)> {
+        let hidden = (heads * head_dim) as usize;
+        let config = VulkanTransformerConfig::from_hf_value(&serde_json::json!({
+            "model_type": "llama",
+            "vocab_size": 32,
+            "hidden_size": hidden,
+            "num_hidden_layers": 1,
+            "num_attention_heads": heads,
+            "num_key_value_heads": kv_heads,
+            "head_dim": head_dim,
+            "intermediate_size": hidden,
+            "hidden_act": "silu",
+            "rms_norm_eps": 1.0e-6,
+            "max_position_embeddings": 256,
+        }))?;
+        let d = config.hidden_size;
+        let i = config.intermediate_size;
+        let query_width = (heads * head_dim) as usize;
+        let kv_width = (kv_heads * head_dim) as usize;
+        let linear = |output: usize, input: usize, salt: usize| HostLinear {
+            weight: two_pass_test_weights(output * input, salt),
+            bias: None,
+        };
+        let host = HostTransformerLayer {
+            post_attention_norm: None,
+            post_mlp_norm: None,
+            ln1: HostLayerNorm {
+                weight: vec![1.0; d],
+                bias: Vec::new(),
+            },
+            c_attn: None,
+            q_proj: Some(linear(query_width, d, 1)),
+            k_proj: Some(linear(kv_width, d, 2)),
+            v_proj: Some(linear(kv_width, d, 3)),
+            q_norm: None,
+            k_norm: None,
+            c_proj: linear(d, query_width, 4),
+            ln2: HostLayerNorm {
+                weight: vec![1.0; d],
+                bias: Vec::new(),
+            },
+            c_fc: linear(i, d, 5),
+            c_gate: Some(linear(i, d, 7)),
+            c_mlp_proj: linear(d, i, 6),
+            xielu: None,
+        };
+        let rotary = TransformerRotaryLayerSpec {
+            enabled: true,
+            rotary_dim: config.rotary_dim,
+            rotary_emb_base: config.rotary_emb_base,
+            rope_scaling: config.rope_scaling.clone(),
+        };
+        let layer = VulkanTransformerLayer::new(
+            device,
+            &config,
+            (batch * seq) as usize,
+            seq as usize,
+            0,
+            rotary,
+            config.attention_windows[0],
+            None,
+            None,
+            None,
+            None,
+            None,
+            None,
+            None,
+            None,
+            None,
+            None,
+            None,
+            None,
+            false,
+            host,
+        )?;
+        Ok((layer, config))
+    }
+
+    fn run_attention_backward_step(
+        device: &VulkanDevice,
+        setting: Option<Option<bool>>,
+        fault: Option<two_pass_attention_test_hooks::ShaderFault>,
+        heads: u32,
+        kv_heads: u32,
+        head_dim: u32,
+        batch: u32,
+        seq: u32,
+    ) -> Result<AttentionBackwardStep> {
+        run_attention_backward_steps(
+            device, setting, fault, heads, kv_heads, head_dim, batch, seq, 1,
+        )
+    }
+
+    /// As [`run_attention_backward_step`], recording `steps` backward calls
+    /// against one kernel set and one layer. Used to prove the failed optional
+    /// load is cached rather than retried on every training step.
+    #[allow(clippy::too_many_arguments)]
+    fn run_attention_backward_steps(
+        device: &VulkanDevice,
+        setting: Option<Option<bool>>,
+        fault: Option<two_pass_attention_test_hooks::ShaderFault>,
+        heads: u32,
+        kv_heads: u32,
+        head_dim: u32,
+        batch: u32,
+        seq: u32,
+        steps: u32,
+    ) -> Result<AttentionBackwardStep> {
+        let _scope = two_pass_attention_test_hooks::scope(setting, fault);
+        two_pass_attention_test_hooks::reset_thread_counts();
+        let kernels = TransformerKernels::new(device)?;
+        let (layer, config) = two_pass_test_layer(device, heads, kv_heads, head_dim, batch, seq)?;
+        let rows = (batch * seq) as usize;
+        let d = config.hidden_size;
+        let input = GpuBuffer::from_f32(device, &two_pass_test_weights(rows * d, 11))?;
+        let mask = GpuBuffer::from_f32(device, &vec![1.0_f32; rows])?;
+        let alibi = GpuBuffer::from_f32(device, &[0.0_f32])?;
+        let mut commands = vulkan::ComputeBatch::new(device)?;
+        layer.record_forward(
+            &mut commands,
+            &kernels,
+            &config,
+            &input,
+            None,
+            &mask,
+            &alibi,
+            batch as usize,
+            seq as usize,
+            0,
+            0,
+        )?;
+        commands.submit()?;
+        let grad_output = GpuBuffer::from_f32(device, &two_pass_test_weights(rows * d, 19))?;
+        for _ in 0..steps {
+            let mut commands = vulkan::ComputeBatch::new(device)?;
+            layer.record_backward(
+                &mut commands,
+                &kernels,
+                &config,
+                &input,
+                &mask,
+                &alibi,
+                &grad_output,
+                batch as usize,
+                seq as usize,
+                0,
+                0,
+            )?;
+            commands.submit()?;
+        }
+        let query_width = (heads * head_dim) as usize;
+        let kv_width = (kv_heads * head_dim) as usize;
+        Ok(AttentionBackwardStep {
+            grad_q: layer.tape.grad_q.read_f32(rows * query_width)?,
+            grad_k: layer.tape.grad_k.read_f32(rows * kv_width)?,
+            grad_v: layer.tape.grad_v.read_f32(rows * kv_width)?,
+            counts: two_pass_attention_test_hooks::thread_counts(),
+            optional_kernel_loads: two_pass_attention_test_hooks::optional_kernel_loads(),
+            pair_reason: kernels
+                .rdna3_two_pass_attention_backward
+                .get()
+                .map(|pair| pair.reason),
+        })
+    }
+
+    fn assert_same_attention_gradients(
+        label: &str,
+        expected: &AttentionBackwardStep,
+        actual: &AttentionBackwardStep,
+    ) {
+        for (name, expected_values, actual_values) in [
+            ("dQ", &expected.grad_q, &actual.grad_q),
+            ("dK", &expected.grad_k, &actual.grad_k),
+            ("dV", &expected.grad_v, &actual.grad_v),
+        ] {
+            let (equal, report, _, _) = gradient_report(name, expected_values, actual_values);
+            assert!(equal, "[{label}] {report}");
+        }
+    }
+
+    /// Scalar execution must survive every optional-shader failure, and the
+    /// eligible accelerated path must keep its Phase III result.
+    ///
+    /// The failure is forced through the real loader: the test seam hands
+    /// `ComputeKernel::new` a SPIR-V blob the driver cannot decode, so the whole
+    /// production path runs from module creation to fallback selection.
+    #[test]
+    fn optional_two_pass_load_failure_keeps_scalar_execution_and_gradients() -> Result<()> {
+        use two_pass_attention_test_hooks::ShaderFault;
+        let Ok(device) = VulkanDevice::new() else {
+            eprintln!(
+                "two-pass fallback qualification: status=BLOCKED reason=no_vulkan_device"
+            );
+            return Ok(());
+        };
+        // Batch 1, one head, head_dim 8, sequence 8: the smallest geometry the
+        // gate admits, so the fallback runs the branch it would run in training.
+        let (heads, kv_heads, head_dim, batch, seq) = (1, 1, 8, 1, 8);
+
+        // The normal scalar baseline: `=0`, so no optional kernel is built.
+        let baseline = run_attention_backward_step(
+            &device,
+            Some(Some(false)),
+            None,
+            heads,
+            kv_heads,
+            head_dim,
+            batch,
+            seq,
+        )?;
+        assert_eq!(baseline.counts.query, 0, "=0 dispatched the query pass");
+        assert_eq!(baseline.counts.key, 0, "=0 dispatched the key pass");
+        assert_eq!(
+            baseline.counts.scratch_allocations, 0,
+            "=0 allocated two-pass scratch"
+        );
+        assert_eq!(
+            baseline.optional_kernel_loads, 0,
+            "=0 built an optional kernel"
+        );
+        assert!(
+            baseline.counts.scalar > 0,
+            "=0 did not dispatch the scalar kernel"
+        );
+        assert_eq!(baseline.pair_reason, None, "=0 resolved the optional pair");
+
+        // 1. Both passes build: the eligible default uses both and stays
+        // bit-identical to the scalar baseline.
+        let accelerated = run_attention_backward_step(
+            &device,
+            Some(None),
+            None,
+            heads,
+            kv_heads,
+            head_dim,
+            batch,
+            seq,
+        )?;
+        assert_eq!(
+            accelerated.counts.query, 1,
+            "the query pass did not dispatch exactly once"
+        );
+        assert_eq!(
+            accelerated.counts.key, 1,
+            "the key pass did not dispatch exactly once"
+        );
+        assert_eq!(
+            accelerated.counts.scalar, 0,
+            "the eligible default still dispatched the scalar kernel"
+        );
+        assert_eq!(accelerated.counts.scratch_allocations, 1);
+        assert_eq!(accelerated.optional_kernel_loads, 2);
+        assert_eq!(accelerated.pair_reason, Some("ready"));
+        assert_same_attention_gradients("accelerated-vs-scalar", &baseline, &accelerated);
+
+        // 2-4. Each optional member failing, and both failing, must leave the
+        // scalar route: it dispatches, allocates nothing, and produces the same
+        // gradients as the `=0` baseline.
+        for (label, fault, reason) in [
+            (
+                "query-unavailable",
+                ShaderFault::Query,
+                "query_shader_unavailable",
+            ),
+            (
+                "key-unavailable",
+                ShaderFault::Key,
+                "key_shader_unavailable",
+            ),
+            (
+                "both-unavailable",
+                ShaderFault::Both,
+                "both_shaders_unavailable",
+            ),
+        ] {
+            let fallback = run_attention_backward_step(
+                &device,
+                Some(None),
+                Some(fault),
+                heads,
+                kv_heads,
+                head_dim,
+                batch,
+                seq,
+            )?;
+            assert_eq!(
+                fallback.pair_reason,
+                Some(reason),
+                "[{label}] the pair did not record the failure"
+            );
+            assert_eq!(
+                fallback.counts.query, 0,
+                "[{label}] the query pass dispatched"
+            );
+            assert_eq!(fallback.counts.key, 0, "[{label}] the key pass dispatched");
+            assert_eq!(
+                fallback.counts.scratch_allocations, 0,
+                "[{label}] two-pass scratch was allocated"
+            );
+            assert!(
+                fallback.counts.scalar > 0,
+                "[{label}] the scalar kernel did not dispatch"
+            );
+            assert_eq!(
+                fallback.optional_kernel_loads, 2,
+                "[{label}] the loader did not attempt both members"
+            );
+            assert_same_attention_gradients(label, &baseline, &fallback);
+        }
+
+        // 8. Explicit `=1` is a hardware qualification: an unavailable pair is a
+        // visible failure, never a silent scalar run.
+        let qualified = run_attention_backward_step(
+            &device,
+            Some(Some(true)),
+            None,
+            heads,
+            kv_heads,
+            head_dim,
+            batch,
+            seq,
+        )?;
+        assert_eq!(qualified.counts.query, 1);
+        assert_eq!(qualified.counts.key, 1);
+        assert_eq!(qualified.pair_reason, Some("ready"));
+
+        let blocked = run_attention_backward_step(
+            &device,
+            Some(Some(true)),
+            Some(ShaderFault::Query),
+            heads,
+            kv_heads,
+            head_dim,
+            batch,
+            seq,
+        )
+        .expect_err("=1 must not fall back silently");
+        let message = format!("{blocked:#}");
+        assert!(
+            message.contains("BLOCKED"),
+            "the qualification failure does not name itself: {message}"
+        );
+        assert!(
+            message.contains("query_shader_unavailable"),
+            "the qualification failure does not carry the reason: {message}"
+        );
+
+        // 5. A grouped-query geometry is ineligible, so it never even builds the
+        // optional pair -- not even with the pair broken and the default on.
+        let grouped_baseline =
+            run_attention_backward_step(&device, Some(Some(false)), None, 4, 2, 8, 2, 8)?;
+        let grouped = run_attention_backward_step(
+            &device,
+            Some(None),
+            Some(ShaderFault::Both),
+            4,
+            2,
+            8,
+            2,
+            8,
+        )?;
+        assert_eq!(
+            grouped.pair_reason, None,
+            "the GQA geometry resolved the optional pair"
+        );
+        assert_eq!(
+            grouped.optional_kernel_loads, 0,
+            "the GQA geometry built an optional kernel"
+        );
+        assert_eq!(grouped.counts.query, 0);
+        assert_eq!(grouped.counts.key, 0);
+        assert_eq!(grouped.counts.scratch_allocations, 0);
+        assert!(grouped.counts.scalar > 0);
+        assert_same_attention_gradients("gqa-vs-scalar", &grouped_baseline, &grouped);
+
+        // 6. A key sequence above the admitted head dimension is ineligible too.
+        let long_baseline =
+            run_attention_backward_step(&device, Some(Some(false)), None, 1, 1, 8, 1, 64)?;
+        let long = run_attention_backward_step(
+            &device,
+            Some(None),
+            Some(ShaderFault::Both),
+            1,
+            1,
+            8,
+            1,
+            64,
+        )?;
+        assert_eq!(
+            long.pair_reason, None,
+            "the long-context geometry resolved the optional pair"
+        );
+        assert_eq!(
+            long.optional_kernel_loads, 0,
+            "the long-context geometry built an optional kernel"
+        );
+        assert_eq!(long.counts.query, 0);
+        assert_eq!(long.counts.key, 0);
+        assert_eq!(long.counts.scratch_allocations, 0);
+        assert!(long.counts.scalar > 0);
+        assert_same_attention_gradients("long-context-vs-scalar", &long_baseline, &long);
+
+        eprintln!(
+            "two-pass fallback qualification: status=PASS cases=8 \
+             default_query={} default_key={} default_scalar={} fallback_scalar={} \
+             explicit_zero_loads={} gqa_loads={} long_context_loads={} scratch_fallbacks=0",
+            accelerated.counts.query,
+            accelerated.counts.key,
+            accelerated.counts.scalar,
+            baseline.counts.scalar,
+            baseline.optional_kernel_loads,
+            grouped.optional_kernel_loads,
+            long.optional_kernel_loads,
+        );
+        Ok(())
+    }
+
+    /// A failed optional load is resolved once and cached with the kernel set.
+    ///
+    /// Retrying it every step would turn a one-off incompatibility into a
+    /// permanent per-step cost and a permanently noisy log.
+    #[test]
+    fn optional_kernel_failure_is_cached_across_training_steps() -> Result<()> {
+        use two_pass_attention_test_hooks::ShaderFault;
+        let Ok(device) = VulkanDevice::new() else {
+            return Ok(());
+        };
+        let step = run_attention_backward_steps(
+            &device,
+            Some(None),
+            Some(ShaderFault::Both),
+            1,
+            1,
+            8,
+            1,
+            8,
+            3,
+        )?;
+        assert_eq!(
+            step.optional_kernel_loads, 2,
+            "three steps retried the optional load: {} attempts",
+            step.optional_kernel_loads
+        );
+        assert_eq!(
+            step.counts.scalar, 3,
+            "three steps recorded {} scalar dispatches",
+            step.counts.scalar
+        );
+        assert_eq!(step.counts.query, 0);
+        assert_eq!(step.counts.key, 0);
+        assert_eq!(step.counts.scratch_allocations, 0);
+        assert_eq!(step.pair_reason, Some("both_shaders_unavailable"));
+        Ok(())
+    }
+
