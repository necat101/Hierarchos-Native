+    /// The gate decides every route without a device, so the ineligible cases
+    /// cannot be "covered" by a branch that happens never to run.
+    #[test]
+    fn two_pass_gate_keeps_every_ineligible_geometry_on_scalar() {
+        use AttentionBackwardRoute::{Scalar, TwoPass};
+        let eligible = eligibility_push(8, 8, 8, 64, 128, 9);
+        assert_eq!(two_pass_attention_gate(&eligible, 1, true), TwoPass);
+
+        // An explicit `=0` wins over an otherwise eligible geometry.
+        assert_eq!(
+            two_pass_attention_gate(&eligible, 1, false),
+            Scalar {
+                reason: "disabled_by_environment"
+            }
+        );
+
+        // A split submission never dispatches the pair.
+        assert_eq!(
+            two_pass_attention_gate(&eligible, 2, true),
+            Scalar {
+                reason: "key_range_split"
+            }
+        );
+
+        // A qualified grouped geometry selects the pair; every other grouped
+        // geometry keeps the scalar kernel with an actionable reason.
+        let grouped = eligibility_push(2, 8, 2, 64, 128, 9);
+        assert_eq!(two_pass_attention_gate(&grouped, 1, true), TwoPass);
+        assert_eq!(
+            two_pass_attention_gate(&eligibility_push(2, 32, 2, 64, 128, 9), 1, true),
+            Scalar {
+                reason: "grouped_query_attention_unqualified_grouping"
+            }
+        );
+        assert_eq!(
+            two_pass_attention_gate(&eligibility_push(2, 8, 2, 32, 128, 9), 1, true),
+            Scalar {
+                reason: "grouped_query_attention_unqualified_sequence"
+            }
+        );
+
+        // A key sequence longer than the admitted head dimension.
+        let long = eligibility_push(1, 8, 8, 256, 128, 9);
+        assert_eq!(
+            two_pass_attention_gate(&long, 1, true),
+            Scalar {
+                reason: "kv_sequence_above_head_dim"
+            }
+        );
+
+        // Any other adjoint ordering keeps the qualified scalar kernel.
+        let mode1 = eligibility_push(8, 8, 8, 64, 128, 1);
+        assert_eq!(
+            two_pass_attention_gate(&mode1, 1, true),
+            Scalar {
+                reason: "unsupported_arithmetic_mode"
+            }
+        );
+    }
