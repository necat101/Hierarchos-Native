+    /// The scratch contract is derived from the shaders' slot indexing, and every
+    /// geometry the gate rejects is rejected before any allocation.
+    #[test]
+    fn two_pass_scratch_sizing_and_eligibility_are_geometry_exact() {
+        let eligible = eligibility_push(8, 8, 8, 64, 128, 9);
+        assert_eq!(two_pass_attention_rejection(&eligible), None);
+        assert_eq!(
+            two_pass_attention_scratch_elements(&eligible),
+            Some(8 * 8 * 64 * 64)
+        );
+        assert_eq!(two_pass_attention_scratch_elements(&eligible), Some(262_144));
+
+        let mode0 = eligibility_push(2, 4, 4, 16, 64, 0);
+        assert_eq!(two_pass_attention_rejection(&mode0), None);
+        assert_eq!(
+            two_pass_attention_scratch_elements(&mode0),
+            Some(2 * 4 * 16 * 16)
+        );
+
+        // A qualified grouped geometry sizes its scratch from the same formula:
+        // grouping changes which K/V row a query head contributes to, never which
+        // scratch slot it owns, so the slot base stays the query head.
+        let grouped = eligibility_push(2, 8, 2, 64, 128, 9);
+        assert_eq!(two_pass_attention_rejection(&grouped), None);
+        assert_eq!(
+            two_pass_attention_scratch_elements(&grouped),
+            Some(2 * 8 * 64 * 64)
+        );
+
+        // A divisible but unmeasured grouping never reaches the allocator.
+        let unmeasured = eligibility_push(8, 32, 2, 64, 128, 9);
+        assert_eq!(
+            two_pass_attention_rejection(&unmeasured),
+            Some("grouped_query_attention_unqualified_grouping")
+        );
+
+        // A qualified grouping at an unmeasured head dimension or sequence shape
+        // is rejected too: the allowlist is a conjunction, not a grouping-only
+        // check.
+        let narrow = eligibility_push(8, 8, 2, 64, 64, 9);
+        assert_eq!(
+            two_pass_attention_rejection(&narrow),
+            Some("grouped_query_attention_unqualified_head_dim")
+        );
+        let short = eligibility_push(8, 8, 2, 32, 128, 9);
+        assert_eq!(
+            two_pass_attention_rejection(&short),
+            Some("grouped_query_attention_unqualified_sequence")
+        );
+        let full = AttentionPush {
+            causal: 0,
+            ..eligibility_push(2, 8, 2, 64, 128, 9)
+        };
+        assert_eq!(
+            two_pass_attention_rejection(&full),
+            Some("grouped_query_attention_unqualified_causal")
+        );
+
+        // A key sequence above the admitted head dimension is unsupported.
+        let long = eligibility_push(1, 8, 8, 256, 128, 9);
+        assert_eq!(
+            two_pass_attention_rejection(&long),
+            Some("kv_sequence_above_head_dim")
+        );
+
+        // Other adjoint arithmetic orders keep the scalar kernel.
+        let mode1 = eligibility_push(8, 8, 8, 64, 128, 1);
+        assert_eq!(
+            two_pass_attention_rejection(&mode1),
+            Some("unsupported_arithmetic_mode")
+        );
+
+        assert!(two_pass_attention_supported(&eligible));
+        assert!(two_pass_attention_supported(&grouped));
+        assert!(!two_pass_attention_supported(&unmeasured));
+    }
