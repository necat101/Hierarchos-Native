#version 450

// Range-addressed counterpart to adamw_controlled.comp. The GradScaler control
// buffer owns step/skip and, when requested, the reciprocal loss scale. This
// lets an AdamW wavefront be queued behind future replica-retirement values
// before the CPU knows whether the accumulation window overflowed.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer ParameterBuffer { float parameter[]; };
layout(set = 0, binding = 1, std430) buffer GradientBuffer { float gradient[]; };
layout(set = 0, binding = 2, std430) buffer ExpAvgBuffer { float exp_avg[]; };
layout(set = 0, binding = 3, std430) buffer ExpAvgSqBuffer { float exp_avg_sq[]; };
layout(set = 0, binding = 4, std430) readonly buffer ControlStateBuffer { uint control[]; };
layout(set = 0, binding = 5, std430) readonly buffer AdamStepBuffer { uint adam_step[]; };

layout(push_constant) uniform Push {
    uint offset;
    uint len;
    float lr;
    float beta1;
    float beta2;
    float eps;
    float weight_decay;
    float gradient_scale;
    uint is_active;
    uint apply_control_unscale;
} pc;

void main() {
    uint local_i = gl_GlobalInvocationID.x;
    if (local_i >= pc.len) {
        return;
    }
    uint i = pc.offset + local_i;
    if (control[3] == 0u) {
        gradient[i] = 0.0;
        return;
    }
    if (pc.is_active == 0u) {
        return;
    }

    float unscale = pc.apply_control_unscale != 0u ? uintBitsToFloat(control[5]) : 1.0;
    float g = gradient[i] * pc.gradient_scale * unscale;
    float m = pc.beta1 * exp_avg[i] + (1.0 - pc.beta1) * g;
    float v = pc.beta2 * exp_avg_sq[i] + (1.0 - pc.beta2) * g * g;
    exp_avg[i] = m;
    exp_avg_sq[i] = v;

    float step = float(adam_step[0]);
    float bias_correction1 = 1.0 - pow(pc.beta1, step);
    float bias_correction2 = 1.0 - pow(pc.beta2, step);
    float denom = sqrt(v / bias_correction2) + pc.eps;
    float decayed = parameter[i] * (1.0 - pc.lr * pc.weight_decay);
    parameter[i] = decayed - pc.lr * (m / bias_correction1) / denom;
}
