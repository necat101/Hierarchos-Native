#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer NormedBuffer { float normed[]; };
layout(set = 0, binding = 1, std430) readonly buffer RBuffer { float r[]; };
layout(set = 0, binding = 2, std430) readonly buffer KBuffer { float k[]; };
layout(set = 0, binding = 3, std430) readonly buffer VBuffer { float v[]; };
layout(set = 0, binding = 4, std430) readonly buffer GBuffer { float g[]; };
layout(set = 0, binding = 5, std430) readonly buffer RkBuffer { float r_k[]; };
layout(set = 0, binding = 6, std430) writeonly buffer OutputBuffer { float gated[]; };
layout(set = 0, binding = 7, std430) writeonly buffer BonusBuffer { float bonus_scalar[]; };

layout(push_constant) uniform Push {
    uint batch;
    uint width;
    uint head_size;
} pc;

void main() {
    uint group = gl_GlobalInvocationID.x;
    uint heads = pc.width / pc.head_size;
    uint group_count = pc.batch * heads;
    if (group >= group_count) {
        return;
    }
    uint batch_index = group / heads;
    uint head = group % heads;
    uint base = batch_index * pc.width + head * pc.head_size;
    uint channel_base = head * pc.head_size;
    float bonus = 0.0;
    for (uint i = 0; i < pc.head_size; ++i) {
        uint index = base + i;
        uint channel = channel_base + i;
        bonus += r[index] * k[index] * r_k[channel];
    }
    bonus_scalar[group] = bonus;
    for (uint i = 0; i < pc.head_size; ++i) {
        uint index = base + i;
        gated[index] = (normed[index] + bonus * v[index]) * g[index];
    }
}
