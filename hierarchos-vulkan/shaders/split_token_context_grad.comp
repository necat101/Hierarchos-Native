#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer GradConcatBuffer { float grad_concat[]; };
layout(set = 0, binding = 1, std430) writeonly buffer GradTokenBuffer { float grad_token[]; };
layout(set = 0, binding = 2, std430) writeonly buffer GradContextBuffer { float grad_context[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint dim;
} pc;

void main() {
    uint index = gl_GlobalInvocationID.x;
    uint len = pc.rows * pc.dim;
    if (index >= len) {
        return;
    }
    uint row = index / pc.dim;
    uint col = index - row * pc.dim;
    uint base = row * pc.dim * 2u;
    grad_token[index] = grad_concat[base + col];
    grad_context[index] = grad_concat[base + pc.dim + col];
}
