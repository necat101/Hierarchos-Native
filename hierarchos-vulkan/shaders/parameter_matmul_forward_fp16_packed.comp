#version 450

// FP16-storage / FP32-compute parameter matmul. The checkpoint/master weight
// stays FP32; this kernel consumes the optimizer-coherent packed mirror and
// accumulates with the same FP32 FMA topology as parameter_matmul_forward.comp.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer { float x[]; };
layout(set = 0, binding = 1, std430) readonly buffer WeightBuffer { uint weight_packed[]; };
layout(set = 0, binding = 2, std430) writeonly buffer OutputBuffer { float output_values[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint input_dim;
    uint output_dim;
} pc;

vec2 load_weight_pair(uint first_index, bool second_active) {
    vec2 current = unpackHalf2x16(weight_packed[first_index >> 1u]);
    if ((first_index & 1u) == 0u) {
        return second_active ? current : vec2(current.x, 0.0);
    }
    if (!second_active) {
        return vec2(current.y, 0.0);
    }
    vec2 next = unpackHalf2x16(weight_packed[(first_index >> 1u) + 1u]);
    return vec2(current.y, next.x);
}

void scalar_main() {
    uint out_col = gl_GlobalInvocationID.x * 2u;
    uint row = gl_GlobalInvocationID.y;
    if (row >= pc.rows || out_col >= pc.output_dim) {
        return;
    }

    bool second_active = out_col + 1u < pc.output_dim;
    vec2 sum = vec2(0.0);
    uint x_base = row * pc.input_dim;
    for (uint in_col = 0u; in_col < pc.input_dim; ++in_col) {
        float input_value = x[x_base + in_col];
        vec2 weights = load_weight_pair(
            in_col * pc.output_dim + out_col,
            second_active
        );
        sum.x = fma(input_value, weights.x, sum.x);
        if (second_active) {
            sum.y = fma(input_value, weights.y, sum.y);
        }
    }
    uint output_index = row * pc.output_dim + out_col;
    output_values[output_index] = sum.x;
    if (second_active) {
        output_values[output_index + 1u] = sum.y;
    }
}

// A 16-row/output-column tile reuses each input and weight across 16 dot
// products. Keep the scalar schedule for small/recurrent shapes, where barriers
// cost more than the saved reads. Both schedules retain the original increasing
// K FP32 FMA chain and the existing host dispatch geometry.
const uint INPUT_TILE = 32u;
shared float input_tile[16u * 33u];
shared vec2 weight_tile[INPUT_TILE * 17u];

void main() {
    if (pc.rows < 8u || pc.input_dim < 64u || pc.output_dim < 16u) {
        scalar_main();
        return;
    }

    uint local_x = gl_LocalInvocationID.x;
    uint local_y = gl_LocalInvocationID.y;
    uint out_col = (gl_WorkGroupID.x * 16u + local_x) * 2u;
    uint row = gl_WorkGroupID.y * 16u + local_y;
    bool lane_valid = row < pc.rows && out_col < pc.output_dim;
    vec2 sum = vec2(0.0);

    for (uint k_base = 0u; k_base < pc.input_dim; k_base += INPUT_TILE) {
        uint load_k = k_base + local_x * 2u;
        uint input_slot = local_y * 33u + local_x * 2u;
        input_tile[input_slot] =
            row < pc.rows && load_k < pc.input_dim
                ? x[row * pc.input_dim + load_k] : 0.0;
        input_tile[input_slot + 1u] =
            row < pc.rows && load_k + 1u < pc.input_dim
                ? x[row * pc.input_dim + load_k + 1u] : 0.0;

        uint weight_k = k_base + local_y * 2u;
        uint weight_slot = local_y * 2u * 17u + local_x;
        weight_tile[weight_slot] =
            out_col < pc.output_dim && weight_k < pc.input_dim
                ? load_weight_pair(weight_k * pc.output_dim + out_col, out_col + 1u < pc.output_dim)
                : vec2(0.0);
        weight_tile[weight_slot + 17u] =
            out_col < pc.output_dim && weight_k + 1u < pc.input_dim
                ? load_weight_pair((weight_k + 1u) * pc.output_dim + out_col, out_col + 1u < pc.output_dim)
                : vec2(0.0);

        // Padded/masked lanes participate in both barriers; they must never
        // return before the rest of the workgroup has consumed the shared tile.
        barrier();
        if (lane_valid) {
            uint count = min(INPUT_TILE, pc.input_dim - k_base);
            for (uint k = 0u; k < count; ++k) {
                vec2 weights = weight_tile[k * 17u + local_x];
                sum.x = fma(input_tile[local_y * 33u + k], weights.x, sum.x);
                if (out_col + 1u < pc.output_dim) {
                    sum.y = fma(input_tile[local_y * 33u + k], weights.y, sum.y);
                }
            }
        }
        barrier();
    }

    if (lane_valid) {
        uint output_index = row * pc.output_dim + out_col;
        output_values[output_index] = sum.x;
        if (out_col + 1u < pc.output_dim) {
            output_values[output_index + 1u] = sum.y;
        }
    }
}
