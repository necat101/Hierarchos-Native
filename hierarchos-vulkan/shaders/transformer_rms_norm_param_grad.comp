#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer GradOutputBuffer { float grad_output[]; };
layout(set = 0, binding = 1, std430) readonly buffer InputBuffer { float x[]; };
layout(set = 0, binding = 2, std430) readonly buffer RstdBuffer { float rstd_values[]; };
layout(set = 0, binding = 3, std430) writeonly buffer GradWeightBuffer { float grad_weight[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint dim;
    uint parameter_groups;
} pc;

void main() {
    uint parameter_index = gl_GlobalInvocationID.x;
    uint parameter_count = pc.dim * pc.parameter_groups;
    if (parameter_index >= parameter_count) return;
    uint group = parameter_index / pc.dim;
    uint col = parameter_index % pc.dim;
    float dw = 0.0;
    for (uint row = group; row < pc.rows; row += pc.parameter_groups) {
        uint index = row * pc.dim + col;
        // PyTorch's RMSNorm weight gradient follows the materialized forward
        // value x * rstd and then reduces grad_output * normalized_x.  Keep
        // both products separately rounded instead of contracting the outer
        // multiply into the row accumulator; the fused form can move a saved
        // norm gradient by one FP32 ulp after the residual backward path.
        precise float normalized_x = x[index] * rstd_values[row];
        precise float contribution = grad_output[index] * normalized_x;
        dw += contribution;
    }
    grad_weight[parameter_index] = dw;
}
