#version 450
#extension GL_ARB_gpu_shader_fp64 : require
#extension GL_GOOGLE_include_directive : require
#include "fp32_sleef_trig.glsl"
#include "fp32_vml_cos.glsl"
// Standalone independent regression of the same helper used by shared RoPE.
layout(local_size_x = 256) in;
layout(set=0,binding=0,std430) readonly buffer Input { float x[]; };
layout(set=0,binding=1,std430) writeonly buffer Output { float y[]; };
layout(push_constant) uniform Push { uint n; } pc;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i<pc.n) y[i]=vml_cos_bounded(x[i]);
}
