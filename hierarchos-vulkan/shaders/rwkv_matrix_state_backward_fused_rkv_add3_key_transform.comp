#version 450

// Matrix-state backward with recurrent r/k/v fan-in and key-transform backward
// folded into one head-owned dispatch. The state-path reductions and the
// key-normalization reduction retain the legacy serial FP32 accumulation order;
// all historical intermediate gradients remain materialized for the unchanged
// projection/backward and SafeTensors/PyTorch interchange contract.
#ifndef RWKV_STATE_BACKWARD_WORKGROUP_SIZE
#define RWKV_STATE_BACKWARD_WORKGROUP_SIZE 64
#endif

#ifndef RWKV_FAST_SUBGROUP_KEY_NORM
#define RWKV_FAST_SUBGROUP_KEY_NORM 0
#endif

#ifndef RWKV_FAST_TREE_RECURRENT_REDUCTIONS
#define RWKV_FAST_TREE_RECURRENT_REDUCTIONS 0
#endif

#ifndef RWKV_FAST_TILED_RECURRENT_REDUCTIONS
#define RWKV_FAST_TILED_RECURRENT_REDUCTIONS 0
#endif

#ifndef RWKV_FAST_SUBGROUP_RECURRENT_FUSION
#define RWKV_FAST_SUBGROUP_RECURRENT_FUSION 0
#endif

#ifndef RWKV_PACKED_STATE_INPUT
#define RWKV_PACKED_STATE_INPUT 0
#endif

#if RWKV_FAST_TREE_RECURRENT_REDUCTIONS || RWKV_FAST_TILED_RECURRENT_REDUCTIONS
#define RWKV_FAST_PARALLEL_RECURRENT_REDUCTIONS 1
#else
#define RWKV_FAST_PARALLEL_RECURRENT_REDUCTIONS 0
#endif

#if RWKV_FAST_SUBGROUP_KEY_NORM || RWKV_FAST_SUBGROUP_RECURRENT_FUSION
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#endif
layout(local_size_x = RWKV_STATE_BACKWARD_WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer StateBuffer { float state_values[]; };
layout(set = 0, binding = 1, std430) readonly buffer NewStateBuffer { float new_state[]; };
layout(set = 0, binding = 2, std430) readonly buffer ReceptanceBuffer { float r[]; };
layout(set = 0, binding = 3, std430) readonly buffer KeyBuffer { float k[]; };
layout(set = 0, binding = 4, std430) readonly buffer ValueBuffer { float v[]; };
layout(set = 0, binding = 5, std430) readonly buffer NormalizedKeyBuffer { float kk[]; };
layout(set = 0, binding = 6, std430) readonly buffer InContextBuffer { float a[]; };
layout(set = 0, binding = 7, std430) readonly buffer DecayLogBuffer { float w[]; };
layout(set = 0, binding = 8, std430) readonly buffer SavedSaBuffer { float saved_sa[]; };
layout(set = 0, binding = 9, std430) readonly buffer GradNewStateBuffer { float grad_new_state[]; };
layout(set = 0, binding = 10, std430) readonly buffer GradTimeMixBuffer { float grad_tmix[]; };
layout(set = 0, binding = 11, std430) readonly buffer PostGradReceptanceBuffer { float post_grad_r[]; };
layout(set = 0, binding = 12, std430) readonly buffer PostGradKeyBuffer { float post_grad_k[]; };
layout(set = 0, binding = 13, std430) readonly buffer PostGradValueBuffer { float post_grad_v[]; };
layout(set = 0, binding = 14, std430) readonly buffer ExternalGradValueBuffer { float external_grad_v[]; };
layout(set = 0, binding = 15, std430) writeonly buffer GradStateBuffer { float grad_state[]; };
layout(set = 0, binding = 16, std430) writeonly buffer TotalGradValueBuffer { float total_grad_v[]; };
layout(set = 0, binding = 17, std430) writeonly buffer TotalGradReceptanceBuffer { float total_grad_r[]; };
layout(set = 0, binding = 18, std430) writeonly buffer TotalGradKeyBuffer { float total_grad_k[]; };
layout(set = 0, binding = 19, std430) writeonly buffer GradNormalizedKeyBuffer { float grad_kk[]; };
layout(set = 0, binding = 20, std430) writeonly buffer GradInContextDirectBuffer { float grad_a_direct[]; };
layout(set = 0, binding = 21, std430) writeonly buffer GradDecayLogBuffer { float grad_w[]; };
layout(set = 0, binding = 22, std430) readonly buffer RawKeyBuffer { float raw_k[]; };
layout(set = 0, binding = 23, std430) readonly buffer KeyNormScaleBuffer { float k_k[]; };
layout(set = 0, binding = 24, std430) readonly buffer KeyContextScaleBuffer { float k_a[]; };
layout(set = 0, binding = 25, std430) writeonly buffer GradRawKeyBuffer { float grad_raw_k[]; };
layout(set = 0, binding = 26, std430) writeonly buffer GradInContextBuffer { float grad_a[]; };
layout(set = 0, binding = 27, std430) writeonly buffer GradKeyNormScalePartialBuffer { float grad_k_k_partial[]; };
layout(set = 0, binding = 28, std430) writeonly buffer GradKeyContextScalePartialBuffer { float grad_k_a_partial[]; };
#ifdef FUSE_KEY_PARAM_REDUCE
layout(set = 0, binding = 29, std430) writeonly buffer GradKeyNormScaleBuffer { float grad_k_k[]; };
layout(set = 0, binding = 30, std430) writeonly buffer GradKeyContextScaleBuffer { float grad_k_a[]; };
#endif

layout(push_constant) uniform Push {
    uint batch;
    uint width;
    uint head_size;
#if RWKV_PACKED_STATE_INPUT
    uint matrix_offset;
#endif
} pc;

float load_state_value(uint matrix_row, uint matrix_col) {
#if RWKV_PACKED_STATE_INPUT
    uint state_size = pc.matrix_offset + pc.head_size;
    return state_values[matrix_row * state_size + pc.matrix_offset + matrix_col];
#else
    return state_values[matrix_row * pc.head_size + matrix_col];
#endif
}

shared float q_shared[64];
shared float total_grad_k_shared[64];
shared float grad_kk_shared[64];
shared float grad_a_direct_shared[64];
shared float norm_sq_shared;
shared float grad_dot_kk_shared;
#if RWKV_FAST_PARALLEL_RECURRENT_REDUCTIONS
shared float recurrent_tree_0[RWKV_STATE_BACKWARD_WORKGROUP_SIZE];
shared float recurrent_tree_1[RWKV_STATE_BACKWARD_WORKGROUP_SIZE];
shared float recurrent_tree_2[RWKV_STATE_BACKWARD_WORKGROUP_SIZE];
shared float recurrent_tree_3[RWKV_STATE_BACKWARD_WORKGROUP_SIZE];
shared float recurrent_tree_4[RWKV_STATE_BACKWARD_WORKGROUP_SIZE];
#endif
#if RWKV_FAST_SUBGROUP_KEY_NORM
shared float subgroup_norm_sq[RWKV_STATE_BACKWARD_WORKGROUP_SIZE];
shared float subgroup_grad_dot_kk[RWKV_STATE_BACKWARD_WORKGROUP_SIZE];
#endif
#if RWKV_FAST_SUBGROUP_RECURRENT_FUSION
shared float recurrent_subgroup_partial_0[RWKV_STATE_BACKWARD_WORKGROUP_SIZE];
shared float recurrent_subgroup_partial_1[RWKV_STATE_BACKWARD_WORKGROUP_SIZE];
shared float recurrent_subgroup_partial_2[RWKV_STATE_BACKWARD_WORKGROUP_SIZE];
shared float recurrent_subgroup_partial_3[RWKV_STATE_BACKWARD_WORKGROUP_SIZE];
shared float recurrent_subgroup_partial_4[RWKV_STATE_BACKWARD_WORKGROUP_SIZE];
#endif

void main() {
    uint heads = pc.width / pc.head_size;
    uint group = gl_WorkGroupID.x;
    uint group_count = pc.batch * heads;
    if (group >= group_count) {
        return;
    }

    uint batch_index = group / heads;
    uint head = group - batch_index * heads;
    uint lane = gl_LocalInvocationID.x;
    uint head_channel_base = batch_index * pc.width + head * pc.head_size;
    uint channel_base = head * pc.head_size;
    uint matrix_head_base = group * pc.head_size * pc.head_size;

#if RWKV_FAST_SUBGROUP_RECURRENT_FUSION
    // Exact-one-subgroup recurrent/key-transform fusion. Active lanes own rows
    // throughout the recurrence. q(row) is written once to shared memory and a
    // subgroup-scoped memory/execution barrier makes it visible to the exact
    // one-subgroup workgroup; the original column accumulation order is then
    // preserved. Key-normalization stays in registers with two subgroup dots,
    // so the qualified path uses no workgroup barriers.
    if (gl_NumSubgroups == 1u && pc.head_size <= gl_SubgroupSize) {
        bool lane_valid = lane < pc.head_size;
        float q_lane = 0.0;
        float lane_total_key = 0.0;
        float lane_grad_kk = 0.0;
        float lane_grad_a_direct = 0.0;

        if (lane_valid) {
            uint linear_row = head_channel_base + lane;
            uint matrix_row_base = matrix_head_base + lane * pc.head_size;
            float grad_t = grad_tmix[linear_row];
            float grad_value = 0.0;
            for (uint col = 0u; col < pc.head_size; ++col) {
                uint channel_col = head_channel_base + col;
                uint matrix_index = matrix_row_base + col;
                float h = grad_new_state[matrix_index] + grad_t * r[channel_col];
                float b = kk[channel_col] * a[channel_col];
                q_lane = fma(h, b, q_lane);
                grad_value = fma(h, k[channel_col], grad_value);
            }
            total_grad_v[linear_row] = grad_value
                + post_grad_v[linear_row]
                + external_grad_v[linear_row];

            for (uint col = 0u; col < pc.head_size; ++col) {
                uint channel_col = head_channel_base + col;
                uint matrix_index = matrix_row_base + col;
                float h = grad_new_state[matrix_index] + grad_t * r[channel_col];
                float bounded_w = (isnan(w[channel_col]) || isinf(w[channel_col]))
            ? w[channel_col]
            : clamp(w[channel_col], -60.0, 30.0);
                float decay = exp(-exp(bounded_w));
                grad_state[matrix_index] = h * decay - kk[channel_col] * q_lane;
            }
            q_shared[lane] = q_lane;
        }

        subgroupMemoryBarrierShared();
        subgroupBarrier();

        float grad_receptance = 0.0;
        float grad_key = 0.0;
        float grad_b = 0.0;
        float grad_decay = 0.0;
        float grad_kk_from_sa = 0.0;
        if (lane_valid) {
            uint linear_col = head_channel_base + lane;
            for (uint row = 0u; row < pc.head_size; ++row) {
                uint linear_row = head_channel_base + row;
                uint matrix_index = matrix_head_base + row * pc.head_size + lane;
                float grad_t = grad_tmix[linear_row];
                float h = grad_new_state[matrix_index] + grad_t * r[linear_col];
                grad_receptance = fma(grad_t, new_state[matrix_index], grad_receptance);
                grad_key = fma(h, v[head_channel_base + row], grad_key);
                grad_b = fma(h, saved_sa[linear_row], grad_b);
                float state_value = load_state_value(head_channel_base + row, lane);
                grad_decay = fma(h, state_value, grad_decay);
                grad_kk_from_sa = fma(-q_shared[row], state_value, grad_kk_from_sa);
            }
        }

        if (lane_valid) {
            uint linear_col = head_channel_base + lane;
            float kk_value = kk[linear_col];
            float a_value = a[linear_col];
            lane_total_key = grad_key + post_grad_k[linear_col];
            lane_grad_kk = grad_kk_from_sa + grad_b * a_value;
            lane_grad_a_direct = grad_b * kk_value;
            total_grad_r[linear_col] = grad_receptance + post_grad_r[linear_col];
            total_grad_k[linear_col] = lane_total_key;
            grad_kk[linear_col] = lane_grad_kk;
            grad_a_direct[linear_col] = lane_grad_a_direct;

            float w_value = w[linear_col];
            float bounded_w = (isnan(w_value) || isinf(w_value))
            ? w_value
            : clamp(w_value, -60.0, 30.0);
            float exp_w = exp(bounded_w);
            float decay = exp(-exp_w);
            float clamp_grad = (isnan(w_value) || isinf(w_value)
            || (w_value >= -60.0 && w_value <= 30.0)) ? 1.0 : 0.0;
            grad_w[linear_col] = grad_decay * (-exp_w * decay) * clamp_grad;
        }

        float norm_term = 0.0;
        float grad_dot_term = 0.0;
        if (lane_valid) {
            uint index = head_channel_base + lane;
            uint channel = channel_base + lane;
            float z = raw_k[index] * k_k[channel];
            norm_term = z * z;
            grad_dot_term = lane_grad_kk * kk[index];
        }
        float norm_sq = subgroupAdd(norm_term);
        float grad_dot_kk = subgroupAdd(grad_dot_term);

        if (lane_valid) {
            uint index = head_channel_base + lane;
            uint channel = channel_base + lane;
            float norm = sqrt(norm_sq);
            float denom = max(norm, 1.0e-12);
            bool normalized_branch = norm > 1.0e-12;
            float raw = raw_k[index];
            float grad_z = normalized_branch
                ? (lane_grad_kk - kk[index] * grad_dot_kk) / denom
                : lane_grad_kk / denom;
            float scale = 1.0 + (a[index] - 1.0) * k_a[channel];
            grad_raw_k[index] = lane_total_key * scale + grad_z * k_k[channel];
            grad_a[index] = lane_grad_a_direct + lane_total_key * raw * k_a[channel];
            float grad_k_k_value = grad_z * raw;
            float grad_k_a_value = lane_total_key * raw * (a[index] - 1.0);
            grad_k_k_partial[index] = grad_k_k_value;
            grad_k_a_partial[index] = grad_k_a_value;
#ifdef FUSE_KEY_PARAM_REDUCE
            grad_k_k[channel] = grad_k_k_value;
            grad_k_a[channel] = grad_k_a_value;
#endif
        }
        return;
    }

    // Paired-wave head reduction for the wave32/head64 frontier. Adjacent
    // subgroup pairs cover consecutive slices of a single logical head, merge
    // exactly two subgroup partials through shared memory, then reuse the same
    // pairing for the column reductions. Wider complete-subgroup workgroups can
    // run multiple head-local row/column reductions concurrently without
    // changing any tensor indexing or checkpoint-visible layout.
    uint compiled_workgroup_size = uint(RWKV_STATE_BACKWARD_WORKGROUP_SIZE);
    bool paired_subgroup_head = gl_NumSubgroups >= 2u
        && (gl_NumSubgroups & 1u) == 0u
        && gl_SubgroupSize > 0u
        && compiled_workgroup_size >= 2u * gl_SubgroupSize
        && (compiled_workgroup_size % gl_SubgroupSize) == 0u
        && gl_NumSubgroups == compiled_workgroup_size / gl_SubgroupSize
        && pc.head_size > gl_SubgroupSize
        && pc.head_size <= 2u * gl_SubgroupSize;
    if (paired_subgroup_head) {
        uint subgroup = gl_SubgroupID;
        uint subgroup_lane = gl_SubgroupInvocationID;
        uint pair_id = subgroup >> 1u;
        uint pair_half = subgroup & 1u;
        uint pair_count = gl_NumSubgroups >> 1u;
        uint pair_base_subgroup = pair_id << 1u;
        uint pair_slice_base = pair_half * gl_SubgroupSize;
        uint rounds = (pc.head_size + pair_count - 1u) / pair_count;

        for (uint round = 0u; round < rounds; ++round) {
            uint row = round * pair_count + pair_id;
            bool row_valid = row < pc.head_size;
            uint col = pair_slice_base + subgroup_lane;
            bool element_valid = row_valid && col < pc.head_size;
            float q_term = 0.0;
            float grad_value_term = 0.0;
            if (element_valid) {
                uint linear_row = head_channel_base + row;
                uint channel_col = head_channel_base + col;
                uint matrix_index = matrix_head_base + row * pc.head_size + col;
                float grad_t = grad_tmix[linear_row];
                float h = grad_new_state[matrix_index] + grad_t * r[channel_col];
                q_term = h * kk[channel_col] * a[channel_col];
                grad_value_term = h * k[channel_col];
            }
            float q_partial = subgroupAdd(q_term);
            float grad_value_partial = subgroupAdd(grad_value_term);
            if (subgroupElect()) {
                recurrent_subgroup_partial_0[subgroup] = q_partial;
                recurrent_subgroup_partial_1[subgroup] = grad_value_partial;
            }
            memoryBarrierShared();
            barrier();

            if (pair_half == 0u && subgroupElect() && row_valid) {
                float q = recurrent_subgroup_partial_0[pair_base_subgroup]
                    + recurrent_subgroup_partial_0[pair_base_subgroup + 1u];
                float grad_value = recurrent_subgroup_partial_1[pair_base_subgroup]
                    + recurrent_subgroup_partial_1[pair_base_subgroup + 1u];
                uint linear_row = head_channel_base + row;
                q_shared[row] = q;
                total_grad_v[linear_row] = grad_value
                    + post_grad_v[linear_row]
                    + external_grad_v[linear_row];
            }
            memoryBarrierShared();
            barrier();

            if (element_valid) {
                uint linear_row = head_channel_base + row;
                uint channel_col = head_channel_base + col;
                uint matrix_index = matrix_head_base + row * pc.head_size + col;
                float grad_t = grad_tmix[linear_row];
                float h = grad_new_state[matrix_index] + grad_t * r[channel_col];
                float bounded_w = (isnan(w[channel_col]) || isinf(w[channel_col]))
            ? w[channel_col]
            : clamp(w[channel_col], -60.0, 30.0);
                float decay = exp(-exp(bounded_w));
                grad_state[matrix_index] = h * decay - kk[channel_col] * q_shared[row];
            }
        }

        for (uint round = 0u; round < rounds; ++round) {
            uint col = round * pair_count + pair_id;
            bool col_valid = col < pc.head_size;
            uint row = pair_slice_base + subgroup_lane;
            bool element_valid = col_valid && row < pc.head_size;
            float grad_receptance_term = 0.0;
            float grad_key_term = 0.0;
            float grad_b_term = 0.0;
            float grad_decay_term = 0.0;
            float grad_kk_from_sa_term = 0.0;
            if (element_valid) {
                uint linear_col = head_channel_base + col;
                uint linear_row = head_channel_base + row;
                uint matrix_index = matrix_head_base + row * pc.head_size + col;
                float grad_t = grad_tmix[linear_row];
                float h = grad_new_state[matrix_index] + grad_t * r[linear_col];
                grad_receptance_term = grad_t * new_state[matrix_index];
                grad_key_term = h * v[head_channel_base + row];
                grad_b_term = h * saved_sa[linear_row];
                float state_value = load_state_value(head_channel_base + row, col);
                grad_decay_term = h * state_value;
                grad_kk_from_sa_term = -q_shared[row] * state_value;
            }
            float grad_receptance_partial = subgroupAdd(grad_receptance_term);
            float grad_key_partial = subgroupAdd(grad_key_term);
            float grad_b_partial = subgroupAdd(grad_b_term);
            float grad_decay_partial = subgroupAdd(grad_decay_term);
            float grad_kk_from_sa_partial = subgroupAdd(grad_kk_from_sa_term);
            if (subgroupElect()) {
                recurrent_subgroup_partial_0[subgroup] = grad_receptance_partial;
                recurrent_subgroup_partial_1[subgroup] = grad_key_partial;
                recurrent_subgroup_partial_2[subgroup] = grad_b_partial;
                recurrent_subgroup_partial_3[subgroup] = grad_decay_partial;
                recurrent_subgroup_partial_4[subgroup] = grad_kk_from_sa_partial;
            }
            memoryBarrierShared();
            barrier();

            if (pair_half == 0u && subgroupElect() && col_valid) {
                float grad_receptance = recurrent_subgroup_partial_0[pair_base_subgroup]
                    + recurrent_subgroup_partial_0[pair_base_subgroup + 1u];
                float grad_key = recurrent_subgroup_partial_1[pair_base_subgroup]
                    + recurrent_subgroup_partial_1[pair_base_subgroup + 1u];
                float grad_b = recurrent_subgroup_partial_2[pair_base_subgroup]
                    + recurrent_subgroup_partial_2[pair_base_subgroup + 1u];
                float grad_decay = recurrent_subgroup_partial_3[pair_base_subgroup]
                    + recurrent_subgroup_partial_3[pair_base_subgroup + 1u];
                float grad_kk_from_sa = recurrent_subgroup_partial_4[pair_base_subgroup]
                    + recurrent_subgroup_partial_4[pair_base_subgroup + 1u];
                uint linear_col = head_channel_base + col;
                float kk_value = kk[linear_col];
                float a_value = a[linear_col];
                float total_key = grad_key + post_grad_k[linear_col];
                float grad_kk_value = grad_kk_from_sa + grad_b * a_value;
                float grad_a_direct_value = grad_b * kk_value;
                total_grad_r[linear_col] = grad_receptance + post_grad_r[linear_col];
                total_grad_k[linear_col] = total_key;
                grad_kk[linear_col] = grad_kk_value;
                grad_a_direct[linear_col] = grad_a_direct_value;
                total_grad_k_shared[col] = total_key;
                grad_kk_shared[col] = grad_kk_value;
                grad_a_direct_shared[col] = grad_a_direct_value;

                float w_value = w[linear_col];
                float bounded_w = (isnan(w_value) || isinf(w_value))
            ? w_value
            : clamp(w_value, -60.0, 30.0);
                float exp_w = exp(bounded_w);
                float decay = exp(-exp_w);
                float clamp_grad = (isnan(w_value) || isinf(w_value)
            || (w_value >= -60.0 && w_value <= 30.0)) ? 1.0 : 0.0;
                grad_w[linear_col] = grad_decay * (-exp_w * decay) * clamp_grad;
            }
            memoryBarrierShared();
            barrier();
        }

        // Key-normalization spans the same wide head, so the first subgroup pair
        // performs the two native-wave dots and publishes their combined values
        // for the fully striped key-transform tail.
        float norm_term = 0.0;
        float grad_dot_term = 0.0;
        if (subgroup < 2u) {
            uint col = subgroup * gl_SubgroupSize + subgroup_lane;
            if (col < pc.head_size) {
                uint index = head_channel_base + col;
                uint channel = channel_base + col;
                float z = raw_k[index] * k_k[channel];
                norm_term = z * z;
                grad_dot_term = grad_kk_shared[col] * kk[index];
            }
            float norm_partial = subgroupAdd(norm_term);
            float grad_dot_partial = subgroupAdd(grad_dot_term);
            if (subgroupElect()) {
                recurrent_subgroup_partial_0[subgroup] = norm_partial;
                recurrent_subgroup_partial_1[subgroup] = grad_dot_partial;
            }
        }
        memoryBarrierShared();
        barrier();
        if (lane == 0u) {
            norm_sq_shared = recurrent_subgroup_partial_0[0]
                + recurrent_subgroup_partial_0[1];
            grad_dot_kk_shared = recurrent_subgroup_partial_1[0]
                + recurrent_subgroup_partial_1[1];
        }
        memoryBarrierShared();
        barrier();

        uint striped_lane = subgroup_lane * gl_NumSubgroups + subgroup;
        for (uint col = striped_lane; col < pc.head_size; col += compiled_workgroup_size) {
            uint index = head_channel_base + col;
            uint channel = channel_base + col;
            float norm = sqrt(norm_sq_shared);
            float denom = max(norm, 1.0e-12);
            bool normalized_branch = norm > 1.0e-12;
            float raw = raw_k[index];
            float total_key = total_grad_k_shared[col];
            float grad_kk_value = grad_kk_shared[col];
            float grad_z = normalized_branch
                ? (grad_kk_value - kk[index] * grad_dot_kk_shared) / denom
                : grad_kk_value / denom;
            float scale = 1.0 + (a[index] - 1.0) * k_a[channel];
            grad_raw_k[index] = total_key * scale + grad_z * k_k[channel];
            grad_a[index] = grad_a_direct_shared[col] + total_key * raw * k_a[channel];
            float grad_k_k_value = grad_z * raw;
            float grad_k_a_value = total_key * raw * (a[index] - 1.0);
            grad_k_k_partial[index] = grad_k_k_value;
            grad_k_a_partial[index] = grad_k_a_value;
#ifdef FUSE_KEY_PARAM_REDUCE
            grad_k_k[channel] = grad_k_k_value;
            grad_k_a[channel] = grad_k_a_value;
#endif
        }
        return;
    }

    // Multi-subgroup wave-cooperative recurrent path. Wide workgroups can own
    // multiple complete hardware subgroups; each subgroup advances through a
    // disjoint set of recurrent rows and columns while its lanes reduce the
    // head-local dot products. This keeps one logical head per workgroup (and
    // therefore leaves every tensor index and dispatch ABI unchanged), but
    // converts otherwise idle waves into useful reduction parallelism. The
    // only cross-subgroup rendezvous in the recurrent core is the q(row) handoff
    // between row and column phases.
    bool full_subgroup_workgroup = gl_NumSubgroups > 1u
        && gl_SubgroupSize > 0u
        && compiled_workgroup_size >= gl_SubgroupSize
        && (compiled_workgroup_size % gl_SubgroupSize) == 0u
        && gl_NumSubgroups == compiled_workgroup_size / gl_SubgroupSize
        && pc.head_size <= gl_SubgroupSize;
    if (full_subgroup_workgroup) {
        uint subgroup = gl_SubgroupID;
        uint subgroup_lane = gl_SubgroupInvocationID;

        for (uint row = subgroup; row < pc.head_size; row += gl_NumSubgroups) {
            uint linear_row = head_channel_base + row;
            uint matrix_row_base = matrix_head_base + row * pc.head_size;
            float grad_t = grad_tmix[linear_row];
            float q_term = 0.0;
            float grad_value_term = 0.0;
            if (subgroup_lane < pc.head_size) {
                uint col = subgroup_lane;
                uint channel_col = head_channel_base + col;
                uint matrix_index = matrix_row_base + col;
                float h = grad_new_state[matrix_index] + grad_t * r[channel_col];
                q_term = h * kk[channel_col] * a[channel_col];
                grad_value_term = h * k[channel_col];
            }
            float q = subgroupAdd(q_term);
            float grad_value = subgroupAdd(grad_value_term);
            if (subgroupElect()) {
                q_shared[row] = q;
                total_grad_v[linear_row] = grad_value
                    + post_grad_v[linear_row]
                    + external_grad_v[linear_row];
            }
            if (subgroup_lane < pc.head_size) {
                uint col = subgroup_lane;
                uint channel_col = head_channel_base + col;
                uint matrix_index = matrix_row_base + col;
                float h = grad_new_state[matrix_index] + grad_t * r[channel_col];
                float bounded_w = (isnan(w[channel_col]) || isinf(w[channel_col]))
            ? w[channel_col]
            : clamp(w[channel_col], -60.0, 30.0);
                float decay = exp(-exp(bounded_w));
                grad_state[matrix_index] = h * decay - kk[channel_col] * q;
            }
        }

        memoryBarrierShared();
        barrier();

        for (uint col = subgroup; col < pc.head_size; col += gl_NumSubgroups) {
            uint linear_col = head_channel_base + col;
            float grad_receptance_term = 0.0;
            float grad_key_term = 0.0;
            float grad_b_term = 0.0;
            float grad_decay_term = 0.0;
            float grad_kk_from_sa_term = 0.0;
            if (subgroup_lane < pc.head_size) {
                uint row = subgroup_lane;
                uint linear_row = head_channel_base + row;
                uint matrix_index = matrix_head_base + row * pc.head_size + col;
                float grad_t = grad_tmix[linear_row];
                float h = grad_new_state[matrix_index] + grad_t * r[linear_col];
                grad_receptance_term = grad_t * new_state[matrix_index];
                grad_key_term = h * v[head_channel_base + row];
                grad_b_term = h * saved_sa[linear_row];
                float state_value = load_state_value(head_channel_base + row, col);
                grad_decay_term = h * state_value;
                grad_kk_from_sa_term = -q_shared[row] * state_value;
            }

            float grad_receptance = subgroupAdd(grad_receptance_term);
            float grad_key = subgroupAdd(grad_key_term);
            float grad_b = subgroupAdd(grad_b_term);
            float grad_decay = subgroupAdd(grad_decay_term);
            float grad_kk_from_sa = subgroupAdd(grad_kk_from_sa_term);
            if (subgroupElect()) {
                float kk_value = kk[linear_col];
                float a_value = a[linear_col];
                float total_key = grad_key + post_grad_k[linear_col];
                float grad_kk_value = grad_kk_from_sa + grad_b * a_value;
                float grad_a_direct_value = grad_b * kk_value;
                total_grad_r[linear_col] = grad_receptance + post_grad_r[linear_col];
                total_grad_k[linear_col] = total_key;
                grad_kk[linear_col] = grad_kk_value;
                grad_a_direct[linear_col] = grad_a_direct_value;
                total_grad_k_shared[col] = total_key;
                grad_kk_shared[col] = grad_kk_value;
                grad_a_direct_shared[col] = grad_a_direct_value;

                float w_value = w[linear_col];
                float bounded_w = (isnan(w_value) || isinf(w_value))
            ? w_value
            : clamp(w_value, -60.0, 30.0);
                float exp_w = exp(bounded_w);
                float decay = exp(-exp_w);
                float clamp_grad = (isnan(w_value) || isinf(w_value)
            || (w_value >= -60.0 && w_value <= 30.0)) ? 1.0 : 0.0;
                grad_w[linear_col] = grad_decay * (-exp_w * decay) * clamp_grad;
            }
        }

        memoryBarrierShared();
        barrier();

        if (gl_SubgroupID == 0u) {
            float norm_term = 0.0;
            float grad_dot_term = 0.0;
            if (subgroup_lane < pc.head_size) {
                uint index = head_channel_base + subgroup_lane;
                uint channel = channel_base + subgroup_lane;
                float z = raw_k[index] * k_k[channel];
                norm_term = z * z;
                grad_dot_term = grad_kk_shared[subgroup_lane] * kk[index];
            }
            float norm_sq = subgroupAdd(norm_term);
            float grad_dot_kk = subgroupAdd(grad_dot_term);
            if (subgroupElect()) {
                norm_sq_shared = norm_sq;
                grad_dot_kk_shared = grad_dot_kk;
            }
        }

        memoryBarrierShared();
        barrier();

        // Stripe the independent key-transform tail across every subgroup.
        // A plain `col = lane` mapping would reactivate only subgroup 0 whenever
        // head_size <= subgroup_size, throwing away the extra waves we just used
        // for the recurrent phase. Interleaving subgroup IDs into the low bits
        // gives each complete wave an equal share of columns while preserving
        // one writer per output element.
        uint striped_lane = subgroup_lane * gl_NumSubgroups + subgroup;
        for (uint col = striped_lane; col < pc.head_size; col += compiled_workgroup_size) {
            uint index = head_channel_base + col;
            uint channel = channel_base + col;
            float norm = sqrt(norm_sq_shared);
            float denom = max(norm, 1.0e-12);
            bool normalized_branch = norm > 1.0e-12;
            float raw = raw_k[index];
            float total_key = total_grad_k_shared[col];
            float grad_kk_value = grad_kk_shared[col];
            float grad_z = normalized_branch
                ? (grad_kk_value - kk[index] * grad_dot_kk_shared) / denom
                : grad_kk_value / denom;
            float scale = 1.0 + (a[index] - 1.0) * k_a[channel];
            grad_raw_k[index] = total_key * scale + grad_z * k_k[channel];
            grad_a[index] = grad_a_direct_shared[col] + total_key * raw * k_a[channel];
            float grad_k_k_value = grad_z * raw;
            float grad_k_a_value = total_key * raw * (a[index] - 1.0);
            grad_k_k_partial[index] = grad_k_k_value;
            grad_k_a_partial[index] = grad_k_a_value;
#ifdef FUSE_KEY_PARAM_REDUCE
            grad_k_k[channel] = grad_k_k_value;
            grad_k_a[channel] = grad_k_a_value;
#endif
        }
        return;
    }
#endif

#if RWKV_FAST_PARALLEL_RECURRENT_REDUCTIONS
    // Experimental recurrent-reduction arms. When the workgroup can assign an
    // integer lane cluster to every row/column, split each historical serial
    // dot product across that cluster and merge the partials with a shared
    // binary tree. The tree arm interleaves elements across lanes; the tiled
    // arm gives each lane one contiguous slice before the same final tree.
    // Both deliberately change FP32 addition order while leaving every
    // tensor/checkpoint interface untouched. Unsupported geometries fall back
    // to the strict serial implementation.
    uint recurrent_tree_width = uint(RWKV_STATE_BACKWARD_WORKGROUP_SIZE) / pc.head_size;
    bool recurrent_tree_enabled = recurrent_tree_width > 1u
        && recurrent_tree_width * pc.head_size == uint(RWKV_STATE_BACKWARD_WORKGROUP_SIZE);
    if (recurrent_tree_enabled) {
        uint row = lane / recurrent_tree_width;
        uint reduction_lane = lane - row * recurrent_tree_width;
        uint linear_row = head_channel_base + row;
        uint matrix_row_base = matrix_head_base + row * pc.head_size;
        float grad_t = grad_tmix[linear_row];
        float q_partial = 0.0;
        float grad_value_partial = 0.0;
#if RWKV_FAST_TILED_RECURRENT_REDUCTIONS
        uint recurrent_tile_size = (pc.head_size + recurrent_tree_width - 1u) / recurrent_tree_width;
        uint recurrent_tile_begin = reduction_lane * recurrent_tile_size;
        uint recurrent_tile_end = min(recurrent_tile_begin + recurrent_tile_size, pc.head_size);
        for (uint col = recurrent_tile_begin; col < recurrent_tile_end; ++col) {
#else
        for (uint col = reduction_lane; col < pc.head_size; col += recurrent_tree_width) {
#endif
            uint channel_col = head_channel_base + col;
            uint matrix_index = matrix_row_base + col;
            float h = grad_new_state[matrix_index] + grad_t * r[channel_col];
            float b = kk[channel_col] * a[channel_col];
            q_partial = fma(h, b, q_partial);
            grad_value_partial = fma(h, k[channel_col], grad_value_partial);
        }
        recurrent_tree_0[lane] = q_partial;
        recurrent_tree_1[lane] = grad_value_partial;
        memoryBarrierShared();
        barrier();
        for (uint stride = recurrent_tree_width >> 1u; stride > 0u; stride >>= 1u) {
            if (reduction_lane < stride) {
                recurrent_tree_0[lane] += recurrent_tree_0[lane + stride];
                recurrent_tree_1[lane] += recurrent_tree_1[lane + stride];
            }
            memoryBarrierShared();
            barrier();
        }
        if (reduction_lane == 0u) {
            q_shared[row] = recurrent_tree_0[lane];
            total_grad_v[linear_row] = recurrent_tree_1[lane]
                + post_grad_v[linear_row]
                + external_grad_v[linear_row];
        }
        memoryBarrierShared();
        barrier();

        float q = q_shared[row];
#if RWKV_FAST_TILED_RECURRENT_REDUCTIONS
        for (uint col = recurrent_tile_begin; col < recurrent_tile_end; ++col) {
#else
        for (uint col = reduction_lane; col < pc.head_size; col += recurrent_tree_width) {
#endif
            uint channel_col = head_channel_base + col;
            uint matrix_index = matrix_row_base + col;
            float h = grad_new_state[matrix_index] + grad_t * r[channel_col];
            float bounded_w = (isnan(w[channel_col]) || isinf(w[channel_col]))
            ? w[channel_col]
            : clamp(w[channel_col], -60.0, 30.0);
            float decay = exp(-exp(bounded_w));
            grad_state[matrix_index] = h * decay - kk[channel_col] * q;
        }
    } else {
#endif
    for (uint row = lane; row < pc.head_size; row += RWKV_STATE_BACKWARD_WORKGROUP_SIZE) {
        uint linear_row = head_channel_base + row;
        uint matrix_row_base = matrix_head_base + row * pc.head_size;
        float grad_t = grad_tmix[linear_row];
        float q = 0.0;
        float grad_value = 0.0;
        for (uint col = 0; col < pc.head_size; ++col) {
            uint channel_col = head_channel_base + col;
            uint matrix_index = matrix_row_base + col;
            float h = grad_new_state[matrix_index] + grad_t * r[channel_col];
            float b = kk[channel_col] * a[channel_col];
            q = fma(h, b, q);
            grad_value = fma(h, k[channel_col], grad_value);
        }
        q_shared[row] = q;
        total_grad_v[linear_row] = grad_value + post_grad_v[linear_row] + external_grad_v[linear_row];

        for (uint col = 0; col < pc.head_size; ++col) {
            uint channel_col = head_channel_base + col;
            uint matrix_index = matrix_row_base + col;
            float h = grad_new_state[matrix_index] + grad_t * r[channel_col];
            float bounded_w = (isnan(w[channel_col]) || isinf(w[channel_col]))
            ? w[channel_col]
            : clamp(w[channel_col], -60.0, 30.0);
            float decay = exp(-exp(bounded_w));
            grad_state[matrix_index] = h * decay - kk[channel_col] * q;
        }
    }
#if RWKV_FAST_PARALLEL_RECURRENT_REDUCTIONS
    }
#endif

    memoryBarrierShared();
    barrier();

#if RWKV_FAST_PARALLEL_RECURRENT_REDUCTIONS
    if (recurrent_tree_enabled) {
        uint col = lane / recurrent_tree_width;
        uint reduction_lane = lane - col * recurrent_tree_width;
        uint linear_col = head_channel_base + col;
        float grad_receptance_partial = 0.0;
        float grad_key_partial = 0.0;
        float grad_b_partial = 0.0;
        float grad_decay_partial = 0.0;
        float grad_kk_from_sa_partial = 0.0;
#if RWKV_FAST_TILED_RECURRENT_REDUCTIONS
        uint recurrent_tile_size = (pc.head_size + recurrent_tree_width - 1u) / recurrent_tree_width;
        uint recurrent_tile_begin = reduction_lane * recurrent_tile_size;
        uint recurrent_tile_end = min(recurrent_tile_begin + recurrent_tile_size, pc.head_size);
        for (uint row = recurrent_tile_begin; row < recurrent_tile_end; ++row) {
#else
        for (uint row = reduction_lane; row < pc.head_size; row += recurrent_tree_width) {
#endif
            uint linear_row = head_channel_base + row;
            uint matrix_index = matrix_head_base + row * pc.head_size + col;
            float grad_t = grad_tmix[linear_row];
            float h = grad_new_state[matrix_index] + grad_t * r[linear_col];
            grad_receptance_partial = fma(
                grad_t,
                new_state[matrix_index],
                grad_receptance_partial
            );
            grad_key_partial = fma(h, v[head_channel_base + row], grad_key_partial);
            grad_b_partial = fma(h, saved_sa[linear_row], grad_b_partial);
            float state_value = load_state_value(head_channel_base + row, col);
            grad_decay_partial = fma(h, state_value, grad_decay_partial);
            grad_kk_from_sa_partial = fma(
                -q_shared[row],
                state_value,
                grad_kk_from_sa_partial
            );
        }
        recurrent_tree_0[lane] = grad_receptance_partial;
        recurrent_tree_1[lane] = grad_key_partial;
        recurrent_tree_2[lane] = grad_b_partial;
        recurrent_tree_3[lane] = grad_decay_partial;
        recurrent_tree_4[lane] = grad_kk_from_sa_partial;
        memoryBarrierShared();
        barrier();
        for (uint stride = recurrent_tree_width >> 1u; stride > 0u; stride >>= 1u) {
            if (reduction_lane < stride) {
                recurrent_tree_0[lane] += recurrent_tree_0[lane + stride];
                recurrent_tree_1[lane] += recurrent_tree_1[lane + stride];
                recurrent_tree_2[lane] += recurrent_tree_2[lane + stride];
                recurrent_tree_3[lane] += recurrent_tree_3[lane + stride];
                recurrent_tree_4[lane] += recurrent_tree_4[lane + stride];
            }
            memoryBarrierShared();
            barrier();
        }

        if (reduction_lane == 0u) {
            float kk_value = kk[linear_col];
            float a_value = a[linear_col];
            float total_key = recurrent_tree_1[lane] + post_grad_k[linear_col];
            float grad_kk_value = recurrent_tree_4[lane] + recurrent_tree_2[lane] * a_value;
            float grad_a_direct_value = recurrent_tree_2[lane] * kk_value;

            total_grad_r[linear_col] = recurrent_tree_0[lane] + post_grad_r[linear_col];
            total_grad_k[linear_col] = total_key;
            grad_kk[linear_col] = grad_kk_value;
            grad_a_direct[linear_col] = grad_a_direct_value;
            total_grad_k_shared[col] = total_key;
            grad_kk_shared[col] = grad_kk_value;
            grad_a_direct_shared[col] = grad_a_direct_value;

            float w_value = w[linear_col];
            float bounded_w = (isnan(w_value) || isinf(w_value))
            ? w_value
            : clamp(w_value, -60.0, 30.0);
            float exp_w = exp(bounded_w);
            float decay = exp(-exp_w);
            float clamp_grad = (isnan(w_value) || isinf(w_value)
            || (w_value >= -60.0 && w_value <= 30.0)) ? 1.0 : 0.0;
            grad_w[linear_col] = recurrent_tree_3[lane] * (-exp_w * decay) * clamp_grad;
        }
    } else {
#endif
    for (uint col = lane; col < pc.head_size; col += RWKV_STATE_BACKWARD_WORKGROUP_SIZE) {
        uint linear_col = head_channel_base + col;
        float grad_receptance = 0.0;
        float grad_key = 0.0;
        float grad_b = 0.0;
        float grad_decay = 0.0;
        float grad_kk_from_sa = 0.0;
        for (uint row = 0; row < pc.head_size; ++row) {
            uint linear_row = head_channel_base + row;
            uint matrix_index = matrix_head_base + row * pc.head_size + col;
            float grad_t = grad_tmix[linear_row];
            float h = grad_new_state[matrix_index] + grad_t * r[linear_col];
            grad_receptance = fma(grad_t, new_state[matrix_index], grad_receptance);
            grad_key = fma(h, v[head_channel_base + row], grad_key);
            grad_b = fma(h, saved_sa[linear_row], grad_b);
            float state_value = load_state_value(head_channel_base + row, col);
            grad_decay = fma(h, state_value, grad_decay);
            grad_kk_from_sa = fma(-q_shared[row], state_value, grad_kk_from_sa);
        }

        float kk_value = kk[linear_col];
        float a_value = a[linear_col];
        float total_key = grad_key + post_grad_k[linear_col];
        float grad_kk_value = grad_kk_from_sa + grad_b * a_value;
        float grad_a_direct_value = grad_b * kk_value;

        total_grad_r[linear_col] = grad_receptance + post_grad_r[linear_col];
        total_grad_k[linear_col] = total_key;
        grad_kk[linear_col] = grad_kk_value;
        grad_a_direct[linear_col] = grad_a_direct_value;
        total_grad_k_shared[col] = total_key;
        grad_kk_shared[col] = grad_kk_value;
        grad_a_direct_shared[col] = grad_a_direct_value;

        float w_value = w[linear_col];
        float bounded_w = (isnan(w_value) || isinf(w_value))
            ? w_value
            : clamp(w_value, -60.0, 30.0);
        float exp_w = exp(bounded_w);
        float decay = exp(-exp_w);
        float clamp_grad = (isnan(w_value) || isinf(w_value)
            || (w_value >= -60.0 && w_value <= 30.0)) ? 1.0 : 0.0;
        grad_w[linear_col] = grad_decay * (-exp_w * decay) * clamp_grad;
    }
#if RWKV_FAST_PARALLEL_RECURRENT_REDUCTIONS
    }
#endif

    memoryBarrierShared();
    barrier();

#if RWKV_FAST_SUBGROUP_KEY_NORM
    // Experimental fast-numerics arm. The state-path recurrence reductions
    // above remain serial per row/column; only the two key-normalization dot
    // products change ownership/addition order here.
    float local_norm_sq = 0.0;
    float local_grad_dot_kk = 0.0;
    for (uint col = lane; col < pc.head_size; col += RWKV_STATE_BACKWARD_WORKGROUP_SIZE) {
        uint index = head_channel_base + col;
        uint channel = channel_base + col;
        float z = raw_k[index] * k_k[channel];
        local_norm_sq = fma(z, z, local_norm_sq);
        local_grad_dot_kk = fma(grad_kk_shared[col], kk[index], local_grad_dot_kk);
    }
    float subgroup_norm = subgroupAdd(local_norm_sq);
    float subgroup_grad_dot = subgroupAdd(local_grad_dot_kk);
    if (subgroupElect()) {
        subgroup_norm_sq[gl_SubgroupID] = subgroup_norm;
        subgroup_grad_dot_kk[gl_SubgroupID] = subgroup_grad_dot;
    }
    barrier();
    if (lane == 0u) {
        float norm_sq = 0.0;
        float grad_dot_kk = 0.0;
        for (uint subgroup = 0u; subgroup < gl_NumSubgroups; ++subgroup) {
            norm_sq += subgroup_norm_sq[subgroup];
            grad_dot_kk += subgroup_grad_dot_kk[subgroup];
        }
        norm_sq_shared = norm_sq;
        grad_dot_kk_shared = grad_dot_kk;
    }
#else
    if (lane == 0) {
        float norm_sq = 0.0;
        float grad_dot_kk = 0.0;
        for (uint col = 0; col < pc.head_size; ++col) {
            uint index = head_channel_base + col;
            uint channel = channel_base + col;
            float z = raw_k[index] * k_k[channel];
            norm_sq = fma(z, z, norm_sq);
            grad_dot_kk = fma(grad_kk_shared[col], kk[index], grad_dot_kk);
        }
        norm_sq_shared = norm_sq;
        grad_dot_kk_shared = grad_dot_kk;
    }
#endif

    memoryBarrierShared();
    barrier();

    for (uint col = lane; col < pc.head_size; col += RWKV_STATE_BACKWARD_WORKGROUP_SIZE) {
        uint index = head_channel_base + col;
        uint channel = channel_base + col;
        float norm = sqrt(norm_sq_shared);
        float denom = max(norm, 1.0e-12);
        bool normalized_branch = norm > 1.0e-12;
        float raw = raw_k[index];
        float grad_scaled = total_grad_k_shared[col];
        float grad_z = normalized_branch
            ? (grad_kk_shared[col] - kk[index] * grad_dot_kk_shared) / denom
            : grad_kk_shared[col] / denom;
        float scale = 1.0 + (a[index] - 1.0) * k_a[channel];

        grad_raw_k[index] = grad_scaled * scale + grad_z * k_k[channel];
        grad_a[index] = grad_a_direct_shared[col] + grad_scaled * raw * k_a[channel];
        float grad_k_k_value = grad_z * raw;
        float grad_k_a_value = grad_scaled * raw * (a[index] - 1.0);
        grad_k_k_partial[index] = grad_k_k_value;
        grad_k_a_partial[index] = grad_k_a_value;
#ifdef FUSE_KEY_PARAM_REDUCE
        // The Rust scheduler only selects this SPIR-V specialization for
        // batch==1. In that case the historical param-reduction kernel is an
        // identity copy, so publishing the final parameter gradients here is
        // bit-for-bit equivalent while removing one dispatch/barrier seam.
        grad_k_k[channel] = grad_k_k_value;
        grad_k_a[channel] = grad_k_a_value;
#endif
    }
}
