#version 450

// RDNA3 hardware-WMMA GEMM, mixed-precision arm.
//
//   C[m, n] = op(A)[m, k] * op(B)[k, n]      (FP16 operands, FP32 accumulation)
//
// This module exists only for adapters that expose
// VK_KHR_cooperative_matrix with a 16x16x16 f16/f16 -> f32 configuration and
// that accept a 32-wide compute subgroup for this pipeline. The host rejects
// every other adapter before the pipeline is created, so an unsupported device
// can never silently run this file (see `src/wmma.rs`).
//
// Contract:
//   * A and B are native `float16_t` storage buffers, C is FP32.
//   * `flags` bit 0 = A is stored transposed (A^T, i.e. a[k * lda + m]);
//     bit 1 = B is stored transposed (B^T, i.e. b[n * ldb + k]).
//   * One workgroup is one 32-wide subgroup and computes a 32x32 output tile as
//     four 16x16 cooperative matrix tiles. Operand fragments are staged through
//     workgroup memory, which is what lets the kernel accept arbitrary leading
//     dimensions, arbitrary (unaligned) shapes and partial 16x16x16 tiles: every
//     staged element outside the logical matrix is zero, so the padded fragment
//     contributes nothing to the accumulation.
//   * Fragment staging order matters. A is staged row-major [m][k] and B is
//     staged row-major [k][n]; both are then loaded as row-major cooperative
//     fragments. Staging B as [n][k] would have loaded a transposed operand and
//     silently computed A * B^T for square tiles, so the two index expressions
//     below are deliberately different.
//
// Phase LXI staging change (candidate A):
//
//   The operands are viewed as packed `f16vec2` words rather than scalar
//   halves. Each lane now fetches a *pair* of adjacent halves with one aligned
//   32-bit load instead of two 16-bit loads, halving the global-load issue
//   count and the staging-loop trip count. Pairing always happens along the
//   operand's globally contiguous axis, which is also the axis the workgroup
//   tile stores on a fixed stride:
//
//     A non-transposed  a[m][k]:  contiguous k -> pair along `col`
//     A transposed      a[k][m]:  contiguous m -> pair along `row`
//     B non-transposed  b[k][n]:  contiguous n -> pair along `col`
//     B transposed      b[n][k]:  contiguous k -> pair along `row`
//
//   The lane -> workgroup-tile mapping, the shared-memory tile layout
//   (`[tile][row * 16 + col]`), the row-major fragment loads and the four
//   cooperative multiply-adds per K slice are all unchanged, so the staged
//   bytes and the bank structure of the tile are exactly the pre-existing ones.
//   Global sectors touched per warp instruction are unchanged too: a `col`
//   pair is 4 bytes inside one sector, and a `row` pair is a 4-byte stride of
//   `ldx` that the scalar kernel already paid per element.
//
//   A pair is only fetched as one word when the leading dimension is even (so
//   the base of the pair is 4-byte aligned) and both halves are in range.
//   Every other case - an odd leading dimension, an odd tail on the reduction
//   or output axis, a partial edge tile - falls back to two independently
//   masked 16-bit extract loads, so no element outside the logical matrix is
//   ever read and every out-of-range element is still zero. The 16-bit operand
//   bit patterns are preserved exactly: the packed word is a plain load of the
//   same two halves, never a re-rounding.

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

// Packed native-FP16 storage: one word per two adjacent halves. `live_halves`
// elements occupy `ceil(live_halves / 2)` words, which is exactly the
// allocation the host already makes in `WmmaGemm::new_half_buffer`.
layout(set = 0, binding = 0, std430) readonly buffer ABuffer { f16vec2 a[]; };
layout(set = 0, binding = 1, std430) readonly buffer BBuffer { f16vec2 b[]; };
layout(set = 0, binding = 2, std430) writeonly buffer CBuffer { float c[]; };

layout(push_constant) uniform Push {
    uint m;
    uint n;
    uint k;
    uint lda;
    uint ldb;
    uint ldc;
    uint flags;
    uint reserved;
} pc;

// Two A tiles (rows [m0, m0+32)) and two B tiles (columns [n0, n0+32)) per
// 16-wide K slice. 16*16 halves each, so 1 KiB per pair.
shared float16_t a_tile[2][256];
shared float16_t b_tile[2][256];
// Reused staging for the f32 accumulator store; written and consumed one
// 16x16 tile at a time.
shared float c_tile[256];

void main() {
    uint lane = gl_SubgroupInvocationID;
    uint lanes = gl_SubgroupSize;
    uint m0 = gl_WorkGroupID.y * 32u;
    uint n0 = gl_WorkGroupID.x * 32u;
    bool trans_a = (pc.flags & 1u) != 0u;
    bool trans_b = (pc.flags & 2u) != 0u;
    // A pair may be fetched with one 32-bit load only when the pair base is
    // 4-byte aligned, i.e. when the leading dimension is even. The parity of an
    // individual pair base is then guaranteed (see the derivation above).
    bool wide_a = (pc.lda & 1u) == 0u;
    bool wide_b = (pc.ldb & 1u) == 0u;

    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> a_frag0;
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> a_frag1;
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> b_frag0;
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> b_frag1;

    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc00 =
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc01 =
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc10 =
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc11 =
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0);

    for (uint k0 = 0u; k0 < pc.k; k0 += 16u) {
        // Stage A. 512 halves per tile pair = 256 pairs; each lane takes 8.
        if (!trans_a) {
            // A row-major [m][k]: the reduction axis is contiguous, so a pair
            // covers two adjacent K positions of one output row.
            for (uint p = lane; p < 256u; p += lanes) {
                uint tile = p >> 7u;
                uint e = p & 127u;
                uint row = e >> 3u;
                uint col = (e & 7u) << 1u;
                uint gm = m0 + tile * 16u + row;
                uint gk = k0 + col;
                uint off = gm * pc.lda + gk;
                float16_t v0 = float16_t(0.0);
                float16_t v1 = float16_t(0.0);
                if (wide_a && gm < pc.m && gk + 1u < pc.k) {
                    f16vec2 pair = a[off >> 1u];
                    v0 = pair.x;
                    v1 = pair.y;
                } else {
                    if (gm < pc.m && gk < pc.k) {
                        v0 = a[off >> 1u][off & 1u];
                    }
                    if (gm < pc.m && gk + 1u < pc.k) {
                        uint next = off + 1u;
                        v1 = a[next >> 1u][next & 1u];
                    }
                }
                a_tile[tile][row * 16u + col] = v0;
                a_tile[tile][row * 16u + col + 1u] = v1;
            }
        } else {
            // A transposed [k][m]: the output axis is contiguous, so a pair
            // covers two adjacent output rows at one reduction position.
            for (uint p = lane; p < 256u; p += lanes) {
                uint tile = p >> 7u;
                uint e = p & 127u;
                uint row = (e >> 4u) << 1u;
                uint col = e & 15u;
                uint gm = m0 + tile * 16u + row;
                uint gk = k0 + col;
                uint off = gk * pc.lda + gm;
                float16_t v0 = float16_t(0.0);
                float16_t v1 = float16_t(0.0);
                if (wide_a && gk < pc.k && gm + 1u < pc.m) {
                    f16vec2 pair = a[off >> 1u];
                    v0 = pair.x;
                    v1 = pair.y;
                } else {
                    if (gk < pc.k && gm < pc.m) {
                        v0 = a[off >> 1u][off & 1u];
                    }
                    if (gk < pc.k && gm + 1u < pc.m) {
                        uint next = off + 1u;
                        v1 = a[next >> 1u][next & 1u];
                    }
                }
                a_tile[tile][row * 16u + col] = v0;
                a_tile[tile][row * 16u + col + 16u] = v1;
            }
        }

        // Stage B. 512 halves per tile pair = 256 pairs; each lane takes 8.
        if (!trans_b) {
            // B row-major [k][n]: the output axis is contiguous, so a pair
            // covers two adjacent output columns at one reduction position.
            for (uint p = lane; p < 256u; p += lanes) {
                uint tile = p >> 7u;
                uint e = p & 127u;
                uint row = e >> 3u;
                uint col = (e & 7u) << 1u;
                uint gk = k0 + row;
                uint gn = n0 + tile * 16u + col;
                uint off = gk * pc.ldb + gn;
                float16_t v0 = float16_t(0.0);
                float16_t v1 = float16_t(0.0);
                if (wide_b && gk < pc.k && gn + 1u < pc.n) {
                    f16vec2 pair = b[off >> 1u];
                    v0 = pair.x;
                    v1 = pair.y;
                } else {
                    if (gk < pc.k && gn < pc.n) {
                        v0 = b[off >> 1u][off & 1u];
                    }
                    if (gk < pc.k && gn + 1u < pc.n) {
                        uint next = off + 1u;
                        v1 = b[next >> 1u][next & 1u];
                    }
                }
                b_tile[tile][row * 16u + col] = v0;
                b_tile[tile][row * 16u + col + 1u] = v1;
            }
        } else {
            // B transposed [n][k]: the reduction axis is contiguous, so a pair
            // covers two adjacent K positions of one output column.
            for (uint p = lane; p < 256u; p += lanes) {
                uint tile = p >> 7u;
                uint e = p & 127u;
                uint row = (e >> 4u) << 1u;
                uint col = e & 15u;
                uint gk = k0 + row;
                uint gn = n0 + tile * 16u + col;
                uint off = gn * pc.ldb + gk;
                float16_t v0 = float16_t(0.0);
                float16_t v1 = float16_t(0.0);
                if (wide_b && gn < pc.n && gk + 1u < pc.k) {
                    f16vec2 pair = b[off >> 1u];
                    v0 = pair.x;
                    v1 = pair.y;
                } else {
                    if (gn < pc.n && gk < pc.k) {
                        v0 = b[off >> 1u][off & 1u];
                    }
                    if (gn < pc.n && gk + 1u < pc.k) {
                        uint next = off + 1u;
                        v1 = b[next >> 1u][next & 1u];
                    }
                }
                b_tile[tile][row * 16u + col] = v0;
                b_tile[tile][row * 16u + col + 16u] = v1;
            }
        }
        barrier();

        coopMatLoad(a_frag0, a_tile[0], 0, 16, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(a_frag1, a_tile[1], 0, 16, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(b_frag0, b_tile[0], 0, 16, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(b_frag1, b_tile[1], 0, 16, gl_CooperativeMatrixLayoutRowMajor);

        acc00 = coopMatMulAdd(a_frag0, b_frag0, acc00);
        acc01 = coopMatMulAdd(a_frag0, b_frag1, acc01);
        acc10 = coopMatMulAdd(a_frag1, b_frag0, acc10);
        acc11 = coopMatMulAdd(a_frag1, b_frag1, acc11);
        barrier();
    }

    // Tile 0: rows [m0, m0+16), columns [n0, n0+16).
    coopMatStore(acc00, c_tile, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    for (uint e = lane; e < 256u; e += lanes) {
        uint gm = m0 + (e >> 4u);
        uint gn = n0 + (e & 15u);
        if (gm < pc.m && gn < pc.n) c[gm * pc.ldc + gn] = c_tile[e];
    }
    barrier();

    // Tile 1: rows [m0, m0+16), columns [n0+16, n0+32).
    coopMatStore(acc01, c_tile, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    for (uint e = lane; e < 256u; e += lanes) {
        uint gm = m0 + (e >> 4u);
        uint gn = n0 + 16u + (e & 15u);
        if (gm < pc.m && gn < pc.n) c[gm * pc.ldc + gn] = c_tile[e];
    }
    barrier();

    // Tile 2: rows [m0+16, m0+32), columns [n0, n0+16).
    coopMatStore(acc10, c_tile, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    for (uint e = lane; e < 256u; e += lanes) {
        uint gm = m0 + 16u + (e >> 4u);
        uint gn = n0 + (e & 15u);
        if (gm < pc.m && gn < pc.n) c[gm * pc.ldc + gn] = c_tile[e];
    }
    barrier();

    // Tile 3: rows [m0+16, m0+32), columns [n0+16, n0+32).
    coopMatStore(acc11, c_tile, 0, 16, gl_CooperativeMatrixLayoutRowMajor);
    barrier();
    for (uint e = lane; e < 256u; e += lanes) {
        uint gm = m0 + 16u + (e >> 4u);
        uint gn = n0 + 16u + (e & 15u);
        if (gm < pc.m && gn < pc.n) c[gm * pc.ldc + gn] = c_tile[e];
    }
    barrier();
}
