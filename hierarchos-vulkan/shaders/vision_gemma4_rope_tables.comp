#version 450
#extension GL_GOOGLE_include_directive : require
#include "fp32_sleef_trig.glsl"
// Build immutable axial RoPE tables from package geometry on the device.
// Rotation and its adjoint consume these same FP32 values.
layout(local_size_x=256) in;
layout(set=0,binding=0,std430) readonly buffer Positions {uint positions[];};
layout(set=0,binding=1,std430) readonly buffer Frequencies {float inv_freq[];};
layout(set=0,binding=2,std430) writeonly buffer Cos {float cos_values[];};
layout(set=0,binding=3,std430) writeonly buffer Sin {float sin_values[];};
layout(push_constant) uniform P {uint rows;uint head_dim;} pc;
void main(){
    uint i=gl_GlobalInvocationID.x;if(i>=pc.rows*pc.head_dim)return;
    uint row=i/pc.head_dim,col=i%pc.head_dim,quarter=pc.head_dim/4u;
    uint axis=col/(pc.head_dim/2u),frequency=col%quarter;
    float angle=float(positions[row*2u+axis])*inv_freq[frequency];
    cos_values[i]=fp32_cos(angle);sin_values[i]=fp32_sin(angle);
}
