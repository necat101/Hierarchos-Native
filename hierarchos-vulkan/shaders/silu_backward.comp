#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer GradOutputBuffer { float grad_output[]; };
layout(set = 0, binding = 1, std430) readonly buffer InputBuffer { float x[]; };
layout(set = 0, binding = 2, std430) writeonly buffer GradInputBuffer { float grad_input[]; };

layout(push_constant) uniform Push {
    uint len;
} pc;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pc.len) {
        return;
    }
    float value = x[index];
    float sigmoid_value = 1.0 / (1.0 + exp(-value));
    float derivative = sigmoid_value * (1.0 + value * (1.0 - sigmoid_value));
    grad_input[index] = grad_output[index] * derivative;
}
