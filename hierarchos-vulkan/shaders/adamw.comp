#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer ParameterBuffer { float parameter[]; };
layout(set = 0, binding = 1, std430) readonly buffer GradientBuffer { float gradient[]; };
layout(set = 0, binding = 2, std430) buffer ExpAvgBuffer { float exp_avg[]; };
layout(set = 0, binding = 3, std430) buffer ExpAvgSqBuffer { float exp_avg_sq[]; };

layout(push_constant) uniform Push {
    uint len;
    uint step;
    float lr;
    float beta1;
    float beta2;
    float eps;
    float weight_decay;
} pc;

shared vec2 workgroup_bias_correction;

void main() {
    // Bias corrections depend only on the optimizer step. Evaluate the two
    // powers once per workgroup rather than once per parameter. Keep division
    // by these rounded values in the update to preserve its FP32 arithmetic.
    if (gl_LocalInvocationID.x == 0u) {
        workgroup_bias_correction = vec2(
            1.0 - pow(pc.beta1, float(pc.step)),
            1.0 - pow(pc.beta2, float(pc.step)));
    }
    barrier();
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.len) {
        return;
    }
    float g = gradient[i];
    float m = pc.beta1 * exp_avg[i] + (1.0 - pc.beta1) * g;
    float v = pc.beta2 * exp_avg_sq[i] + (1.0 - pc.beta2) * g * g;
    exp_avg[i] = m;
    exp_avg_sq[i] = v;

    float bias_correction1 = workgroup_bias_correction.x;
    float bias_correction2 = workgroup_bias_correction.y;
    float denom = sqrt(v / bias_correction2) + pc.eps;
#ifdef HIERARCHOS_UNFUSED_ADAMW
    // PyTorch's non-fused AdamW materializes param.mul_(1-lr*decay)
    // before addcdiv_. Preserve that FP32 rounding boundary for Falcon.
    precise float decayed = parameter[i] * (1.0 - pc.lr * pc.weight_decay);
    precise float updated = decayed - pc.lr * (m / bias_correction1) / denom;
    parameter[i] = updated;
#else
    float decayed = parameter[i] * (1.0 - pc.lr * pc.weight_decay);
    parameter[i] = decayed - pc.lr * (m / bias_correction1) / denom;
#endif
}
