#version 450

// Batch up to eight independent scratch-gradient accumulations into one compact
// 1D dispatch. Workgroups are linearized by each tensor's own required group
// count, avoiding the wasted rectangular occupancy of a 2D max-length launch.
//
// This extends gradient_accumulate4, which covers exactly four tensors and leaves
// every call site a remainder of one dispatch per leftover tensor: a call site
// with 33 tensors costs eight four-wide dispatches plus a one-tensor tail. Here
// the host pads an incomplete group with zero lengths, so len_i == 0 makes slot i
// inert (it contributes no groups and its index test never passes) and a partial
// group costs one dispatch instead of one per remaining tensor.
//
// The arithmetic per parameter is unchanged, which is what keeps the accumulated
// gradients bit-identical: slot i still visits index = group * 256 + lane for
// group in [0, ceil(len_i / 256)) and adds in that same order. Only the packing of
// independent accumulators into dispatches changes.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer Accum0Buffer { float accum0[]; };
layout(set = 0, binding = 1, std430) readonly buffer Grad0Buffer { float grad0[]; };
layout(set = 0, binding = 2, std430) buffer Accum1Buffer { float accum1[]; };
layout(set = 0, binding = 3, std430) readonly buffer Grad1Buffer { float grad1[]; };
layout(set = 0, binding = 4, std430) buffer Accum2Buffer { float accum2[]; };
layout(set = 0, binding = 5, std430) readonly buffer Grad2Buffer { float grad2[]; };
layout(set = 0, binding = 6, std430) buffer Accum3Buffer { float accum3[]; };
layout(set = 0, binding = 7, std430) readonly buffer Grad3Buffer { float grad3[]; };
layout(set = 0, binding = 8, std430) buffer Accum4Buffer { float accum4[]; };
layout(set = 0, binding = 9, std430) readonly buffer Grad4Buffer { float grad4[]; };
layout(set = 0, binding = 10, std430) buffer Accum5Buffer { float accum5[]; };
layout(set = 0, binding = 11, std430) readonly buffer Grad5Buffer { float grad5[]; };
layout(set = 0, binding = 12, std430) buffer Accum6Buffer { float accum6[]; };
layout(set = 0, binding = 13, std430) readonly buffer Grad6Buffer { float grad6[]; };
layout(set = 0, binding = 14, std430) buffer Accum7Buffer { float accum7[]; };
layout(set = 0, binding = 15, std430) readonly buffer Grad7Buffer { float grad7[]; };

layout(push_constant) uniform Push {
    uint len0;
    uint len1;
    uint len2;
    uint len3;
    uint len4;
    uint len5;
    uint len6;
    uint len7;
} pc;

void main() {
    uint group = gl_WorkGroupID.x;
    uint groups0 = (pc.len0 + 255u) / 256u;
    uint groups1 = (pc.len1 + 255u) / 256u;
    uint groups2 = (pc.len2 + 255u) / 256u;
    uint groups3 = (pc.len3 + 255u) / 256u;
    uint groups4 = (pc.len4 + 255u) / 256u;
    uint groups5 = (pc.len5 + 255u) / 256u;
    uint groups6 = (pc.len6 + 255u) / 256u;
    uint lane = gl_LocalInvocationID.x;

    if (group < groups0) {
        uint index = group * 256u + lane;
        if (index < pc.len0) accum0[index] += grad0[index];
        return;
    }
    group -= groups0;
    if (group < groups1) {
        uint index = group * 256u + lane;
        if (index < pc.len1) accum1[index] += grad1[index];
        return;
    }
    group -= groups1;
    if (group < groups2) {
        uint index = group * 256u + lane;
        if (index < pc.len2) accum2[index] += grad2[index];
        return;
    }
    group -= groups2;
    if (group < groups3) {
        uint index = group * 256u + lane;
        if (index < pc.len3) accum3[index] += grad3[index];
        return;
    }
    group -= groups3;
    if (group < groups4) {
        uint index = group * 256u + lane;
        if (index < pc.len4) accum4[index] += grad4[index];
        return;
    }
    group -= groups4;
    if (group < groups5) {
        uint index = group * 256u + lane;
        if (index < pc.len5) accum5[index] += grad5[index];
        return;
    }
    group -= groups5;
    if (group < groups6) {
        uint index = group * 256u + lane;
        if (index < pc.len6) accum6[index] += grad6[index];
        return;
    }
    group -= groups6;
    // The host sizes the grid to the active slots' group counts, so a group that
    // reaches here belongs to slot 7. When slot 7 is padding, len7 is zero and the
    // index test below writes nothing.
    uint index = group * 256u + lane;
    if (index < pc.len7) {
        accum7[index] += grad7[index];
    }
}
