#version 450

// V4.1 MoE combine. Matches MoE.forward's accumulation order within a token:
// routed expert outputs in ascending expert-id order, then the shared expert.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Routed { float routed[]; };
layout(set = 0, binding = 1, std430) readonly buffer SharedOutput { float shared_out[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Output { float output_values[]; };
layout(set = 0, binding = 3, std430) readonly buffer Indices { uint indices[]; };
layout(push_constant) uniform Push {
    uint rows;
    uint dim;
    uint topk;
} pc;

void main() {
    uint column = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;
    if (column >= pc.dim || row >= pc.rows) return;
    precise float sum = 0.0;
    uint previous = 0u;
    for (uint pass = 0u; pass < pc.topk; ++pass) {
        uint best_id = 0xffffffffu, best_slot = 0u;
        for (uint slot = 0u; slot < pc.topk; ++slot) {
            uint expert = indices[row * pc.topk + slot];
            if ((pass == 0u || expert > previous) && expert < best_id) {
                best_id = expert;
                best_slot = slot;
            }
        }
        sum += routed[(row * pc.topk + best_slot) * pc.dim + column];
        previous = best_id;
    }
    output_values[row * pc.dim + column] = sum + shared_out[row * pc.dim + column];
}
