#version 450

// Rows routed to each expert.
//
// The routed-MoE routers write dense routing weights with exact zeros for the
// experts a row did not select (see `transformer_moe_router_topk.comp`), so the
// number of tokens a reference expert call receives is the number of non-zero
// entries in that expert's column. The value is data dependent and the expert
// dispatch grid is fixed when the graph is recorded, so it is computed on the
// GPU once per MoE layer and read by the expert projection modules, which pick
// their accumulation topology from it.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer WeightsBuffer { float weights[]; };
layout(set = 0, binding = 1, std430) writeonly buffer CountBuffer { uint counts[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint experts;
} pc;

void main() {
    uint expert = gl_GlobalInvocationID.x;
    if (expert >= pc.experts) {
        return;
    }
    uint count = 0u;
    for (uint row = 0u; row < pc.rows; ++row) {
        if (weights[row * pc.experts + expert] != 0.0) {
            ++count;
        }
    }
    counts[expert] = count;
}
