#version 450
#extension GL_GOOGLE_include_directive : require
#include "fp32_fma_exact.glsl"
#include "fp32_sqrt_recip.glsl"
#include "fp32_sleef_exp.glsl"

// Two-pass scaled-dot-product attention backward, pass 1: query-owned.
//
// The generic kernel launches one invocation per (batch, KV head) with a single
// lane, so only a few dozen single-thread workgroups run at once. This pass gives
// one lane to each (batch, query head, query position) row instead, and keeps the
// row's key loop exactly as the generic kernel runs it.
//
// dQ is row-owned and is computed here. dK and dV reduce over queries, which no
// single row owns, so this pass writes the two per-element values pass 2 needs to
// scratch: the normalised probability and the adjoint's dS.
//
// Two arithmetic modes are reproduced, both from the generic kernel's own text:
//
//   unfused_qk == 0  hardware fma for QK and P@V, hardware exp, plain reciprocal.
//   unfused_qk == 9  separately materialised products under `precise`, the SLEEF
//                    u10 exp, and the correctly rounded FP32 divide.
//
// Mode 9 keeps TWO softmax-dot values, and they are not interchangeable: the
// primary loop accumulates a plain `softmax_dot` that dQ uses, while the per-key
// adjoint accumulates a `precise` `kv_softmax_dot` that dK and dV use. This pass
// computes both and writes the derivative built from the second one.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

// Only geometries with a head dimension up to this bound are admitted, which
// keeps the dQ accumulator a fixed-size private array.
const uint MAX_HEAD_DIM = 128u;

layout(set = 0, binding = 0, std430) readonly buffer QBuffer { float q_values[]; };
layout(set = 0, binding = 1, std430) readonly buffer KBuffer { float k_values[]; };
layout(set = 0, binding = 2, std430) readonly buffer VBuffer { float v_values[]; };
layout(set = 0, binding = 3, std430) readonly buffer QueryMaskBuffer { float query_mask[]; };
layout(set = 0, binding = 4, std430) readonly buffer KeyMaskBuffer { float key_mask[]; };
layout(set = 0, binding = 5, std430) readonly buffer GradOutputBuffer { float grad_output[]; };
layout(set = 0, binding = 6, std430) buffer GradQBuffer { float grad_q[]; };
layout(set = 0, binding = 7, std430) buffer ProbabilityBuffer { float scratch_probability[]; };
layout(set = 0, binding = 8, std430) buffer DsBuffer { float scratch_ds[]; };

layout(push_constant) uniform Push {
    uint batch_size;
    uint query_seq_len;
    uint key_value_seq_len;
    uint query_hidden_size;
    uint value_hidden_size;
    uint num_heads;
    uint num_key_value_heads;
    uint window_size;
    float scale;
    float value_scale;
    float softcap;
    uint alibi_mode;
    float alibi_bias_max;
    float dropout_p;
    uint rng_step;
    uint rng_site;
    uint rng_seed;
    uint has_sink;
    uint causal;
    uint relative_bias_mode;
    uint relative_bias_num_buckets;
    uint relative_bias_max_distance;
    uint query_position_offset;
    uint has_sparse_mask;
    uint compressed_key_count;
    uint compressed_key_rate;
    uint paged_kv;
    uint kv_page_size;
    uint kv_page_table_stride;
    uint unfused_qk;
} pc;

uint qk_head_dim;
uint key_hidden_size;
uint value_head_dim;
uint output_hidden_size;

// Mode 9 QK: the generic kernel materialises each product under `precise`
// before adding it, so no fma contraction is allowed here either.
precise float mode9_score(uint q_base, uint k_base) {
    precise float value = 0.0;
    for (uint d = 0; d < qk_head_dim; ++d) {
        precise float product = q_values[q_base + d] * k_values[k_base + d];
        value += product;
    }
    return value * pc.scale;
}

float plain_score(uint q_base, uint k_base) {
    float value = 0.0;
    for (uint d = 0; d < qk_head_dim; ++d) {
        value = fma(q_values[q_base + d], k_values[k_base + d], value);
    }
    return value * pc.scale;
}

float score(uint q_base, uint k_base) {
    return pc.unfused_qk == 9u ? mode9_score(q_base, k_base)
                               : plain_score(q_base, k_base);
}

// Mode 9 value projection of the backward pass: same materialised products.
precise float mode9_value_dot(uint v_base, uint grad_out_base) {
    precise float value = 0.0;
    for (uint d = 0; d < value_head_dim; ++d) {
        precise float scaled_value = v_values[v_base + d] * pc.value_scale;
        precise float product = grad_output[grad_out_base + d] * scaled_value;
        value += product;
    }
    return value;
}

float plain_value_dot(uint v_base, uint grad_out_base) {
    float value = 0.0;
    for (uint d = 0; d < value_head_dim; ++d) {
        value = fma(grad_output[grad_out_base + d], v_values[v_base + d] * pc.value_scale, value);
    }
    return value;
}

float value_dot(uint v_base, uint grad_out_base) {
    return pc.unfused_qk == 9u ? mode9_value_dot(v_base, grad_out_base)
                               : plain_value_dot(v_base, grad_out_base);
}

// The generic kernel's attention_exp: SLEEF u10 for mode 9, hardware exp
// otherwise. causal == 2 is never admitted by the host, so its SLEEF arm is not
// reachable here.
float attention_exp(float value) {
    return pc.unfused_qk == 9u ? sleef_expf_u10_fused(value) : exp(value);
}

// The generic kernel's attention_reciprocal for the admitted modes.
float attention_reciprocal(float value) {
    return pc.unfused_qk == 9u ? fp32_div(1.0, value) : (1.0 / value);
}

bool key_visible(uint b, uint key) {
    return key_mask[b * pc.key_value_seq_len + key] > 0.0;
}

void main() {
    uint rows = pc.batch_size * pc.num_heads * pc.query_seq_len;
    uint row = gl_GlobalInvocationID.x;
    if (row >= rows) return;

    qk_head_dim = pc.query_hidden_size / pc.num_heads;
    value_head_dim = pc.value_hidden_size / pc.num_key_value_heads;
    if (qk_head_dim > MAX_HEAD_DIM || value_head_dim > MAX_HEAD_DIM) return;

    key_hidden_size = qk_head_dim * pc.num_key_value_heads;
    output_hidden_size = value_head_dim * pc.num_heads;
    uint queries_per_kv = pc.num_heads / pc.num_key_value_heads;

    uint query = row % pc.query_seq_len;
    uint rest = row / pc.query_seq_len;
    uint head = rest % pc.num_heads;
    uint b = rest / pc.num_heads;
    uint kv_head = head / queries_per_kv;

    uint query_row = b * pc.query_seq_len + query;
    uint q_base = query_row * pc.query_hidden_size + head * qk_head_dim;
    uint grad_out_base = query_row * output_hidden_size + head * value_head_dim;
    uint scratch_base = (b * pc.num_heads + head) * pc.query_seq_len * pc.key_value_seq_len
        + query * pc.key_value_seq_len;

    // The generic kernel owns the whole row and zeroes it before accumulating,
    // including the rows it subsequently skips.
    for (uint d = 0; d < qk_head_dim; ++d) {
        grad_q[q_base + d] = 0.0;
    }

    uint last_key = pc.key_value_seq_len - 1u;
    if (pc.causal != 0u) {
        uint absolute_query = pc.query_position_offset + query;
        last_key = min(absolute_query, pc.key_value_seq_len - 1u);
    }

    if (query_mask[query_row] <= 0.0) {
        // A row with no visible key contributes nothing: the generic kernel
        // leaves its dQ zeroed, stores no statistics, and its adjoint skips it.
        // The scratch is cleared so pass 2 adds exact zeros rather than a
        // previous step's values.
        for (uint key = 0u; key <= last_key; ++key) {
            uint slot = scratch_base + key;
            scratch_probability[slot] = 0.0;
            scratch_ds[slot] = 0.0;
        }
        return;
    }

    bool any_visible = false;
    for (uint key = 0u; key <= last_key; ++key) {
        if (key_visible(b, key)) { any_visible = true; break; }
    }
    if (!any_visible) {
        for (uint key = 0u; key <= last_key; ++key) {
            uint slot = scratch_base + key;
            scratch_probability[slot] = 0.0;
            scratch_ds[slot] = 0.0;
        }
        return;
    }

    // Row maximum, over the same visible keys and in the same order.
    bool found = false;
    float max_score = -3.402823466e+38;
    for (uint key = 0u; key <= last_key; ++key) {
        if (!key_visible(b, key)) continue;
        float s = score(q_base, (b * pc.key_value_seq_len + key) * key_hidden_size
            + kv_head * qk_head_dim);
        max_score = found ? max(max_score, s) : s;
        found = true;
    }

    // The normaliser. Mode 9 accumulates the exponentials under `precise`, as the
    // generic kernel does; the plain path does not.
    float exp_sum = 0.0;
    if (pc.unfused_qk == 9u) {
        precise float precise_exp_sum = 0.0;
        for (uint key = 0u; key <= last_key; ++key) {
            if (!key_visible(b, key)) continue;
            float s = score(q_base, (b * pc.key_value_seq_len + key) * key_hidden_size
                + kv_head * qk_head_dim);
            precise_exp_sum += attention_exp(s - max_score);
        }
        exp_sum = precise_exp_sum;
    } else {
        for (uint key = 0u; key <= last_key; ++key) {
            if (!key_visible(b, key)) continue;
            float s = score(q_base, (b * pc.key_value_seq_len + key) * key_hidden_size
                + kv_head * qk_head_dim);
            exp_sum += attention_exp(s - max_score);
        }
    }
    float inv_sum = attention_reciprocal(exp_sum);

    // Two dots, deliberately not merged:
    //   plain  softmax_dot    -> dQ, exactly as the primary loop sums it
    //   precise kv_softmax_dot -> dK and dV, exactly as the per-key adjoint sums it
    float softmax_dot = 0.0;
    precise float kv_softmax_dot = 0.0;
    for (uint key = 0u; key <= last_key; ++key) {
        if (!key_visible(b, key)) continue;
        uint k_base = (b * pc.key_value_seq_len + key) * key_hidden_size
            + kv_head * qk_head_dim;
        uint v_base = (b * pc.key_value_seq_len + key) * pc.value_hidden_size
            + kv_head * value_head_dim;
        float p = attention_exp(score(q_base, k_base) - max_score) * inv_sum;
        float dp = value_dot(v_base, grad_out_base);
        softmax_dot += p * dp;
        precise float weighted_dp = p * dp;
        kv_softmax_dot += weighted_dp;
    }

    float dq[MAX_HEAD_DIM];
    for (uint d = 0; d < qk_head_dim; ++d) {
        dq[d] = 0.0;
    }

    for (uint key = 0u; key <= last_key; ++key) {
        if (!key_visible(b, key)) continue;
        uint k_base = (b * pc.key_value_seq_len + key) * key_hidden_size
            + kv_head * qk_head_dim;
        uint v_base = (b * pc.key_value_seq_len + key) * pc.value_hidden_size
            + kv_head * value_head_dim;
        float s = score(q_base, k_base);
        float p = attention_exp(s - max_score) * inv_sum;
        float dp = value_dot(v_base, grad_out_base);
        float ds_q = p * (dp - softmax_dot);
        uint slot = scratch_base + key;
        scratch_probability[slot] = p;
        scratch_ds[slot] = p * (dp - kv_softmax_dot);
        if (pc.unfused_qk == 9u) {
            precise float score_scale = pc.scale * 1.0;
            score_scale = score_scale * ds_q;
            for (uint d = 0; d < qk_head_dim; ++d) {
                precise float contribution = score_scale * k_values[k_base + d];
                dq[d] += contribution;
            }
        } else {
            for (uint d = 0; d < qk_head_dim; ++d) {
                dq[d] += pc.scale * ds_q * k_values[k_base + d];
            }
        }
    }

    for (uint d = 0; d < qk_head_dim; ++d) {
        grad_q[q_base + d] = dq[d];
    }
}
