#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer { float input_values[]; };
layout(set = 0, binding = 1, std430) readonly buffer GradOutputBuffer { float grad_output[]; };
layout(set = 0, binding = 2, std430) writeonly buffer GradInputBuffer { float grad_input[]; };

layout(push_constant) uniform Push {
    uint len;
} pc;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pc.len) return;
    float input_value = input_values[index];
    grad_input[index] = input_value > 0.0 ? 2.0 * input_value * grad_output[index] : 0.0;
}
