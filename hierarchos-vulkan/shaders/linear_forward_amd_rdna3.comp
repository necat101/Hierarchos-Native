#version 450

// AMD RDNA3 (gfx11) variant of linear_forward.
//
// Contract preserved from the portable kernel:
//   * one invocation owns exactly one (row, out_col) output element
//   * the accumulation chain is the same ascending-k sequence of fma() calls
//     with the same operands, so the FP32 result is bit-identical
//   * the host grid is the same 16x16 element tile, so no call site changes
//
// Schedule: RDNA3 parts carry 64 KiB of LDS, twice the Gen9 budget, and execute
// in wave64. This variant therefore stages a 64-wide K slice instead of the
// portable module's 32-wide one: each of the 16 lanes loads four k values, so a
// 64-wide slice is still filled in one coalesced pass, and the workgroup pays
// two barriers per 64 k instead of two per 32 k. Both tiles keep the portable
// padding (65-float input rows, 17-float weight rows) so the consumers read
// them without a shared-memory bank conflict on a 32-bank LDS.
//
// Small shapes never reach this module: the host-side gate keeps rows < 8,
// input_dim < 64 or output_dim < 16 on the portable module, which is where the
// portable schedule itself falls back to its scalar path. The schedule below is
// nonetheless correct for any geometry, because every load and store is guarded
// and the tail slice is bounded by `min`.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer { float x[]; };
layout(set = 0, binding = 1, std430) readonly buffer WeightBuffer { float weight[]; };
layout(set = 0, binding = 2, std430) writeonly buffer OutputBuffer { float output_values[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint input_dim;
    uint output_dim;
} pc;

const uint INPUT_TILE = 64u;
shared float input_tile[16u * 65u];
shared float weight_tile[INPUT_TILE * 17u];

void main() {
    uint local_x = gl_LocalInvocationID.x;
    uint local_y = gl_LocalInvocationID.y;
    uint out_col = gl_WorkGroupID.x * 16u + local_x;
    uint row = gl_WorkGroupID.y * 16u + local_y;
    bool lane_valid = row < pc.rows && out_col < pc.output_dim;
    float sum = 0.0;

    for (uint k_base = 0u; k_base < pc.input_dim; k_base += INPUT_TILE) {
        // Four k values per lane: a 64-wide slice is loaded by the 16 lanes of
        // the workgroup in one coalesced pass.
        uint load_k = k_base + local_x * 4u;
        uint input_slot = local_y * 65u + local_x * 4u;
        for (uint j = 0u; j < 4u; ++j) {
            input_tile[input_slot + j] =
                row < pc.rows && load_k + j < pc.input_dim
                    ? x[row * pc.input_dim + load_k + j] : 0.0;
        }

        // Load each weight row contiguously, then transpose into padded shared
        // memory so the consumers read adjacent output columns.
        uint weight_col = gl_WorkGroupID.x * 16u + local_y;
        uint weight_slot = local_x * 4u * 17u + local_y;
        for (uint j = 0u; j < 4u; ++j) {
            weight_tile[weight_slot + j * 17u] =
                weight_col < pc.output_dim && load_k + j < pc.input_dim
                    ? weight[weight_col * pc.input_dim + load_k + j] : 0.0;
        }

        // Padded/masked lanes participate in both barriers; they must never
        // return before the rest of the workgroup has consumed the shared tile.
        barrier();
        if (lane_valid) {
            uint count = min(INPUT_TILE, pc.input_dim - k_base);
            for (uint k = 0u; k < count; ++k) {
                sum = fma(input_tile[local_y * 65u + k],
                          weight_tile[k * 17u + local_x], sum);
            }
        }
        barrier();
    }

    if (lane_valid) {
        uint output_index = row * pc.output_dim + out_col;
        output_values[output_index] = sum;
    }
}
