#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer { float x[]; };
layout(set = 0, binding = 1, std430) readonly buffer WeightBuffer { uint weight_packed[]; };
layout(set = 0, binding = 2, std430) readonly buffer BiasBuffer { float bias[]; };
layout(set = 0, binding = 3, std430) writeonly buffer OutputBuffer { float output_values[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint input_dim;
    uint output_dim;
} pc;

vec2 load_weight_pair(uint first_index, bool second_active) {
    vec2 current = unpackHalf2x16(weight_packed[first_index >> 1u]);
    if ((first_index & 1u) == 0u) {
        return second_active ? current : vec2(current.x, 0.0);
    }
    if (!second_active) {
        return vec2(current.y, 0.0);
    }
    vec2 next = unpackHalf2x16(weight_packed[(first_index >> 1u) + 1u]);
    return vec2(current.y, next.x);
}

void main() {
    uint out_col = gl_GlobalInvocationID.x * 2u;
    uint row = gl_GlobalInvocationID.y;
    if (row >= pc.rows || out_col >= pc.output_dim) {
        return;
    }

    bool second_active = out_col + 1u < pc.output_dim;
    vec2 sum = vec2(0.0);
    uint x_base = row * pc.input_dim;
    for (uint in_col = 0u; in_col < pc.input_dim; ++in_col) {
        float input_value = x[x_base + in_col];
        vec2 weights = load_weight_pair(
            in_col * pc.output_dim + out_col,
            second_active
        );
        sum.x = fma(input_value, weights.x, sum.x);
        if (second_active) {
            sum.y = fma(input_value, weights.y, sum.y);
        }
    }
    uint output_index = row * pc.output_dim + out_col;
    output_values[output_index] = sum.x + bias[out_col];
    if (second_active) {
        output_values[output_index + 1u] = sum.y + bias[out_col + 1u];
    }
}
