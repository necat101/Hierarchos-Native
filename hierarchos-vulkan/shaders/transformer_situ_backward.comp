#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer GradOutputBuffer { float grad_output[]; };
layout(set = 0, binding = 1, std430) readonly buffer GateBuffer { float gate_values[]; };
layout(set = 0, binding = 2, std430) readonly buffer UpBuffer { float up_values[]; };
layout(set = 0, binding = 3, std430) writeonly buffer GradGateBuffer { float grad_gate[]; };
layout(set = 0, binding = 4, std430) writeonly buffer GradUpBuffer { float grad_up[]; };

layout(push_constant) uniform Push {
    uint len;
    float beta;
    float linear_beta;
    uint use_linear_beta;
} pc;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pc.len) return;

    float gate = gate_values[index];
    float up = up_values[index];
    float grad = grad_output[index];

    float gate_tanh = tanh(gate / pc.beta);
    float sigmoid_gate = 1.0 / (1.0 + exp(-gate));
    float situ_gate = pc.beta * gate_tanh * sigmoid_gate;
    float d_gate_tanh = 1.0 - gate_tanh * gate_tanh;
    float d_situ_gate = d_gate_tanh * sigmoid_gate
        + pc.beta * gate_tanh * sigmoid_gate * (1.0 - sigmoid_gate);

    float situ_up = up;
    float d_situ_up = 1.0;
    if (pc.use_linear_beta != 0u) {
        float up_tanh = tanh(up / pc.linear_beta);
        situ_up = pc.linear_beta * up_tanh;
        d_situ_up = 1.0 - up_tanh * up_tanh;
    }

    grad_gate[index] = grad * situ_up * d_situ_gate;
    grad_up[index] = grad * situ_gate * d_situ_up;
}
