#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer CandidateDriftBuffer { float candidate_drift[]; };
layout(set = 0, binding = 1, std430) readonly buffer ActiveBuffer { float active_rows[]; };
layout(set = 0, binding = 2, std430) readonly buffer CostCountBuffer { float cost_count[]; };
layout(set = 0, binding = 3, std430) readonly buffer GradCostBuffer { float grad_cost[]; };
layout(set = 0, binding = 4, std430) writeonly buffer GradDriftBuffer { float grad_drift[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint dim;
    uint mean_square;
    float threshold;
    float source_scale;
} pc;

void main() {
    uint index = gl_GlobalInvocationID.x;
    uint len = pc.rows * pc.dim;
    if (index >= len) {
        return;
    }
    uint row = index / pc.dim;
    if (active_rows[row] <= 0.0 || cost_count[row] < 1.0) {
        grad_drift[index] = 0.0;
        return;
    }

    uint base = row * pc.dim;
    float energy = 0.0;
    for (uint col = 0u; col < pc.dim; ++col) {
        float value = candidate_drift[base + col];
        energy += value * value;
    }
    float derivative_scale = 2.0;
    if (pc.mean_square != 0u) {
        energy /= float(pc.dim);
        derivative_scale /= float(pc.dim);
    }
    float raw_hinge = energy - pc.threshold;
    // PyTorch computes relu(raw_hinge) followed by clamp(max=100). ReLU has
    // zero derivative at exactly zero, while torch.clamp keeps derivative one
    // at the inclusive +100 boundary and zeros it only strictly above 100.
    if (raw_hinge <= 0.0 || raw_hinge > 100.0) {
        grad_drift[index] = 0.0;
        return;
    }
    grad_drift[index] = grad_cost[row] * pc.source_scale
        * derivative_scale
        * candidate_drift[index]
        / max(cost_count[row], 1.0);
}
