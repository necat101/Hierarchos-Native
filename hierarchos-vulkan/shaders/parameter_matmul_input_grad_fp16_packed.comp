#version 450

#ifndef HIERARCHOS_NATIVE_FP16_BACKWARD_COMPUTE
#define HIERARCHOS_NATIVE_FP16_BACKWARD_COMPUTE 0
#endif

#if HIERARCHOS_NATIVE_FP16_BACKWARD_COMPUTE
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#endif

// The bandwidth-heavy weight read used to propagate input adjoints comes from
// the compact FP16 execution mirror. The native-compute specialization also
// rounds each incoming adjoint to FP16 and evaluates the multiply in Float16,
// then widens the product into the existing FP32 reduction/destination.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer GradOutputBuffer { float grad_output[]; };
layout(set = 0, binding = 1, std430) readonly buffer WeightBuffer { uint weight_packed[]; };
layout(set = 0, binding = 2, std430) writeonly buffer GradInputBuffer { float grad_input[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint input_dim;
    uint output_dim;
} pc;

vec2 load_weight_pair(uint first_index, bool second_active) {
    vec2 current = unpackHalf2x16(weight_packed[first_index >> 1u]);
    if ((first_index & 1u) == 0u) {
        return second_active ? current : vec2(current.x, 0.0);
    }
    if (!second_active) {
        return vec2(current.y, 0.0);
    }
    vec2 next = unpackHalf2x16(weight_packed[(first_index >> 1u) + 1u]);
    return vec2(current.y, next.x);
}

float accumulate_backward_product(float sum, float grad, float weight) {
#if HIERARCHOS_NATIVE_FP16_BACKWARD_COMPUTE
    return sum + float(float16_t(grad) * float16_t(weight));
#else
    return fma(grad, weight, sum);
#endif
}

void scalar_main() {
    uint in_col = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;
    if (row >= pc.rows || in_col >= pc.input_dim) {
        return;
    }

    float sum = 0.0;
    uint grad_base = row * pc.output_dim;
    uint weight_base = in_col * pc.output_dim;
    for (uint out_col = 0u; out_col < pc.output_dim; out_col += 2u) {
        bool second_active = out_col + 1u < pc.output_dim;
        vec2 weights = load_weight_pair(weight_base + out_col, second_active);
        sum = accumulate_backward_product(
            sum,
            grad_output[grad_base + out_col],
            weights.x
        );
        if (second_active) {
            sum = accumulate_backward_product(
                sum,
                grad_output[grad_base + out_col + 1u],
                weights.y
            );
        }
    }
    grad_input[row * pc.input_dim + in_col] = sum;
}

// Share each adjoint and weight tile across the 16 x 16 output block while
// preserving increasing-output-column accumulation and native-FP16 products.
const uint GRAD_TILE = 32u;
shared float grad_tile[16u * 33u];
shared float weight_tile[GRAD_TILE * 17u];

void main() {
    if (pc.rows < 8u || pc.output_dim < 64u || pc.input_dim < 16u) {
        scalar_main();
        return;
    }
    uint local_x = gl_LocalInvocationID.x;
    uint local_y = gl_LocalInvocationID.y;
    uint in_col = gl_WorkGroupID.x * 16u + local_x;
    uint row = gl_WorkGroupID.y * 16u + local_y;
    bool lane_valid = row < pc.rows && in_col < pc.input_dim;
    float sum = 0.0;

    for (uint k_base = 0u; k_base < pc.output_dim; k_base += GRAD_TILE) {
        uint load_k = k_base + local_x * 2u;
        uint grad_slot = local_y * 33u + local_x * 2u;
        grad_tile[grad_slot] =
            row < pc.rows && load_k < pc.output_dim
                ? grad_output[row * pc.output_dim + load_k] : 0.0;
        grad_tile[grad_slot + 1u] =
            row < pc.rows && load_k + 1u < pc.output_dim
                ? grad_output[row * pc.output_dim + load_k + 1u] : 0.0;

        uint weight_col = gl_WorkGroupID.x * 16u + local_y;
        uint weight_slot = local_x * 2u * 17u + local_y;
        vec2 weights = vec2(0.0);
        if (weight_col < pc.input_dim && load_k < pc.output_dim) {
            weights = load_weight_pair(
                weight_col * pc.output_dim + load_k,
                load_k + 1u < pc.output_dim
            );
        }
        weight_tile[weight_slot] = weights.x;
        weight_tile[weight_slot + 17u] = weights.y;

        barrier();
        if (lane_valid) {
            uint count = min(GRAD_TILE, pc.output_dim - k_base);
            for (uint k = 0u; k < count; ++k) {
                sum = accumulate_backward_product(sum,
                    grad_tile[local_y * 33u + k],
                    weight_tile[k * 17u + local_x]
                );
            }
        }
        barrier();
    }
    if (lane_valid) {
        grad_input[row * pc.input_dim + in_col] = sum;
    }
}
