#version 450
#extension GL_GOOGLE_include_directive : require
#include "fp32_sqrt_recip.glsl"
#include "fp32_fma_exact.glsl"
#include "fp32_sleef_exp.glsl"
#include "fp32_v41_unary.glsl"

// V4.1 Hyper-Connection coefficients, adjoint of
// `transformer_deepseek_v41_hc_split.comp` (reference `Block.hc_mixes` +
// `hc_split_sinkhorn`). The forward is
//   rstd = rsqrt(mean(stream^2) + norm_eps)
//   mix  = raw * rstd
//   pre  = sigmoid(mix * s0 + b0) + eps
//   post = 2 * sigmoid(mix * s1 + b1)
//   comb = softmax_rows(mix * s2 + b2) + eps
//   comb = comb / (col_sum + eps)
//   (iters - 1) x [comb = comb / (row_sum + eps); comb = comb / (col_sum + eps)]
// and this kernel returns the gradient with respect to the scaled mix value
// (`raw * rstd`), which is what the mix-projection adjoint consumes. Applying
// the `rstd` factor belongs to that stage: dividing `d raw` by `rstd` would not
// invert the multiply exactly.
//
// The normalization chain is inverted in reverse order. Every step is
// `y = x / (sum(x) + eps)` along one axis, so with `D = sum(x) + eps`
//   d_x = d_y / D + sum_axis(-(d_y * x) / D^2)
// matching PyTorch's separate `grad / other` and `-grad * self / (other*other)`
// contributions. The pre-step matrix a step needs is replayed from the stored
// softmax output: the chain is short (hc <= 16) and rebuilding it is cheaper
// than keeping every intermediate alive in private storage.
//
// The chain starts at `softmax + eps`, the operand the first normalization
// actually divides, but the softmax Jacobian is taken at the softmax output
// itself: `comb = softmax + eps` is an add, so its adjoint passes through
// unchanged, and `s * (d - sum(d * s))` must use `s`, not `s + eps`. Mixing the
// two (carrying the `+ eps` into the Jacobian) biases every comb gradient by
// roughly `eps / sum(d)`, which is 1.7e-6 on the pinned fixture -- a real
// failure of the strict gate rather than rounding.
layout(local_size_x = 32) in;
layout(set = 0, binding = 0, std430) readonly buffer Raw { float raw[]; };
layout(set = 0, binding = 1, std430) readonly buffer Stream { float stream[]; };
layout(set = 0, binding = 2, std430) readonly buffer Scale { float scale[]; };
layout(set = 0, binding = 3, std430) readonly buffer Base { float base[]; };
layout(set = 0, binding = 4, std430) readonly buffer GradPre { float grad_pre[]; };
layout(set = 0, binding = 5, std430) readonly buffer GradPost { float grad_post[]; };
layout(set = 0, binding = 6, std430) readonly buffer GradComb { float grad_comb[]; };
layout(set = 0, binding = 7, std430) writeonly buffer GradMix { float grad_mix[]; };
layout(push_constant) uniform Push {
    uint rows;
    uint hc;
    uint dim;
    uint mix_hc;
    uint sinkhorn_iters;
    float eps;
    float norm_eps;
} pc;

#define V41_REDUCE_INPUT stream
#include "fp32_v41_reduce_parallel.glsl"

#ifdef HIERARCHOS_V41_HC_CACHE
// Bounded native variant: HC <= 4 and at most 20 Sinkhorn iterations.
// Retain the exact forward states in 2,496 bytes of workgroup storage instead
// of replaying every prefix for every reverse step (quadratic work).
const uint MAX_HC = 4u;
#else
const uint MAX_HC = 16u;
#endif
const uint MAX_CELLS = MAX_HC * MAX_HC;
const uint MAX_MIX = (2u + MAX_HC) * MAX_HC;

shared float mix[MAX_MIX];
shared float pre_sigmoid[MAX_HC];
shared float post_sigmoid[MAX_HC];
shared float softmax[MAX_CELLS];
shared float matrix[MAX_CELLS];
shared float state[MAX_CELLS];
shared float gradient[MAX_CELLS];
shared float axis_denominator[MAX_HC];
shared float axis_tail[MAX_HC];
shared float norm_rstd;
#ifdef HIERARCHOS_V41_HC_CACHE
shared float history[39u * MAX_CELLS];
#endif

void normalize_rows() {
    if (gl_LocalInvocationID.x == 0u)
    for (uint j = 0u; j < pc.hc; ++j) {
        float sum = 0.0;
        for (uint k = 0u; k < pc.hc; ++k) sum += state[j * pc.hc + k];
        axis_denominator[j] = sum + pc.eps;
    }
    barrier();
    for (uint cell = gl_LocalInvocationID.x; cell < pc.hc * pc.hc; cell += 32u)
        state[cell] = fp32_div(state[cell], axis_denominator[cell / pc.hc]);
    barrier();
}

void normalize_columns() {
    if (gl_LocalInvocationID.x == 0u)
    for (uint k = 0u; k < pc.hc; ++k) {
        float sum = 0.0;
        for (uint j = 0u; j < pc.hc; ++j) sum += state[j * pc.hc + k];
        axis_denominator[k] = sum + pc.eps;
    }
    barrier();
    for (uint cell = gl_LocalInvocationID.x; cell < pc.hc * pc.hc; cell += 32u)
        state[cell] = fp32_div(state[cell], axis_denominator[cell % pc.hc]);
    barrier();
}

// Step 1 is the standalone column normalization; the alternating loop that
// follows starts with a row normalization on step 2.
void forward_step(uint step) {
    if (step % 2u == 1u) normalize_columns();
    else normalize_rows();
}

void backward_step(uint step) {
    if (gl_LocalInvocationID.x == 0u) {
    if (step % 2u == 1u) {
        for (uint k = 0u; k < pc.hc; ++k) {
            float sum = 0.0;
            for (uint j = 0u; j < pc.hc; ++j) sum += state[j * pc.hc + k];
            precise float denominator = sum + pc.eps;
            precise float square = denominator * denominator;
            precise float tail = 0.0;
            for (uint j = 0u; j < pc.hc; ++j) {
#ifdef HIERARCHOS_V41_CPU_AVX2
                precise float quotient=fp32_div(state[j*pc.hc+k],denominator);
                quotient=fp32_div(quotient,denominator);
                precise float product=-gradient[j*pc.hc+k]*quotient;
                tail+=product;
#else
                precise float product = gradient[j * pc.hc + k] * state[j * pc.hc + k];
                tail += fp32_div(product, square);
#endif
            }
            axis_denominator[k] = denominator;
            axis_tail[k] = tail;
        }
    } else {
        for (uint j = 0u; j < pc.hc; ++j) {
            float sum = 0.0;
            for (uint k = 0u; k < pc.hc; ++k) sum += state[j * pc.hc + k];
            precise float denominator = sum + pc.eps;
            precise float square = denominator * denominator;
            precise float tail = 0.0;
            for (uint k = 0u; k < pc.hc; ++k) {
#ifdef HIERARCHOS_V41_CPU_AVX2
                precise float quotient=fp32_div(state[j*pc.hc+k],denominator);
                quotient=fp32_div(quotient,denominator);
                precise float product=-gradient[j*pc.hc+k]*quotient;
                tail+=product;
#else
                precise float product = gradient[j * pc.hc + k] * state[j * pc.hc + k];
                tail += fp32_div(product, square);
#endif
            }
            axis_denominator[j] = denominator;
            axis_tail[j] = tail;
        }
    }
    }
    barrier();
    for (uint cell = gl_LocalInvocationID.x; cell < pc.hc * pc.hc; cell += 32u) {
        uint axis = step % 2u == 1u ? cell % pc.hc : cell / pc.hc;
        precise float direct = fp32_div(gradient[cell], axis_denominator[axis]);
#ifdef HIERARCHOS_V41_CPU_AVX2
        gradient[cell] = direct + axis_tail[axis];
#else
        gradient[cell] = direct - axis_tail[axis];
#endif
    }
    barrier();
}

void main() {
    uint row = gl_WorkGroupID.x, lane = gl_LocalInvocationID.x;
    if (row >= pc.rows) return;
    uint width = pc.hc * pc.dim;
    uint mix_base = row * pc.mix_hc;

    precise float squares = v41_sum_squares(row * width, width);
    if (lane == 0u) {
        precise float variance = fp32_div(squares, float(width)) + pc.norm_eps;
        norm_rstd = fp32_sqrt_recip(variance);
    }
    barrier();
    float rstd = norm_rstd;

    for (uint m = lane; m < pc.mix_hc; m += 32u) mix[m] = raw[mix_base + m] * rstd;
    barrier();

    // Recompute the forward coefficient values the gradient is taken at.
    uint sigmoid_elements = pc.rows * pc.hc;
    for (uint j = lane; j < pc.hc; j += 32u) {
        precise float pre_arg = (mix[j] * scale[0]) + base[j];
        pre_sigmoid[j] = v41_cpu_sigmoid(pre_arg, row * pc.hc + j, sigmoid_elements);
        precise float post_arg = (mix[pc.hc + j] * scale[1]) + base[pc.hc + j];
        post_sigmoid[j] = v41_cpu_sigmoid(post_arg, row * pc.hc + j, sigmoid_elements);
    }

    for (uint cell = lane; cell < pc.hc * pc.hc; cell += 32u) {
            uint index = pc.hc * 2u + cell;
            precise float value = mix[index] * scale[2];
            softmax[cell] = value + base[index];
    }
    barrier();
    if (lane == 0u)
    for (uint j = 0u; j < pc.hc; ++j) {
        float maximum = softmax[j * pc.hc];
        for (uint k = 1u; k < pc.hc; ++k)
            maximum = max(maximum, softmax[j * pc.hc + k]);
        axis_denominator[j] = maximum;
    }
    barrier();
    for (uint cell = lane; cell < pc.hc * pc.hc; cell += 32u)
        softmax[cell] = sleef_expf_u10(softmax[cell] - axis_denominator[cell / pc.hc]);
    barrier();
    if (lane == 0u)
    for (uint j = 0u; j < pc.hc; ++j) {
        precise float total = 0.0;
        for (uint k = 0u; k < pc.hc; ++k) total += softmax[j * pc.hc + k];
        axis_denominator[j] = fp32_div(1.0, total);
    }
    barrier();
    for (uint cell = lane; cell < pc.hc * pc.hc; cell += 32u) {
        softmax[cell] *= axis_denominator[cell / pc.hc];
        matrix[cell] = softmax[cell] + pc.eps;
        gradient[cell] = grad_comb[row * pc.hc * pc.hc + cell];
    }
    barrier();

    uint steps = 1u + 2u * (pc.sinkhorn_iters - 1u);
#ifdef HIERARCHOS_V41_HC_CACHE
    for (uint cell = lane; cell < pc.hc * pc.hc; cell += 32u) state[cell] = matrix[cell];
    barrier();
    for (uint step = 1u; step <= steps; ++step) {
        for (uint cell = lane; cell < pc.hc * pc.hc; cell += 32u)
            history[(step - 1u) * MAX_CELLS + cell] = state[cell];
        barrier();
        if (step < steps) forward_step(step);
    }
    for (int step = int(steps); step >= 1; --step) {
        for (uint cell = lane; cell < pc.hc * pc.hc; cell += 32u)
            state[cell] = history[(uint(step) - 1u) * MAX_CELLS + cell];
        barrier();
        backward_step(uint(step));
    }
#else
    for (int step = int(steps); step >= 1; --step) {
        for (uint cell = lane; cell < pc.hc * pc.hc; cell += 32u) state[cell] = matrix[cell];
        barrier();
        for (uint applied = 1u; applied < uint(step); ++applied) forward_step(applied);
        backward_step(uint(step));
    }
#endif

    // Softmax over the last axis: grad = s * (d - sum(d * s)).
    if (lane == 0u)
    for (uint j = 0u; j < pc.hc; ++j) {
        precise float dot = 0.0;
        for (uint k = 0u; k < pc.hc; ++k)
            dot += gradient[j * pc.hc + k] * softmax[j * pc.hc + k];
        axis_tail[j] = dot;
    }
    barrier();
    for (uint cell = lane; cell < pc.hc * pc.hc; cell += 32u) {
        precise float value = gradient[cell] - axis_tail[cell / pc.hc];
        gradient[cell] = softmax[cell] * value;
    }
    barrier();

    for (uint m = lane; m < pc.mix_hc; m += 32u) {
        float value = 0.0;
        // The sigmoid argument carries the stage scale, so the branch
        // gradients pick it up after the activation backward.
        if (m < pc.hc) {
        precise float sigmoid = pre_sigmoid[m];
#ifdef HIERARCHOS_V41_CPU_AVX2
        precise float pre_argument = (grad_pre[row * pc.hc + m] * (1.0-sigmoid)) * sigmoid;
#else
        precise float pre_argument = (grad_pre[row * pc.hc + m] * sigmoid)
            * (1.0 - sigmoid);
#endif
        value = pre_argument * scale[0];
        } else if (m < pc.hc * 2u) {
        uint j = m - pc.hc;
        precise float post_gradient = grad_post[row * pc.hc + j] * 2.0;
        precise float post_sigmoid_value = post_sigmoid[j];
#ifdef HIERARCHOS_V41_CPU_AVX2
        precise float post_argument = (post_gradient * (1.0-post_sigmoid_value)) * post_sigmoid_value;
#else
        precise float post_argument = (post_gradient * post_sigmoid_value)
            * (1.0 - post_sigmoid_value);
#endif
        value = post_argument * scale[1];
        } else if (m < pc.hc * 2u + pc.hc * pc.hc) {
            value = gradient[m - pc.hc * 2u] * scale[2];
        }
        grad_mix[mix_base + m] = value;
    }
}
