#version 450
#extension GL_GOOGLE_include_directive : require
#include "fp32_sqrt_recip.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer { float x[]; };
layout(set = 0, binding = 1, std430) readonly buffer WeightBuffer { float weight[]; };
layout(set = 0, binding = 2, std430) writeonly buffer OutputBuffer { float output_values[]; };
layout(set = 0, binding = 3, std430) writeonly buffer RstdBuffer { float rstd_values[]; };
layout(set = 0, binding = 4, std430) writeonly buffer MeanSquaredBuffer { float mean_squared_values[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint dim;
    uint parameter_groups;
    float eps;
    float weight_offset;
    uint pow_rstd;
    uint unfused_products;
    uint extra_rsqrt_refinement;
} pc;

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.rows) return;
    uint base = row * pc.dim;
    uint parameter_base = (row % pc.parameter_groups) * pc.dim;
    precise float square_sum = 0.0;
    if (pc.extra_rsqrt_refinement == 3u) {
        // The vector CPU-rsqrt mode materializes x.pow(2) and reduces
        // contiguous FP32 rows through the 8-wide vector reducer.
        // Accumulate interleaved vector lanes, then fold the lanes in order.
        // This preserves the CPU vector topology where the reference exposes
        // it through the RMS reduction.
        precise float lanes[8];
        for (uint lane = 0u; lane < 8u; ++lane) lanes[lane] = 0.0;
        for (uint col = 0u; col < pc.dim; ++col) {
            precise float square = x[base + col] * x[base + col];
            uint lane = col & 7u;
            lanes[lane] += square;
        }
        for (uint lane = 0u; lane < 8u; ++lane) square_sum += lanes[lane];
    } else {
        for (uint col = 0; col < pc.dim; ++col) {
            float value = x[base + col];
            if (pc.unfused_products != 0u || pc.pow_rstd != 0u) {
                // Materialize x.pow(2) before the reduction.  The strict PEFT
                // fixtures outside the vector CPU-rsqrt mode use scalar FP32
                // order. Gemma4/Gemma3n's torch.pow RMSNorm also follows this
                // materialized scalar reduction for the strict CPU oracle.
                precise float square = value * value;
                square_sum += square;
            } else {
                square_sum = fma(value, value, square_sum);
            }
        }
    }
    float mean_squared = square_sum / float(pc.dim) + pc.eps;
    // Gemma 4 / Gemma3n intentionally use pow(x, -0.5) instead of rsqrt in
    // the Transformers reference implementation. Keep that operation choice
    // explicit because the two forms can differ by a few FP32 ulps and those
    // differences are observable after a full backward + AdamW step.
    float rstd;
    if (pc.pow_rstd != 0u) {
        // Gemma4 spells this as torch.pow(mean_squared, -0.5).  On the local
        // PyTorch 2.6 AVX512 oracle used by the strict PEFT fixtures, the
        // captured tiny Gemma4 tensors follow the scalar FP32 sqrt+reciprocal
        // result.  That can differ by one ulp from a correctly-rounded real
        // reciprocal square root, and the RMS backward amplifies the seed.
        rstd = fp32_sqrt_recip(mean_squared);
    } else if (pc.extra_rsqrt_refinement == 2u) {
        // KimiLinear uses torch.rsqrt on an FP32 mean-square tensor. Match
        // that single correctly-rounded reciprocal-square-root operation
        // directly rather than refining the device approximation.
        rstd = fp32_rsqrt(mean_squared);
    } else if (pc.extra_rsqrt_refinement != 0u) {
        rstd = fp32_sqrt_recip(mean_squared);
    } else if (pc.unfused_products != 0u) {
        // CPU torch.rsqrt is more accurate than the native GPU reciprocal-
        // square-root approximation on some Qwen3.5 inputs.  One explicit
        // Newton refinement keeps every intermediate rounded to FP32 and
        // brings the device result to the correctly-rounded neighborhood
        // without changing the operation order of the surrounding norm.
        precise float y0 = inversesqrt(mean_squared);
        precise float y0_sq = y0 * y0;
        precise float scaled = mean_squared * y0_sq;
        precise float half_scaled = 0.5 * scaled;
        precise float correction = 1.5 - half_scaled;
        precise float refined = y0 * correction;
        rstd = refined;
    } else {
        rstd = inversesqrt(mean_squared);
    }
    mean_squared_values[row] = mean_squared;
    rstd_values[row] = rstd;
    for (uint col = 0; col < pc.dim; ++col) {
        output_values[base + col] = x[base + col] * rstd * (weight[parameter_base + col] + pc.weight_offset);
    }
}
