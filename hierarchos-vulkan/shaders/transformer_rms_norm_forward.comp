#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer { float x[]; };
layout(set = 0, binding = 1, std430) readonly buffer WeightBuffer { float weight[]; };
layout(set = 0, binding = 2, std430) writeonly buffer OutputBuffer { float output_values[]; };
layout(set = 0, binding = 3, std430) writeonly buffer RstdBuffer { float rstd_values[]; };
layout(set = 0, binding = 4, std430) writeonly buffer MeanSquaredBuffer { float mean_squared_values[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint dim;
    uint parameter_groups;
    float eps;
    float weight_offset;
    uint pow_rstd;
    uint unfused_products;
} pc;

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.rows) return;
    uint base = row * pc.dim;
    uint parameter_base = (row % pc.parameter_groups) * pc.dim;
    float square_sum = 0.0;
    for (uint col = 0; col < pc.dim; ++col) {
        float value = x[base + col];
        if (pc.pow_rstd != 0u || pc.unfused_products != 0u) {
            // PyTorch materializes `x.pow(2)` before the mean for the
            // Qwen3-Next/Qwen3.5 family as well as Gemma4RMSNorm. Prevent
            // contraction when the architecture requests that exact FP32
            // operation order.
            precise float square = value * value;
            square_sum += square;
        } else {
            square_sum = fma(value, value, square_sum);
        }
    }
    float mean_squared = square_sum / float(pc.dim) + pc.eps;
    // Gemma 4 / Gemma3n intentionally use pow(x, -0.5) instead of rsqrt in
    // the Transformers reference implementation. Keep that operation choice
    // explicit because the two forms can differ by a few FP32 ulps and those
    // differences are observable after a full backward + AdamW step.
    float rstd;
    if (pc.pow_rstd != 0u) {
        rstd = pow(mean_squared, -0.5);
    } else if (pc.unfused_products != 0u) {
        // CPU torch.rsqrt is more accurate than the native GPU reciprocal-
        // square-root approximation on some Qwen3.5 inputs.  One explicit
        // Newton refinement keeps every intermediate rounded to FP32 and
        // brings the device result to the correctly-rounded neighborhood
        // without changing the operation order of the surrounding norm.
        precise float y0 = inversesqrt(mean_squared);
        precise float y0_sq = y0 * y0;
        precise float scaled = mean_squared * y0_sq;
        precise float half_scaled = 0.5 * scaled;
        precise float correction = 1.5 - half_scaled;
        precise float refined = y0 * correction;
        rstd = refined;
    } else {
        rstd = inversesqrt(mean_squared);
    }
    mean_squared_values[row] = mean_squared;
    rstd_values[row] = rstd;
    for (uint col = 0; col < pc.dim; ++col) {
        output_values[base + col] = x[base + col] * rstd * (weight[parameter_base + col] + pc.weight_offset);
    }
}
