#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer { float input_values[]; };
layout(set = 0, binding = 1, std430) readonly buffer GateBuffer { float gate_values[]; };
layout(set = 0, binding = 2, std430) readonly buffer WeightBuffer { float weight_values[]; };
layout(set = 0, binding = 3, std430) readonly buffer GradOutputBuffer { float grad_output[]; };
layout(set = 0, binding = 4, std430) writeonly buffer GradInputBuffer { float grad_input[]; };
layout(set = 0, binding = 5, std430) writeonly buffer GradGateBuffer { float grad_gate[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint num_heads;
    uint head_dim;
    float epsilon;
} pc;

void main() {
    uint row_head = gl_GlobalInvocationID.x;
    uint total = pc.rows * pc.num_heads;
    if (row_head >= total) return;
    uint base = row_head * pc.head_dim;
    float mean_square = 0.0;
    for (uint dim = 0u; dim < pc.head_dim; ++dim) {
        float x = input_values[base + dim];
        mean_square = fma(x, x, mean_square);
    }
    float inv_rms = inversesqrt(mean_square / float(pc.head_dim) + pc.epsilon);
    float dot = 0.0;
    for (uint dim = 0u; dim < pc.head_dim; ++dim) {
        float s = 1.0 / (1.0 + exp(-gate_values[base + dim]));
        float ghat = grad_output[base + dim] * weight_values[dim] * s;
        dot = fma(ghat, input_values[base + dim], dot);
    }
    float correction = inv_rms * inv_rms * inv_rms * dot / float(pc.head_dim);
    for (uint dim = 0u; dim < pc.head_dim; ++dim) {
        float x = input_values[base + dim];
        float s = 1.0 / (1.0 + exp(-gate_values[base + dim]));
        float go = grad_output[base + dim];
        float ghat = go * weight_values[dim] * s;
        grad_input[base + dim] = inv_rms * ghat - x * correction;
        grad_gate[base + dim] = go * x * inv_rms * weight_values[dim] * s * (1.0 - s);
    }
}
