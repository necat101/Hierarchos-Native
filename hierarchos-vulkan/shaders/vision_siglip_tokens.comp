#version 450
// SigLIP has no class token: every sequence row is a patch. Mode 0 adds the
// learned position embedding to the projected patches; mode 1 reduces the
// token gradient back onto the shared position table.
layout(local_size_x=256) in;
layout(set=0,binding=0,std430) readonly buffer X { float x[]; };
layout(set=0,binding=1,std430) readonly buffer P { float pos[]; };
layout(set=0,binding=2,std430) writeonly buffer Y { float y[]; };
layout(push_constant) uniform Push { uint images; uint seq; uint dim; uint mode; } pc;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(pc.mode==0) {
        if(i>=pc.images*pc.seq*pc.dim) return;
        uint col=i%pc.dim, token=(i/pc.dim)%pc.seq;
        y[i]=x[i]+pos[token*pc.dim+col];
    } else {
        if(i>=pc.seq*pc.dim) return;
        float sum=0.0;
        for(uint b=0;b<pc.images;++b) sum+=x[b*pc.seq*pc.dim+i];
        y[i]=sum;
    }
}
