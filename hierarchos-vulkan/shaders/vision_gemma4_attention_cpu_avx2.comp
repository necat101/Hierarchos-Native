#version 450
#extension GL_GOOGLE_include_directive : require
#include "fp32_fma_exact.glsl"
#include "fp32_sqrt_recip.glsl"
#include "fp32_sleef_exp.glsl"
// Measured full-attention geometry: 36 patches, 4 heads of width 4, scale 1.
// CPU QK has serial FMA for 32 key columns and two FMA lanes for its four
// remaining columns; PV uses two FMA lanes. No padding/dropout in this profile.
layout(local_size_x=1,local_size_y=1,local_size_z=1) in;
layout(set=0,binding=0,std430) readonly buffer Q {float q[];};
layout(set=0,binding=1,std430) readonly buffer K {float k[];};
layout(set=0,binding=2,std430) readonly buffer V {float v[];};
layout(set=0,binding=3,std430) writeonly buffer O {float output_values[];};
layout(push_constant) uniform P {uint images;uint seq;uint dim;uint heads;} pc;
void main(){
    uint query=gl_GlobalInvocationID.x,head=gl_GlobalInvocationID.y,image=gl_GlobalInvocationID.z;
    if(image>=pc.images || query>=36u || head>=pc.heads)return;
    uint hd=pc.dim/pc.heads,qb=(image*36u+query)*pc.dim+head*hd;
    float values[36];float maximum=-3.402823466e+38;
    for(uint key=0u;key<36u;++key){
        uint kb=(image*36u+key)*pc.dim+head*hd;
        float lane0=0.0,lane1=0.0;
        for(uint d=0u;d<hd;++d){
            if(key>=32u && (d&1u)!=0u)lane1=fp32_fma_exact(q[qb+d],k[kb+d],lane1);
            else lane0=fp32_fma_exact(q[qb+d],k[kb+d],lane0);
        }
        values[key]=lane0+lane1;maximum=max(maximum,values[key]);
    }
    precise float lanes[8];for(uint j=0u;j<8u;++j)lanes[j]=0.0;
    for(uint key=0u;key<36u;++key){
#ifdef GEMMA4_FUSED_EXP
        values[key]=sleef_expf_u10_fused(values[key]-maximum);
#else
        values[key]=sleef_expf_u10(values[key]-maximum);
#endif
        lanes[key&7u]+=values[key];
    }
    precise float total=0.0;for(uint j=0u;j<8u;++j)total+=lanes[j];
    float inverse=fp32_div(1.0,total);
    for(uint key=0u;key<36u;++key)values[key]*=inverse;
    for(uint d=0u;d<hd;++d){
        float a=0.0,b=0.0;
        for(uint key=0u;key<36u;key+=2u){
            uint vb=(image*36u+key)*pc.dim+head*hd+d;
            a=fp32_fma_exact(values[key],v[vb],a);
            b=fp32_fma_exact(values[key+1u],v[vb+pc.dim],b);
        }
        output_values[qb+d]=a+b;
    }
}
