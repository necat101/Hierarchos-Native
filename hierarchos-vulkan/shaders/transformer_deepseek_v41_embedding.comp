#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Tokens { uint token_ids[]; };
layout(set = 0, binding = 1, std430) readonly buffer Embedding { float embedding[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Stream { float stream[]; };
layout(push_constant) uniform Push {
    uint rows;
    uint dim;
    uint hc;
    uint vocab;
} pc;

void main() {
    uint col = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;
    if (row >= pc.rows || col >= pc.hc * pc.dim) return;
    uint token = token_ids[row];
    // Public entry points reject invalid ids before changing sequence state.
    stream[row * pc.hc * pc.dim + col] = token < pc.vocab
        ? embedding[token * pc.dim + col % pc.dim] : 0.0;
}
