#version 450
#extension GL_GOOGLE_include_directive : require
#include "fp32_fma_exact.glsl"
#include "fp32_sqrt_recip.glsl"
#include "fp32_sleef_exp.glsl"
layout(local_size_x=256) in;
layout(set=0,binding=0,std430) readonly buffer X { float x[]; };
#ifdef VISION_BACKWARD
layout(set=0,binding=1,std430) readonly buffer G { float grad[]; };
layout(set=0,binding=2,std430) writeonly buffer Y { float y[]; };
#else
layout(set=0,binding=1,std430) writeonly buffer Y { float y[]; };
#endif
layout(push_constant) uniform Push { uint len; } pc;
void main() {
    uint i=gl_GlobalInvocationID.x;
    if(i>=pc.len) return;
    precise float q=1.702*x[i];
    float s=fp32_div(1.0,1.0+sleef_expf_u10(-q));
#ifdef VISION_BACKWARD
    precise float g=grad[i]*x[i];
    precise float ds=g*(1.0-s);
    ds=ds*s;
    precise float indirect=ds*1.702;
    precise float direct=grad[i]*s;
    y[i]=direct+indirect;
#else
    y[i]=x[i]*s;
#endif
}
