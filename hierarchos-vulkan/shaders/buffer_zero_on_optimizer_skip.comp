#version 450

// Clear an auxiliary optimizer-window accumulator only when the device-side
// GradScaler decision rejects the step. This keeps overflow cleanup in the same
// submission as the non-finite scan and predicated AdamW update.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer ValueBuffer { float values[]; };
layout(set = 0, binding = 1, std430) readonly buffer ControlStateBuffer { uint control[]; };

layout(push_constant) uniform Push { uint len; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < pc.len && control[3] == 0u) {
        values[i] = 0.0;
    }
}
