#version 450
#extension GL_GOOGLE_include_directive : require
#include "fp32_fma_exact.glsl"
// Transposed-left CPU GEMM for native LoRA dW = dY.T @ X. The output's
// row panel and column width select the same AVX2 body/tail as input VJPs.
layout(local_size_x=16,local_size_y=16) in;
layout(set=0,binding=0,std430) readonly buffer X {float x[];};
layout(set=0,binding=1,std430) readonly buffer DY {float dy[];};
layout(set=0,binding=2,std430) writeonly buffer DW {float dw[];};
layout(push_constant) uniform P {uint rows;uint input_dim;uint output_dim;} pc;
void main() {
    uint col=gl_GlobalInvocationID.x,row=gl_GlobalInvocationID.y;
    if(col>=pc.input_dim || row>=pc.output_dim)return;
    uint tail=pc.output_dim%6u;
    bool short_panel=tail>0u && tail<=3u && row>=pc.output_dim-tail;
    precise float a=0.0,b=0.0;
    for(uint k=0u;k<pc.rows/2u*2u;++k) {
        float g=dy[k*pc.output_dim+row],v=x[k*pc.input_dim+col];
        if(short_panel || pc.input_dim<=8u) {
            if(short_panel && tail<=2u) {precise float p=g*v;if((k&1u)==0u)a+=p;else b+=p;}
            else {if((k&1u)==0u)a=fp32_fma_exact(g,v,a);else b=fp32_fma_exact(g,v,b);}
        } else a=fp32_fma_exact(g,v,a);
    }
    precise float result=a+b;
    if((pc.rows&1u)!=0u) {
        uint k=pc.rows-1u;float g=dy[k*pc.output_dim+row],v=x[k*pc.input_dim+col];
        if(short_panel && tail<=2u){precise float p=g*v;result+=p;}
        else result=fp32_fma_exact(g,v,result);
    }
    dw[row*pc.input_dim+col]=result;
}
