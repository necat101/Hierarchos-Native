#version 450

// Intel Gen9 candidate for silu_forward: 64 invocations per workgroup, four
// elements each, so the host dispatch grid (256 elements per group) is
// unchanged. Each element keeps the exact portable FP32 expression.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer { float x[]; };
layout(set = 0, binding = 1, std430) writeonly buffer OutputBuffer { float output_values[]; };

layout(push_constant) uniform Push {
    uint len;
} pc;

void main() {
    uint base = gl_GlobalInvocationID.x;
    for (uint slot = 0u; slot < 4u; ++slot) {
        uint index = base + slot * 64u;
        if (index >= pc.len) {
            return;
        }
        float value = x[index];
        float sigmoid_value = 1.0 / (1.0 + exp(-value));
        output_values[index] = value * sigmoid_value;
    }
}
