#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer { float x[]; };
layout(set = 0, binding = 1, std430) readonly buffer WeightBuffer { float weight[]; };
layout(set = 0, binding = 2, std430) readonly buffer BiasBuffer { float bias[]; };
layout(set = 0, binding = 3, std430) writeonly buffer OutputBuffer { float y[]; };
layout(set = 0, binding = 4, std430) writeonly buffer MeanBuffer { float mean[]; };
layout(set = 0, binding = 5, std430) writeonly buffer RstdBuffer { float rstd[]; };

layout(push_constant) uniform Push {
    uint batch;
    uint width;
    uint head_size;
    float eps;
} pc;

void main() {
    uint group = gl_GlobalInvocationID.x;
    uint heads = pc.width / pc.head_size;
    uint group_count = pc.batch * heads;
    if (group >= group_count) {
        return;
    }
    uint batch_index = group / heads;
    uint head = group % heads;
    uint base = batch_index * pc.width + head * pc.head_size;
    uint channel_base = head * pc.head_size;

    float mu = 0.0;
    for (uint i = 0; i < pc.head_size; ++i) {
        mu += x[base + i];
    }
    mu /= float(pc.head_size);

    float var = 0.0;
    for (uint i = 0; i < pc.head_size; ++i) {
        float centered = x[base + i] - mu;
        var = fma(centered, centered, var);
    }
    var /= float(pc.head_size);
    float inv_std = inversesqrt(var + pc.eps);
    mean[group] = mu;
    rstd[group] = inv_std;

    for (uint i = 0; i < pc.head_size; ++i) {
        uint index = base + i;
        uint channel = channel_base + i;
        float xhat = (x[index] - mu) * inv_std;
        y[index] = fma(xhat, weight[channel], bias[channel]);
    }
}
