#version 450

// Correctness-first scaled dot-product attention for the native Transformer
// training graph. The same kernel supports causal decoder attention and full
// bidirectional encoder attention. One invocation owns one (batch, head,
// query) row, so no atomics are required and all reductions have deterministic
// order.
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer QBuffer { float q_values[]; };
layout(set = 0, binding = 1, std430) readonly buffer KBuffer { float k_values[]; };
layout(set = 0, binding = 2, std430) readonly buffer VBuffer { float v_values[]; };
layout(set = 0, binding = 3, std430) readonly buffer QueryMaskBuffer { float query_mask[]; };
layout(set = 0, binding = 4, std430) readonly buffer KeyMaskBuffer { float key_mask[]; };
layout(set = 0, binding = 5, std430) readonly buffer AlibiPositionBuffer { float alibi_positions[]; };
layout(set = 0, binding = 6, std430) writeonly buffer OutputBuffer { float output_values[]; };
layout(set = 0, binding = 7, std430) readonly buffer SinkBuffer { float sink_values[]; };
layout(set = 0, binding = 8, std430) readonly buffer RelativeBiasBuffer { float relative_bias[]; };
layout(set = 0, binding = 9, std430) readonly buffer SparseMaskBuffer { float sparse_mask[]; };

layout(push_constant) uniform Push {
    uint batch_size;
    uint query_seq_len;
    uint key_value_seq_len;
    uint query_hidden_size;
    uint value_hidden_size;
    uint num_heads;
    uint num_key_value_heads;
    uint window_size;
    float scale;
    float value_scale;
    float softcap;
    uint alibi_mode;
    float alibi_bias_max;
    float dropout_p;
    uint rng_step;
    uint rng_site;
    uint rng_seed;
    uint has_sink;
    uint causal;
    uint relative_bias_mode;
    uint relative_bias_num_buckets;
    uint relative_bias_max_distance;
    uint query_position_offset;
    uint has_sparse_mask;
    uint compressed_key_count;
    uint compressed_key_rate;
} pc;

bool key_is_visible(uint batch, uint head, uint query, uint key) {
    uint local_key_count = pc.key_value_seq_len - pc.compressed_key_count;
    if (pc.compressed_key_count != 0u && key >= local_key_count) {
        if (pc.compressed_key_rate == 0u) return false;
        uint compressed_index = key - local_key_count;
        uint absolute_query = pc.query_position_offset + query;
        if (compressed_index >= (absolute_query + 1u) / pc.compressed_key_rate) return false;
    } else {
        uint key_row = batch * local_key_count + key;
        if (key_mask[key_row] <= 0.0) return false;
        if (pc.compressed_key_count != 0u) {
            uint absolute_query = pc.query_position_offset + query;
            if (pc.causal != 0u && key > absolute_query) return false;
            if (pc.window_size != 0u) {
                if (pc.causal != 0u) {
                    uint first_local = absolute_query + 1u > pc.window_size
                        ? absolute_query + 1u - pc.window_size
                        : 0u;
                    if (key < first_local) return false;
                } else {
                    uint distance = key > absolute_query ? key - absolute_query : absolute_query - key;
                    if (distance > pc.window_size) return false;
                }
            }
        }
    }
    if (pc.has_sparse_mask == 0u) return true;
    uint sparse_index;
    if (pc.has_sparse_mask == 2u) {
        uint heads_per_kv = pc.num_heads / pc.num_key_value_heads;
        uint kv_head = head / heads_per_kv;
        sparse_index = (((batch * pc.num_key_value_heads + kv_head) * pc.query_seq_len + query)
            * pc.key_value_seq_len) + key;
    } else {
        sparse_index = (batch * pc.query_seq_len + query) * pc.key_value_seq_len + key;
    }
    return sparse_mask[sparse_index] > 0.0;
}

uint dropout_hash(uint value) {
    value ^= value >> 16u;
    value *= 0x7feb352du;
    value ^= value >> 15u;
    value *= 0x846ca68bu;
    value ^= value >> 16u;
    return value;
}

float dropout_scale(uint batch, uint head, uint query, uint key) {
    if (pc.dropout_p <= 0.0) return 1.0;
    uint element = (((batch * pc.num_heads + head) * pc.query_seq_len + query) * pc.key_value_seq_len) + key;
    uint value = pc.rng_seed;
    value ^= pc.rng_step * 0x9e3779b9u;
    value ^= pc.rng_site * 0x85ebca6bu;
    value ^= element * 0xc2b2ae35u;
    value = dropout_hash(value);
    float random_value = (float(value >> 8u) + 0.5) * (1.0 / 16777216.0);
    return random_value >= pc.dropout_p ? (1.0 / (1.0 - pc.dropout_p)) : 0.0;
}

uint floor_power_of_two(uint value) {
    uint power = 1u;
    while ((power << 1u) <= value) {
        power <<= 1u;
    }
    return power;
}

float bloom_alibi_slope(uint head) {
    uint closest_power = floor_power_of_two(pc.num_heads);
    float base = exp2(-exp2(-(log2(float(closest_power)) - 3.0)));
    if (head < closest_power) {
        return pow(base, float(head + 1u));
    }
    float extra_base = exp2(-exp2(-(log2(float(2u * closest_power)) - 3.0)));
    uint extra_head = head - closest_power;
    return pow(extra_base, float(1u + 2u * extra_head));
}

float mpt_alibi_slope(uint head) {
    uint power = 1u;
    while (power < pc.num_heads) {
        power <<= 1u;
    }
    uint slope_index = head;
    if (power != pc.num_heads) {
        uint odd_count = power / 2u;
        slope_index = head < odd_count ? (2u * head + 1u) : (2u * (head - odd_count));
    }
    float exponent = pc.alibi_bias_max * float(slope_index + 1u) / float(power);
    return exp2(-exponent);
}

uint t5_relative_position_bucket(uint query, uint key) {
    int relative_position = int(key) - int(query);
    uint num_buckets = pc.relative_bias_num_buckets;
    uint bucket = 0u;
    uint distance;
    if (pc.causal == 0u) {
        uint half_buckets = num_buckets / 2u;
        if (relative_position > 0) bucket += half_buckets;
        num_buckets = half_buckets;
        distance = uint(abs(relative_position));
    } else {
        distance = uint(max(-relative_position, 0));
    }
    uint max_exact = num_buckets / 2u;
    if (distance < max_exact) return bucket + distance;
    float log_scale = log(float(distance) / float(max_exact))
        / log(float(pc.relative_bias_max_distance) / float(max_exact));
    uint large_bucket = max_exact
        + uint(log_scale * float(num_buckets - max_exact));
    return bucket + min(large_bucket, num_buckets - 1u);
}

float raw_score(uint batch, uint head, uint query, uint key) {
    uint qk_head_dim = pc.query_hidden_size / pc.num_heads;
    uint key_hidden_size = qk_head_dim * pc.num_key_value_heads;
    uint queries_per_kv = pc.num_heads / pc.num_key_value_heads;
    uint kv_head = head / queries_per_kv;
    uint q_base = (batch * pc.query_seq_len + query) * pc.query_hidden_size + head * qk_head_dim;
    uint k_base = (batch * pc.key_value_seq_len + key) * key_hidden_size + kv_head * qk_head_dim;
    float value = 0.0;
    for (uint d = 0; d < qk_head_dim; ++d) {
        value = fma(q_values[q_base + d], k_values[k_base + d], value);
    }
    value *= pc.scale;
    if (pc.alibi_mode == 1u) {
        uint key_row = batch * pc.key_value_seq_len + key;
        value += bloom_alibi_slope(head) * alibi_positions[key_row];
    } else if (pc.alibi_mode == 2u) {
        // Hugging Face MPT slices the tail of a fixed [-N+1, ..., 0]
        // vector. Dropping its query-independent constant leaves key itself,
        // which is softmax-equivalent and avoids another position buffer.
        value += mpt_alibi_slope(head) * float(key);
    } else if (pc.alibi_mode == 3u) {
        // Falcon eager attention computes (QK + ALiBi) / sqrt(head_dim), so
        // its mask-relative bias must receive the same scale as the dot product.
        uint key_row = batch * pc.key_value_seq_len + key;
        value += bloom_alibi_slope(head) * alibi_positions[key_row] * pc.scale;
    }
    if (pc.relative_bias_mode == 1u) {
        uint bucket = t5_relative_position_bucket(pc.query_position_offset + query, key);
        value += relative_bias[bucket * pc.num_heads + head];
    }
    return value;
}

float score(uint batch, uint head, uint query, uint key) {
    float value = raw_score(batch, head, query, key);
    if (pc.softcap > 0.0) {
        value = pc.softcap * tanh(value / pc.softcap);
    }
    return value;
}

void main() {
    uint query = gl_GlobalInvocationID.x;
    uint head = gl_GlobalInvocationID.y;
    uint batch = gl_GlobalInvocationID.z;
    if (batch >= pc.batch_size || head >= pc.num_heads || query >= pc.query_seq_len) {
        return;
    }

    uint row = batch * pc.query_seq_len + query;
    uint value_head_dim = pc.value_hidden_size / pc.num_key_value_heads;
    uint output_hidden_size = value_head_dim * pc.num_heads;
    uint queries_per_kv = pc.num_heads / pc.num_key_value_heads;
    uint kv_head = head / queries_per_kv;
    uint out_base = row * output_hidden_size + head * value_head_dim;
    if (query_mask[row] <= 0.0) {
        for (uint d = 0; d < value_head_dim; ++d) {
            output_values[out_base + d] = 0.0;
        }
        return;
    }

    // Decoder-local attention keeps the most recent `window_size` keys.
    // Bidirectional local attention instead uses the symmetric Hugging Face
    // contract abs(query - key) <= window_size (ModernBERT and related
    // encoder families).
    uint absolute_query = pc.query_position_offset + query;
    uint first_key = 0u;
    uint last_key = pc.key_value_seq_len - 1u;
    if (pc.compressed_key_count == 0u && pc.causal != 0u) {
        last_key = min(absolute_query, pc.key_value_seq_len - 1u);
    }
    if (pc.compressed_key_count == 0u && pc.window_size != 0u) {
        if (pc.causal != 0u) {
            first_key = absolute_query + 1u > pc.window_size ? absolute_query + 1u - pc.window_size : 0u;
        } else {
            first_key = absolute_query > pc.window_size ? absolute_query - pc.window_size : 0u;
            uint right = min(pc.window_size, pc.key_value_seq_len - 1u - absolute_query);
            last_key = absolute_query + right;
        }
    }
    bool found = false;
    float max_score = -3.402823466e+38;
    for (uint key = first_key; key <= last_key; ++key) {
        if (!key_is_visible(batch, head, query, key)) {
            continue;
        }
        float s = score(batch, head, query, key);
        max_score = found ? max(max_score, s) : s;
        found = true;
    }
    if (!found) {
        for (uint d = 0; d < value_head_dim; ++d) {
            output_values[out_base + d] = 0.0;
        }
        return;
    }
    if (pc.has_sink != 0u) {
        max_score = max(max_score, sink_values[head]);
    }

    float exp_sum = pc.has_sink != 0u ? exp(sink_values[head] - max_score) : 0.0;
    for (uint key = first_key; key <= last_key; ++key) {
        if (key_is_visible(batch, head, query, key)) {
            exp_sum += exp(score(batch, head, query, key) - max_score);
        }
    }
    float inv_sum = 1.0 / exp_sum;
    for (uint d = 0; d < value_head_dim; ++d) {
        float value = 0.0;
        for (uint key = first_key; key <= last_key; ++key) {
            uint key_row = batch * pc.key_value_seq_len + key;
            if (!key_is_visible(batch, head, query, key)) {
                continue;
            }
            float probability = exp(score(batch, head, query, key) - max_score) * inv_sum;
            probability *= dropout_scale(batch, head, query, key);
            uint v_index = key_row * pc.value_hidden_size + kv_head * value_head_dim + d;
            value = fma(probability, v_values[v_index] * pc.value_scale, value);
        }
        output_values[out_base + d] = value;
    }
}
