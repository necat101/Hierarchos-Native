#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer GradGateContributionBuffer {
    float grad_gate_contribution[];
};
layout(set = 0, binding = 1, std430) buffer GradGateLogitBuffer {
    float grad_gate_logit[];
};

layout(push_constant) uniform Push {
    uint rows;
} pc;

void main() {
    if (gl_GlobalInvocationID.x != 0u) {
        return;
    }

    float total = 0.0;
    for (uint row = 0u; row < pc.rows; ++row) {
        total += grad_gate_contribution[row];
    }
    grad_gate_logit[0] += total;
}
