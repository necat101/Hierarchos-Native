#version 450

// Fused CE -> LM-head weight backward. The softmax adjoint is reconstructed
// directly from logits + compact per-row CE stats, so no [rows, vocab]
// grad_logits tensor is materialized or reread.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer { float x[]; };
layout(set = 0, binding = 1, std430) readonly buffer LogitBuffer { float logits[]; };
layout(set = 0, binding = 2, std430) readonly buffer StatsBuffer { float row_stats[]; };
layout(set = 0, binding = 3, std430) writeonly buffer GradWeightBuffer { float grad_weight[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint input_dim;
    uint output_dim;
} pc;

const uint ROW_TILE = 16u;
shared float activation_tile[ROW_TILE * 16u];
shared float grad_tile[ROW_TILE * 16u];

float ce_grad(uint row, uint out_col) {
    uint stats_base = row * 3u;
    float max_logit = row_stats[stats_base];
    float inv_sum = row_stats[stats_base + 1u];
    uint target = floatBitsToUint(row_stats[stats_base + 2u]);
    float probability = exp(logits[row * pc.output_dim + out_col] - max_logit) * inv_sum;
    float target_value = out_col == target ? 1.0 : 0.0;
    return (probability - target_value) / float(pc.rows);
}

void main() {
    uint local_x = gl_LocalInvocationID.x;
    uint local_y = gl_LocalInvocationID.y;
    uint in_col = gl_WorkGroupID.x * 16u + local_x;
    uint out_row = gl_WorkGroupID.y * 16u + local_y;
    bool lane_valid = in_col < pc.input_dim && out_row < pc.output_dim;
    float sum = 0.0;

    for (uint row_base = 0u; row_base < pc.rows; row_base += ROW_TILE) {
        uint activation_row = row_base + local_y;
        uint grad_row = row_base + local_x;

        activation_tile[local_y * 16u + local_x] =
            activation_row < pc.rows && in_col < pc.input_dim
                ? x[activation_row * pc.input_dim + in_col]
                : 0.0;
        grad_tile[local_x * 16u + local_y] =
            grad_row < pc.rows && out_row < pc.output_dim
                ? ce_grad(grad_row, out_row)
                : 0.0;

        barrier();

        if (lane_valid) {
            uint tile_rows = min(ROW_TILE, pc.rows - row_base);
            for (uint tile_row = 0u; tile_row < tile_rows; ++tile_row) {
                sum = fma(
                    grad_tile[tile_row * 16u + local_y],
                    activation_tile[tile_row * 16u + local_x],
                    sum
                );
            }
        }

        barrier();
    }

    if (lane_valid) {
        grad_weight[out_row * pc.input_dim + in_col] = sum;
    }
}
