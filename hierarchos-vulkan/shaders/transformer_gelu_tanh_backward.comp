#version 450
#extension GL_GOOGLE_include_directive : require
#include "fp32_fma_exact.glsl"
#include "fp32_sqrt_recip.glsl"
#include "fp32_sleef_tanh.glsl"

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer InputBuffer { float input_values[]; };
layout(set = 0, binding = 1, std430) readonly buffer GradOutputBuffer { float grad_output[]; };
layout(set = 0, binding = 2, std430) writeonly buffer GradInputBuffer { float grad_input[]; };
layout(push_constant) uniform Push { uint len; } pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.len) return;
    float x = input_values[i];
    const float C = 0.7978845608028654f;
    // Match PyTorch's staged tanh-GELU derivative and the forward cube order.
    // Contraction or multiplying kappa into x before x^3 changes this adjoint
    // by ulps that the following small-RMS attention norms can amplify.
    precise float x2 = x * x;
    precise float x3 = x2 * x;
    precise float cubic = 0.044715f * x3;
    precise float inner = x + cubic;
    precise float u = C * inner;
    float t = sleef_tanhf_u10(u);
    precise float du = C * (1.0 + (3.0 * 0.044715f) * x2);
    precise float left = 0.5 * (1.0 + t);
    precise float right = ((0.5 * x) * (1.0 - t * t)) * du;
    precise float derivative = left + right;
    grad_input[i] = grad_output[i] * derivative;
}
