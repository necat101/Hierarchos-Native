#version 450
#extension GL_GOOGLE_include_directive : require
#include "fp32_onednn_gelu.glsl"
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer InputBuffer { float input_values[]; };
layout(set = 0, binding = 1, std430) readonly buffer GradientBuffer { float gradient_values[]; };
layout(set = 0, binding = 2, std430) writeonly buffer OutputBuffer { float output_values[]; };
layout(push_constant) uniform Push { uint len; } pc;
void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index < pc.len) output_values[index] = onednn_gelu_backward(input_values[index], gradient_values[index]);
}
