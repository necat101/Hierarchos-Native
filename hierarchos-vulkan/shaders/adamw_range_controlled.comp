#version 450

// Range-addressed AdamW with a device-resident finite/skip decision. The
// clipping preparation pass writes the non-finite flag before any range update
// is queued. Every range can therefore sit behind replica-retirement timeline
// waits and make the mutation/skip decision only when it reaches the GPU.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer ParameterBuffer { float parameter[]; };
layout(set = 0, binding = 1, std430) buffer GradientBuffer { float gradient[]; };
layout(set = 0, binding = 2, std430) buffer ExpAvgBuffer { float exp_avg[]; };
layout(set = 0, binding = 3, std430) buffer ExpAvgSqBuffer { float exp_avg_sq[]; };
layout(set = 0, binding = 4, std430) readonly buffer NonfiniteFlagBuffer { uint nonfinite[]; };

layout(push_constant) uniform Push {
    uint offset;
    uint len;
    uint step;
    float lr;
    float beta1;
    float beta2;
    float eps;
    float weight_decay;
    uint is_active;
} pc;

void main() {
    uint local_i = gl_GlobalInvocationID.x;
    if (local_i >= pc.len) {
        return;
    }
    uint i = pc.offset + local_i;
    if (nonfinite[0] != 0u) {
        gradient[i] = 0.0;
        return;
    }
    if (pc.is_active == 0u) {
        return;
    }

    float g = gradient[i];
    float m = pc.beta1 * exp_avg[i] + (1.0 - pc.beta1) * g;
    float v = pc.beta2 * exp_avg_sq[i] + (1.0 - pc.beta2) * g * g;
    exp_avg[i] = m;
    exp_avg_sq[i] = v;

    float bias_correction1 = 1.0 - pow(pc.beta1, float(pc.step));
    float bias_correction2 = 1.0 - pow(pc.beta2, float(pc.step));
    float denom = sqrt(v / bias_correction2) + pc.eps;
    float decayed = parameter[i] * (1.0 - pc.lr * pc.weight_decay);
    parameter[i] = decayed - pc.lr * (m / bias_correction1) / denom;
}
