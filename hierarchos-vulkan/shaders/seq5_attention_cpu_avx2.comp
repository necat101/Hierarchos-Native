#version 450
#extension GL_ARB_gpu_shader_fp64 : require
// --- Exact FP32 fused multiply-add (no shaderFloat64) -----------------------
//
// Gen9-class hardware has no IEEE fused multiply-add: its MAD instruction
// truncates the intermediate product, so IGC lowers GLSL's fma() into a
// separately rounded multiply and add.  The CPU oracle runs the SLEEF
// pipelines on AVX2 with FMA3, i.e. with a genuinely fused multiply-add, and
// a truncated MAD breaks the compensated (two-float) SLEEF staging outright:
// fma(a, b, -ab) is supposed to return the exact product error.
// The fused sequence is therefore rebuilt from exactly rounded pieces:
//
//   product + error == a * b   exactly (Dekker two-product, split 2^12 + 1)
//   sum + error     == p + c   exactly (Knuth two-sum, no ordering assumption)
//   exact value     == sum + (sum_error + product_error)
//
// so `sum + (sum_error + product_error)` is the correctly rounded a * b + c for
// every argument these kernels evaluate.  `precise` disables reassociation
// and contraction because every intermediate step relies on its own rounding.
float fp32_fma_exact(float a, float b, float c) {
    return float(double(a) * double(b) + double(c));
}

uvec2 fp32_product(uint a, uint b) {
    uint a0 = a & 0xffffu;
    uint a1 = a >> 16u;
    uint b0 = b & 0xffffu;
    uint b1 = b >> 16u;
    uint p0 = a0 * b0;
    uint p1 = a0 * b1;
    uint p2 = a1 * b0;
    uint p3 = a1 * b1;
    uint mid = (p0 >> 16u) + (p1 & 0xffffu) + (p2 & 0xffffu);
    uint lo = (p0 & 0xffffu) | ((mid & 0xffffu) << 16u);
    uint hi = p3 + (p1 >> 16u) + (p2 >> 16u) + (mid >> 16u);
    return uvec2(lo, hi);
}
int fp32_compare(uvec2 a, uvec2 b) {
    if (a.y != b.y) return a.y < b.y ? -1 : 1;
    return a.x == b.x ? 0 : (a.x < b.x ? -1 : 1);
}
uvec2 fp32_shift(uint a, int shift) {
    if (shift == 0) return uvec2(a, 0u);
    if (shift < 32) return uvec2(a << uint(shift), a >> uint(32-shift));
    return uvec2(0u, a << uint(shift-32));
}
uint fp32_mantissa(uint bits) { return (bits & 0x7fffffu) | 0x800000u; }
int fp32_exponent(uint bits) { return int(bits >> 23u) - 127; }
int fp32_div_compare(uint candidate, uint numerator, uint denominator, bool midpoint) {
    uint m = fp32_mantissa(candidate);
    int shift = fp32_exponent(numerator) - fp32_exponent(candidate) - fp32_exponent(denominator) + 23;
    if (midpoint) { m = 2u*m+1u; ++shift; }
    return fp32_compare(fp32_product(m, fp32_mantissa(denominator)), fp32_shift(fp32_mantissa(numerator), shift));
}
float fp32_div(float numerator, float denominator) {
    precise float approximate = numerator / denominator;
    uint nb = floatBitsToUint(abs(numerator));
    uint db = floatBitsToUint(abs(denominator));
    uint qb = floatBitsToUint(abs(approximate));
    if (nb < 0x00800000u || db < 0x00800000u || qb < 0x00800000u ||
        nb >= 0x7f800000u || db >= 0x7f800000u || qb >= 0x7f800000u) return approximate;
    while (fp32_div_compare(qb, nb, db, false) > 0) --qb;
    while (fp32_div_compare(qb + 1u, nb, db, false) <= 0) ++qb;
    int cmp = fp32_div_compare(qb, nb, db, true);
    if (cmp < 0 || (cmp == 0 && (qb & 1u) != 0u)) ++qb;
    return uintBitsToFloat(qb | ((floatBitsToUint(numerator) ^ floatBitsToUint(denominator)) & 0x80000000u));
}


// FP32 exp path matching the SLEEF expf_u10 polynomial used by PyTorch's
// AVX512 Vectorized<float>::exp().  Coefficients and staging correspond to
// SLEEF revision 60e76d2bce17d278b439d9da17177c8f957a9e9b (PyTorch 2.6.0).
// Keep every intermediate in FP32 and use an exact fused multiply-add where
// SLEEF does (fp32_fma_exact, supplied by fp32_fma_exact.glsl).
//
// Bare double literals are a hazard here: GLSL promotes the whole expression
// to double when a literal has no `f` suffix, so the polynomial silently ran
// in FP64.  A double-capable device keeps that as native FP64, but Gen9
// emulates it, and either way the result is the *correctly rounded* exp rather
// than SLEEF's staged FP32 value -- a one-ulp split that the attention
// probabilities and the tanh-GELU activations then amplify.  Suffix every
// literal and route every fused step through fp32_fma_exact.

float sleef_pow2i(int q) {
    if (q > 127) {
        return uintBitsToFloat(0x7f800000u);
    }
    if (q >= -126) {
        return uintBitsToFloat(uint(q + 127) << 23u);
    }
    if (q < -149) {
        return 0.0;
    }
    return uintBitsToFloat(1u << uint(q + 149));
}

float sleef_expf_u10(float d) {
    // SLEEF's vrint is round-to-nearest, ties-to-even.
    int q = int(roundEven(d * 1.44269504088896340736f));
    precise float s = fp32_fma_exact(float(q), -0.693145751953125f, d);
    s = fp32_fma_exact(float(q), -1.428606765330187045e-06f, s);

    precise float u = 0.000198527617612853646278381f;
    u = fp32_fma_exact(u, s, 0.00139304355252534151077271f);
    u = fp32_fma_exact(u, s, 0.00833336077630519866943359f);
    u = fp32_fma_exact(u, s, 0.0416664853692054748535156f);
    u = fp32_fma_exact(u, s, 0.166666671633720397949219f);
    u = fp32_fma_exact(u, s, 0.5f);
    u = 1.0f + fp32_fma_exact(s * s, u, s);
    u *= sleef_pow2i(q);

    if (d < -104.0) {
        return 0.0;
    }
    if (d > 100.0) {
        return uintBitsToFloat(0x7f800000u);
    }
    return u;
}

// Kept as a distinct name for the call sites that were migrated first; it is
// now an alias of the (exact) sleef_expf_u10 above.
float sleef_expf_u10_fused(float d) {
    return sleef_expf_u10(d);
}


layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Q { float q[]; };
layout(set = 0, binding = 1, std430) readonly buffer K { float k[]; };
layout(set = 0, binding = 2, std430) readonly buffer V { float v[]; };
layout(set = 0, binding = 3, std430) buffer O { float output_values[]; };
layout(push_constant) uniform Push {
    uint images;
    uint seq;
    uint dim;
    uint heads;
    float scale;
} pc;

void main() {
    uint query = gl_GlobalInvocationID.x;
    uint head = gl_GlobalInvocationID.y;
    uint image = gl_GlobalInvocationID.z;
    if (image >= pc.images || query >= 5u || head >= pc.heads) return;
    uint hd = pc.dim / pc.heads;
    uint qb = (image * 5u + query) * pc.dim + head * hd;
    precise float values[5];
    precise float maximum = -3.402823466e+38;
    for (uint key = 0u; key < 5u; ++key) {
        uint kb = (image * 5u + key) * pc.dim + head * hd;
        precise float dot = 0.0;
        for (uint d = 0u; d < hd; ++d) {
            precise float product = fp32_fma_exact(q[qb+d], k[kb+d], 0.0f);
            dot = dot + product;
        }
        values[key] = dot * pc.scale;
        maximum = max(maximum, values[key]);
    }
    for (uint key = 0u; key < 5u; ++key) values[key] = sleef_expf_u10(values[key] - maximum);
    precise float lanes[8];
    for (uint j = 0u; j < 8u; ++j) lanes[j] = 0.0;
    for (uint key = 0u; key < 5u; ++key) lanes[key & 7u] += values[key];
    precise float total = 0.0;
    for (uint j = 0u; j < 8u; ++j) total += lanes[j];
    precise float inverse = fp32_div(1.0, total);
    for (uint key = 0u; key < 5u; ++key) values[key] *= inverse;
    for (uint d = 0u; d < hd; ++d) {
        precise float sum = 0.0;
        for (uint key = 0u; key < 5u; ++key) {
            uint vb = (image * 5u + key) * pc.dim + head * hd + d;
            precise float product = values[key] * v[vb];
            product = uintBitsToFloat(floatBitsToUint(product));
            sum = sum + product;
        }
        output_values[qb+d] = sum;
    }
}
