#version 450
#extension GL_GOOGLE_include_directive : require
#include "fp32_sqrt_recip.glsl"
#include "fp32_v41_pow2_scale.glsl"

// DeepSeek V4.1 activation quantization, fused quantize + dequantize ("inplace"
// in the released kernel). Mirrors inference/kernel.py act_quant_kernel_ and
// fp4_quant_kernel_:
//   * one scale per contiguous block along the last axis,
//   * amax clamped to a positive floor before scaling,
//   * FP8 E4M3 or FP4 E2M1 round-to-nearest-even conversion,
//   * power-of-two (UE8M0) or E4M3 stored scales,
//   * dequantized value = decoded(value / scale) * scale in FP32.
// The reference quantizes BF16 tensors through FP32 block statistics; f32 input
// here is the same contract after BF16 promotion.
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { float x[]; };
layout(set = 0, binding = 1, std430) writeonly buffer Output { float y[]; };
layout(set = 0, binding = 2, std430) writeonly buffer Scales { uint scale_bits[]; };
layout(push_constant) uniform Push {
    uint rows;
    uint cols;
    uint block_size;
    uint mode;        // 0 = FP8 E4M3, 1 = FP4 E2M1
    uint scale_mode;  // 0 = UE8M0 power of two, 1 = E4M3
    float amax_min;
} pc;

#include "fp32_v41_quant_formats.glsl"

void main() {
    uint block = gl_GlobalInvocationID.x;
    // Rows tile across z once they exceed one dispatch axis (65,535 workgroups).
    uint row = gl_GlobalInvocationID.y + gl_WorkGroupID.z * gl_NumWorkGroups.y;
    uint blocks = (pc.cols + pc.block_size - 1u) / pc.block_size;
    if (row >= pc.rows || block >= blocks) return;
    uint base = row * pc.cols + block * pc.block_size;
    uint count = min(pc.block_size, pc.cols - block * pc.block_size);

    precise float amax = 0.0;
    for (uint i = 0u; i < count; ++i) {
        amax = max(amax, abs(x[base + i]));
    }
    amax = max(amax, pc.amax_min);

    precise float scale;
    if (pc.scale_mode == 0u) {
        // 1/448 is the released FP8 ceiling reciprocal; FP4 uses 1/6.
        float reciprocal = (pc.mode == 0u) ? (1.0 / 448.0) : (1.0 / 6.0);
        scale = round_scale_pow2(amax * reciprocal);
    } else {
        // E4M3 stored scales appear only for compressed KV; the reference
        // divides by the FP4 maximum instead of multiplying by a reciprocal.
        scale = decode_e4m3(encode_e4m3(fp32_div(amax, 6.0)));
    }
    scale_bits[row * blocks + block] = floatBitsToUint(scale);

    if (pc.mode == 0u) {
        for (uint i = 0u; i < count; ++i) {
            precise float q = clamp(v41_div_scale(x[base + i], scale), -448.0, 448.0);
            y[base + i] = decode_e4m3(encode_e4m3(q)) * scale;
        }
    } else {
        for (uint i = 0u; i < count; ++i) {
            // Native division may land one ULP below an exact format
            // midpoint for non-power-of-two E4M3 scales. Correctly round the
            // division before converting: a BF16 cache can hit these ties.
            precise float q = clamp(v41_div_scale(x[base + i], scale), -6.0, 6.0);
            y[base + i] = decode_e2m1(encode_e2m1(q)) * scale;
        }
    }
}
