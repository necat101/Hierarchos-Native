#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require

// Native-FP16 recurrent r/k/v input adjoints for a backward graph whose loss
// source was already multiplied by the trainer's GradScaler value. Unlike the
// older local-lift experiment, this kernel does not manufacture a per-product
// 1024x scale and divide it away again: the incoming adjoint is the scaled
// backward-domain value, so the half multiply sees exactly that value.
//
// Products widen immediately and accumulate in FP32. Canonical parameters,
// gradients, SafeTensors layout, and PyTorch/CUDA continuation remain FP32.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer RGradOutputBuffer { float grad_r[]; };
layout(set = 0, binding = 1, std430) readonly buffer RWeightBuffer { float wr[]; };
layout(set = 0, binding = 2, std430) readonly buffer KGradOutputBuffer { float grad_k[]; };
layout(set = 0, binding = 3, std430) readonly buffer KWeightBuffer { float wk[]; };
layout(set = 0, binding = 4, std430) readonly buffer VGradOutputBuffer { float grad_v[]; };
layout(set = 0, binding = 5, std430) readonly buffer VWeightBuffer { float wv[]; };
layout(set = 0, binding = 6, std430) writeonly buffer RGradInputBuffer { float grad_xr[]; };
layout(set = 0, binding = 7, std430) writeonly buffer KGradInputBuffer { float grad_xk[]; };
layout(set = 0, binding = 8, std430) writeonly buffer VGradInputBuffer { float grad_xv[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint input_dim;
    uint output_dim;
} pc;

float source_scaled_half_product(float grad, float weight) {
    // Deliberately do not clamp, locally rescale, or fall back to FP32 here.
    // If the trainer's current scale makes a half operand/product overflow,
    // widening preserves the non-finite result so the full-model detector can
    // skip AdamW and back the dynamic scale off exactly as GradScaler does.
    return float(float16_t(grad) * float16_t(weight));
}

void main() {
    uint in_col = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;
    if (row >= pc.rows || in_col >= pc.input_dim) {
        return;
    }

    float r_sum = 0.0;
    float k_sum = 0.0;
    float v_sum = 0.0;
    uint grad_base = row * pc.output_dim;
    for (uint out_col = 0; out_col < pc.output_dim; ++out_col) {
        uint grad_index = grad_base + out_col;
        uint weight_index = out_col * pc.input_dim + in_col;
        r_sum += source_scaled_half_product(grad_r[grad_index], wr[weight_index]);
        k_sum += source_scaled_half_product(grad_k[grad_index], wk[weight_index]);
        v_sum += source_scaled_half_product(grad_v[grad_index], wv[weight_index]);
    }

    uint output_index = row * pc.input_dim + in_col;
    grad_xr[output_index] = r_sum;
    grad_xk[output_index] = k_sum;
    grad_xv[output_index] = v_sum;
}
