#version 450

// MiniMax-M3 Lightning Indexer token scores. Unlike DeepSeek-V3.2's
// weighted multi-head reduction, M3 keeps one independent score row per
// index/KV head and performs block selection in a second kernel.
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer QBuffer { float q_values[]; };
layout(set = 0, binding = 1, std430) readonly buffer KBuffer { float k_values[]; };
// Kept in the ABI so the scorer shares the same dispatch contract as the
// selector. HF's MiniMax-M3 indexer intentionally does *not* apply the padding
// mask while ranking blocks; padding is folded into the final attention mask.
// This matters for exact left-padding parity because padded slots can affect
// which block wins a top-k slot even though those individual keys are never
// attended afterward.
layout(set = 0, binding = 2, std430) readonly buffer KeyMaskBuffer { float key_mask[]; };
layout(set = 0, binding = 3, std430) writeonly buffer ScoreBuffer { float index_scores[]; };

layout(push_constant) uniform Push {
    uint batch_size;
    uint query_seq_len;
    uint key_value_seq_len;
    uint num_heads;
    uint head_dim;
    uint query_position_offset;
    uint causal;
    uint reserved;
} pc;

void main() {
    uint key = gl_GlobalInvocationID.x;
    uint query = gl_GlobalInvocationID.y;
    uint batch_head = gl_GlobalInvocationID.z;
    if (batch_head >= pc.batch_size * pc.num_heads || query >= pc.query_seq_len || key >= pc.key_value_seq_len) {
        return;
    }

    uint batch = batch_head / pc.num_heads;
    uint head = batch_head - batch * pc.num_heads;
    uint query_row = batch * pc.query_seq_len + query;
    uint key_row = batch * pc.key_value_seq_len + key;
    uint output_index = (((batch * pc.num_heads + head) * pc.query_seq_len + query)
        * pc.key_value_seq_len) + key;
    uint absolute_query = pc.query_position_offset + query;
    if (pc.causal != 0u && key > absolute_query) {
        index_scores[output_index] = -3.402823466e+38;
        return;
    }

    uint q_base = query_row * pc.num_heads * pc.head_dim + head * pc.head_dim;
    uint k_base = key_row * pc.head_dim;
    float dot = 0.0;
    for (uint dim = 0u; dim < pc.head_dim; ++dim) {
        dot = fma(q_values[q_base + dim], k_values[k_base + dim], dot);
    }
    index_scores[output_index] = dot;
}
