#version 450
// CPU short-row non-transposed mm. Aligned tiles resume the running total;
// their boundaries never split an eight-term or four-term reduction group.
layout(local_size_x=16,local_size_y=16) in;
layout(set=0,binding=0,std430) readonly buffer Grad { float grad[]; };
layout(set=0,binding=1,std430) readonly buffer Weight { float weight[]; };
layout(set=0,binding=2,std430) buffer Output { float output_values[]; };
layout(push_constant) uniform Push { uint rows; uint input_dim; uint output_dim; uint accumulate; } pc;
void main() {
    uint col=gl_GlobalInvocationID.x,row=gl_GlobalInvocationID.y;
    if(row>=pc.rows || col>=pc.input_dim)return;
    uint dst=row*pc.input_dim+col;
    precise float total=pc.accumulate!=0u ? output_values[dst] : 0.0;
    if(pc.rows==1u) {
        for(uint base=0u;base<pc.output_dim;base+=8u) {
            precise float partial=0.0;
            for(uint k=base;k<min(base+8u,pc.output_dim);++k) {
                precise float product=grad[k]*weight[k*pc.input_dim+col];
                partial=partial+product;
            }
            total=total+partial;
        }
    } else {
        for(uint k=0u;k<pc.output_dim;k+=4u) {
            precise float p0=grad[row*pc.output_dim+k]*weight[k*pc.input_dim+col];
            precise float p1=grad[row*pc.output_dim+k+1u]*weight[(k+1u)*pc.input_dim+col];
            precise float p2=grad[row*pc.output_dim+k+2u]*weight[(k+2u)*pc.input_dim+col];
            precise float p3=grad[row*pc.output_dim+k+3u]*weight[(k+3u)*pc.input_dim+col];
            precise float pair0=p0+p1;
            precise float pair1=p2+p3;
            precise float group=pair0+pair1;
            total=total+group;
        }
    }
    output_values[dst]=total;
}
