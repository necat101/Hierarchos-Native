#version 450

// RDNA3 hardware-WMMA GEMM, full-FP16 arm.
//
//   C[m, n] = op(A)[m, k] * op(B)[k, n]      (FP16 operands, FP16 accumulation)
//
// Identical blocking, staging and masking to `wmma_gemm_f16_f32acc.comp`; the
// accumulator fragments themselves are `float16_t`, so the driver emits the
// FP16-accumulating cooperative-matrix form. Accumulation therefore loses
// mantissa bits and can overflow to infinity; the mode is only reachable from
// `--wmma-mode full-fp16`, whose documentation states the limitation. The host
// stores FP32 master parameters and computes normalization, softmax and loss
// reductions in FP32 regardless of this arm.
//
// The tile store widens the FP16 accumulators back to an FP32 output buffer so
// the surrounding graph keeps its existing FP32 activation contract.
//
// Phase LXIV split reduction
// --------------------------
//
// A single FP16 accumulator that runs over the whole reduction keeps rounding a
// large partial sum, so its absolute error grows both with the reduction length
// and with the magnitude of the running sum. This arm keeps *eight* FP16
// accumulator banks and assigns consecutive 16-wide K slices to them
// round-robin, then merges the banks once, in FP16, per output tile with a
// pairwise tree:
//
//     bank b  = slices b, b+8, b+16, ...          (FP16, RDNA3 dot2 cadence)
//     out     = ((b0+b1)+(b2+b3)) + ((b4+b5)+(b6+b7))      (FP16 additions)
//
// Every accumulator and every merge is a binary16 value, the operands are
// native FP16, and the instruction is the FP16-accumulating cooperative matrix
// multiply-add: no product and no accumulation is performed in a wider
// precision. What changes relative to the historical single-accumulator module
// is the *reduction order*. Each bank carries 1/8 of the terms, so each
// intermediate sum is roughly eight times smaller and the roundings it absorbs
// are proportionally finer relative to the final result. This is blocked
// summation -- the standard way to bound a fixed-precision reduction -- not an
// FP32 accumulation, and the module contains no FP32 accumulator fragment.
//
// The pairwise merge tree is deliberate. A left-to-right merge of eight banks
// rounds seven times with a growing partial sum; the tree rounds seven times
// with partial sums of at most half the final magnitude, so its intermediate
// roundings are one bit finer.
//
// The operand staging is the Phase LXI candidate A form: each operand is viewed
// as packed `f16vec2` words, a lane fetches a pair of adjacent halves along that
// operand's globally contiguous axis with one aligned 32-bit load, and the
// workgroup tile layout, lane coverage and row-major fragment loads are
// unchanged. Odd leading dimensions and partially in-range pairs fall back to
// two independently masked 16-bit extract loads, so the staged bytes are
// identical to the scalar path.
//
// Epilogue cost: four tiles, each needing eight fragment stores and seven FP16
// additions through workgroup memory. That is a fixed per-workgroup cost,
// independent of the reduction length, paid once rather than per K slice.

#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_memory_scope_semantics : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_16bit_storage : require

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer ABuffer { f16vec2 a[]; };
layout(set = 0, binding = 1, std430) readonly buffer BBuffer { f16vec2 b[]; };
layout(set = 0, binding = 2, std430) writeonly buffer CBuffer { float c[]; };

layout(push_constant) uniform Push {
    uint m;
    uint n;
    uint k;
    uint lda;
    uint ldb;
    uint ldc;
    uint flags;
    uint reserved;
} pc;

shared float16_t a_tile[2][256];
shared float16_t b_tile[2][256];
// Fragment staging for one accumulator bank at a time, plus the four partial
// results of the pairwise merge tree. Reused tile by tile.
shared float16_t c_tile[256];
shared float16_t c_p0[256];
shared float16_t c_p1[256];
shared float16_t c_p2[256];
shared float16_t c_p3[256];

// Store one accumulator fragment into the staging tile and wait for it.
#define STORE_BANK(bank)                                                        \
    do {                                                                       \
        coopMatStore(bank, c_tile, 0, 16, gl_CooperativeMatrixLayoutRowMajor);  \
        barrier();                                                              \
    } while (false)

// p = fragment (first bank of a pair): a plain copy, no rounding.
#define COPY_BANK(p)                                                           \
    do {                                                                       \
        for (uint e = lane; e < 256u; e += lanes) { p[e] = c_tile[e]; }         \
        barrier();                                                              \
    } while (false)

// p = fp16(p + fragment): one binary16 addition per element.
#define ADD_BANK(p)                                                            \
    do {                                                                       \
        for (uint e = lane; e < 256u; e += lanes) {                             \
            p[e] = float16_t(float(p[e]) + float(c_tile[e]));                   \
        }                                                                       \
        barrier();                                                              \
    } while (false)

// a = fp16(a + b): one binary16 addition per element.
#define PAIR_BANKS(a, b)                                                       \
    do {                                                                       \
        for (uint e = lane; e < 256u; e += lanes) {                             \
            a[e] = float16_t(float(a[e]) + float(b[e]));                        \
        }                                                                       \
        barrier();                                                              \
    } while (false)

// out = fp16(lo + hi) widened to the FP32 output buffer, with masking.
#define WRITE_TILE(lo, hi, row_base, col_base)                                 \
    do {                                                                       \
        for (uint e = lane; e < 256u; e += lanes) {                             \
            uint gm = (row_base) + (e >> 4u);                                   \
            uint gn = (col_base) + (e & 15u);                                   \
            if (gm < pc.m && gn < pc.n) {                                       \
                float16_t merged = float16_t(float(lo[e]) + float(hi[e]));       \
                c[gm * pc.ldc + gn] = float(merged);                            \
            }                                                                   \
        }                                                                       \
        barrier();                                                              \
    } while (false)

void main() {
    uint lane = gl_SubgroupInvocationID;
    uint lanes = gl_SubgroupSize;
    uint m0 = gl_WorkGroupID.y * 32u;
    uint n0 = gl_WorkGroupID.x * 32u;
    bool trans_a = (pc.flags & 1u) != 0u;
    bool trans_b = (pc.flags & 2u) != 0u;
    bool wide_a = (pc.lda & 1u) == 0u;
    bool wide_b = (pc.ldb & 1u) == 0u;

    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> a_frag0;
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> a_frag1;
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> b_frag0;
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> b_frag1;

    // Eight accumulator banks per output tile. Bank n receives K slices
    // n, n+8, n+16, ... so consecutive slices are spread across all banks.
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_0_00 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_0_01 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_0_10 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_0_11 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_1_00 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_1_01 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_1_10 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_1_11 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_2_00 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_2_01 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_2_10 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_2_11 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_3_00 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_3_01 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_3_10 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_3_11 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_4_00 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_4_01 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_4_10 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_4_11 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_5_00 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_5_01 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_5_10 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_5_11 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_6_00 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_6_01 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_6_10 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_6_11 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_7_00 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_7_01 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_7_10 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc_7_11 =
        coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(float16_t(0.0));

    uint slice = 0u;
    for (uint k0 = 0u; k0 < pc.k; k0 += 16u) {
        if (!trans_a) {
            // A row-major [m][k]: reduction axis contiguous -> pair along col.
            for (uint p = lane; p < 256u; p += lanes) {
                uint tile = p >> 7u;
                uint e = p & 127u;
                uint row = e >> 3u;
                uint col = (e & 7u) << 1u;
                uint gm = m0 + tile * 16u + row;
                uint gk = k0 + col;
                uint off = gm * pc.lda + gk;
                float16_t v0 = float16_t(0.0);
                float16_t v1 = float16_t(0.0);
                if (wide_a && gm < pc.m && gk + 1u < pc.k) {
                    f16vec2 pair = a[off >> 1u];
                    v0 = pair.x;
                    v1 = pair.y;
                } else {
                    if (gm < pc.m && gk < pc.k) {
                        v0 = a[off >> 1u][off & 1u];
                    }
                    if (gm < pc.m && gk + 1u < pc.k) {
                        uint next = off + 1u;
                        v1 = a[next >> 1u][next & 1u];
                    }
                }
                a_tile[tile][row * 16u + col] = v0;
                a_tile[tile][row * 16u + col + 1u] = v1;
            }
        } else {
            // A transposed [k][m]: output axis contiguous -> pair along row.
            for (uint p = lane; p < 256u; p += lanes) {
                uint tile = p >> 7u;
                uint e = p & 127u;
                uint row = (e >> 4u) << 1u;
                uint col = e & 15u;
                uint gm = m0 + tile * 16u + row;
                uint gk = k0 + col;
                uint off = gk * pc.lda + gm;
                float16_t v0 = float16_t(0.0);
                float16_t v1 = float16_t(0.0);
                if (wide_a && gk < pc.k && gm + 1u < pc.m) {
                    f16vec2 pair = a[off >> 1u];
                    v0 = pair.x;
                    v1 = pair.y;
                } else {
                    if (gk < pc.k && gm < pc.m) {
                        v0 = a[off >> 1u][off & 1u];
                    }
                    if (gk < pc.k && gm + 1u < pc.m) {
                        uint next = off + 1u;
                        v1 = a[next >> 1u][next & 1u];
                    }
                }
                a_tile[tile][row * 16u + col] = v0;
                a_tile[tile][row * 16u + col + 16u] = v1;
            }
        }

        if (!trans_b) {
            // B row-major [k][n]: output axis contiguous -> pair along col.
            for (uint p = lane; p < 256u; p += lanes) {
                uint tile = p >> 7u;
                uint e = p & 127u;
                uint row = e >> 3u;
                uint col = (e & 7u) << 1u;
                uint gk = k0 + row;
                uint gn = n0 + tile * 16u + col;
                uint off = gk * pc.ldb + gn;
                float16_t v0 = float16_t(0.0);
                float16_t v1 = float16_t(0.0);
                if (wide_b && gk < pc.k && gn + 1u < pc.n) {
                    f16vec2 pair = b[off >> 1u];
                    v0 = pair.x;
                    v1 = pair.y;
                } else {
                    if (gk < pc.k && gn < pc.n) {
                        v0 = b[off >> 1u][off & 1u];
                    }
                    if (gk < pc.k && gn + 1u < pc.n) {
                        uint next = off + 1u;
                        v1 = b[next >> 1u][next & 1u];
                    }
                }
                b_tile[tile][row * 16u + col] = v0;
                b_tile[tile][row * 16u + col + 1u] = v1;
            }
        } else {
            // B transposed [n][k]: reduction axis contiguous -> pair along row.
            for (uint p = lane; p < 256u; p += lanes) {
                uint tile = p >> 7u;
                uint e = p & 127u;
                uint row = (e >> 4u) << 1u;
                uint col = e & 15u;
                uint gk = k0 + row;
                uint gn = n0 + tile * 16u + col;
                uint off = gn * pc.ldb + gk;
                float16_t v0 = float16_t(0.0);
                float16_t v1 = float16_t(0.0);
                if (wide_b && gn < pc.n && gk + 1u < pc.k) {
                    f16vec2 pair = b[off >> 1u];
                    v0 = pair.x;
                    v1 = pair.y;
                } else {
                    if (gn < pc.n && gk < pc.k) {
                        v0 = b[off >> 1u][off & 1u];
                    }
                    if (gn < pc.n && gk + 1u < pc.k) {
                        uint next = off + 1u;
                        v1 = b[next >> 1u][next & 1u];
                    }
                }
                b_tile[tile][row * 16u + col] = v0;
                b_tile[tile][row * 16u + col + 16u] = v1;
            }
        }
        barrier();

        coopMatLoad(a_frag0, a_tile[0], 0, 16, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(a_frag1, a_tile[1], 0, 16, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(b_frag0, b_tile[0], 0, 16, gl_CooperativeMatrixLayoutRowMajor);
        coopMatLoad(b_frag1, b_tile[1], 0, 16, gl_CooperativeMatrixLayoutRowMajor);

        // Route the K slice to its bank. `slice` is uniform across the
        // workgroup, so this dispatch does not diverge within the wave.
        uint bank = slice & 7u;
        if (bank == 0u) {
            acc_0_00 = coopMatMulAdd(a_frag0, b_frag0, acc_0_00);
            acc_0_01 = coopMatMulAdd(a_frag0, b_frag1, acc_0_01);
            acc_0_10 = coopMatMulAdd(a_frag1, b_frag0, acc_0_10);
            acc_0_11 = coopMatMulAdd(a_frag1, b_frag1, acc_0_11);
        } else if (bank == 1u) {
            acc_1_00 = coopMatMulAdd(a_frag0, b_frag0, acc_1_00);
            acc_1_01 = coopMatMulAdd(a_frag0, b_frag1, acc_1_01);
            acc_1_10 = coopMatMulAdd(a_frag1, b_frag0, acc_1_10);
            acc_1_11 = coopMatMulAdd(a_frag1, b_frag1, acc_1_11);
        } else if (bank == 2u) {
            acc_2_00 = coopMatMulAdd(a_frag0, b_frag0, acc_2_00);
            acc_2_01 = coopMatMulAdd(a_frag0, b_frag1, acc_2_01);
            acc_2_10 = coopMatMulAdd(a_frag1, b_frag0, acc_2_10);
            acc_2_11 = coopMatMulAdd(a_frag1, b_frag1, acc_2_11);
        } else if (bank == 3u) {
            acc_3_00 = coopMatMulAdd(a_frag0, b_frag0, acc_3_00);
            acc_3_01 = coopMatMulAdd(a_frag0, b_frag1, acc_3_01);
            acc_3_10 = coopMatMulAdd(a_frag1, b_frag0, acc_3_10);
            acc_3_11 = coopMatMulAdd(a_frag1, b_frag1, acc_3_11);
        } else if (bank == 4u) {
            acc_4_00 = coopMatMulAdd(a_frag0, b_frag0, acc_4_00);
            acc_4_01 = coopMatMulAdd(a_frag0, b_frag1, acc_4_01);
            acc_4_10 = coopMatMulAdd(a_frag1, b_frag0, acc_4_10);
            acc_4_11 = coopMatMulAdd(a_frag1, b_frag1, acc_4_11);
        } else if (bank == 5u) {
            acc_5_00 = coopMatMulAdd(a_frag0, b_frag0, acc_5_00);
            acc_5_01 = coopMatMulAdd(a_frag0, b_frag1, acc_5_01);
            acc_5_10 = coopMatMulAdd(a_frag1, b_frag0, acc_5_10);
            acc_5_11 = coopMatMulAdd(a_frag1, b_frag1, acc_5_11);
        } else if (bank == 6u) {
            acc_6_00 = coopMatMulAdd(a_frag0, b_frag0, acc_6_00);
            acc_6_01 = coopMatMulAdd(a_frag0, b_frag1, acc_6_01);
            acc_6_10 = coopMatMulAdd(a_frag1, b_frag0, acc_6_10);
            acc_6_11 = coopMatMulAdd(a_frag1, b_frag1, acc_6_11);
        } else {
            acc_7_00 = coopMatMulAdd(a_frag0, b_frag0, acc_7_00);
            acc_7_01 = coopMatMulAdd(a_frag0, b_frag1, acc_7_01);
            acc_7_10 = coopMatMulAdd(a_frag1, b_frag0, acc_7_10);
            acc_7_11 = coopMatMulAdd(a_frag1, b_frag1, acc_7_11);
        }
        slice++;
        barrier();
    }

    // Tile 0: rows [m0, m0+16), columns [n0, n0+16).
    STORE_BANK(acc_0_00); COPY_BANK(c_p0);
    STORE_BANK(acc_1_00); ADD_BANK(c_p0);
    STORE_BANK(acc_2_00); COPY_BANK(c_p1);
    STORE_BANK(acc_3_00); ADD_BANK(c_p1);
    STORE_BANK(acc_4_00); COPY_BANK(c_p2);
    STORE_BANK(acc_5_00); ADD_BANK(c_p2);
    STORE_BANK(acc_6_00); COPY_BANK(c_p3);
    STORE_BANK(acc_7_00); ADD_BANK(c_p3);
    PAIR_BANKS(c_p0, c_p1);
    PAIR_BANKS(c_p2, c_p3);
    WRITE_TILE(c_p0, c_p2, m0, n0);

    // Tile 1: rows [m0, m0+16), columns [n0+16, n0+32).
    STORE_BANK(acc_0_01); COPY_BANK(c_p0);
    STORE_BANK(acc_1_01); ADD_BANK(c_p0);
    STORE_BANK(acc_2_01); COPY_BANK(c_p1);
    STORE_BANK(acc_3_01); ADD_BANK(c_p1);
    STORE_BANK(acc_4_01); COPY_BANK(c_p2);
    STORE_BANK(acc_5_01); ADD_BANK(c_p2);
    STORE_BANK(acc_6_01); COPY_BANK(c_p3);
    STORE_BANK(acc_7_01); ADD_BANK(c_p3);
    PAIR_BANKS(c_p0, c_p1);
    PAIR_BANKS(c_p2, c_p3);
    WRITE_TILE(c_p0, c_p2, m0, n0 + 16u);

    // Tile 2: rows [m0+16, m0+32), columns [n0, n0+16).
    STORE_BANK(acc_0_10); COPY_BANK(c_p0);
    STORE_BANK(acc_1_10); ADD_BANK(c_p0);
    STORE_BANK(acc_2_10); COPY_BANK(c_p1);
    STORE_BANK(acc_3_10); ADD_BANK(c_p1);
    STORE_BANK(acc_4_10); COPY_BANK(c_p2);
    STORE_BANK(acc_5_10); ADD_BANK(c_p2);
    STORE_BANK(acc_6_10); COPY_BANK(c_p3);
    STORE_BANK(acc_7_10); ADD_BANK(c_p3);
    PAIR_BANKS(c_p0, c_p1);
    PAIR_BANKS(c_p2, c_p3);
    WRITE_TILE(c_p0, c_p2, m0 + 16u, n0);

    // Tile 3: rows [m0+16, m0+32), columns [n0+16, n0+32).
    STORE_BANK(acc_0_11); COPY_BANK(c_p0);
    STORE_BANK(acc_1_11); ADD_BANK(c_p0);
    STORE_BANK(acc_2_11); COPY_BANK(c_p1);
    STORE_BANK(acc_3_11); ADD_BANK(c_p1);
    STORE_BANK(acc_4_11); COPY_BANK(c_p2);
    STORE_BANK(acc_5_11); ADD_BANK(c_p2);
    STORE_BANK(acc_6_11); COPY_BANK(c_p3);
    STORE_BANK(acc_7_11); ADD_BANK(c_p3);
    PAIR_BANKS(c_p0, c_p1);
    PAIR_BANKS(c_p2, c_p3);
    WRITE_TILE(c_p0, c_p2, m0 + 16u, n0 + 16u);
}
