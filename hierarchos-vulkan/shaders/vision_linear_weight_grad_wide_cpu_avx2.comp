#version 450
#extension GL_ARB_gpu_shader_fp64 : require
float fp32_fma_exact(float a, float b, float c) {
    return float(double(a) * double(b) + double(c));
}
// Wide shared-image dW = dY^T @ X. For output widths above 32 the CPU
// oracle uses an ascending serial FMA chain; the 32-wide K/V projection keeps
// the two-lane materialized-product tail measured on the target.
layout(local_size_x = 16, local_size_y = 16) in;
layout(set = 0, binding = 0, std430) readonly buffer X { float x[]; };
layout(set = 0, binding = 1, std430) readonly buffer DY { float dy[]; };
layout(set = 0, binding = 2, std430) buffer DW { float dw[]; };
layout(push_constant) uniform P { uint rows; uint input_dim; uint output_dim; } pc;
void main() {
    uint col = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;
    if (col >= pc.input_dim || row >= pc.output_dim) return;
    bool short_row = pc.output_dim == 32u && row >= 30u;
    precise float a = 0.0;
    precise float b = 0.0;
    for (uint j = 0u; j < pc.rows; ++j) {
        float u = dy[j * pc.output_dim + row];
        float v = x[j * pc.input_dim + col];
        if (short_row) {
            precise float product = u * v;
            if ((j & 1u) == 0u) a += product;
            else b += product;
        } else {
            a = fp32_fma_exact(u, v, a);
        }
    }
    dw[row * pc.input_dim + col] = a + b;
}
