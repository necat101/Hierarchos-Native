#version 450

// Intel Gen9 (HD Graphics 520-class) variant of linear_bias_forward.
//
// Identical contract and arithmetic to linear_forward_intel_gen9, plus the
// portable kernel's `sum + bias[out_col]` epilogue in that operand order.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer { float x[]; };
layout(set = 0, binding = 1, std430) readonly buffer WeightBuffer { float weight[]; };
layout(set = 0, binding = 2, std430) readonly buffer BiasBuffer { float bias[]; };
layout(set = 0, binding = 3, std430) writeonly buffer OutputBuffer { float output_values[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint input_dim;
    uint output_dim;
} pc;

const uint INPUT_TILE = 32u;
shared float input_tile[16u * 33u];
shared float weight_tile[INPUT_TILE * 17u];

void main() {
    uint local_x = gl_LocalInvocationID.x;
    uint local_y = gl_LocalInvocationID.y;
    uint out_col = gl_WorkGroupID.x * 16u + local_x;
    uint row = gl_WorkGroupID.y * 16u + local_y;
    bool lane_valid = row < pc.rows && out_col < pc.output_dim;
    float sum = 0.0;

    for (uint k_base = 0u; k_base < pc.input_dim; k_base += INPUT_TILE) {
        uint load_k = k_base + local_x * 2u;
        uint input_slot = local_y * 33u + local_x * 2u;
        input_tile[input_slot] =
            row < pc.rows && load_k < pc.input_dim
                ? x[row * pc.input_dim + load_k] : 0.0;
        input_tile[input_slot + 1u] =
            row < pc.rows && load_k + 1u < pc.input_dim
                ? x[row * pc.input_dim + load_k + 1u] : 0.0;

        uint weight_col = gl_WorkGroupID.x * 16u + local_y;
        uint weight_slot = local_x * 2u * 17u + local_y;
        weight_tile[weight_slot] =
            weight_col < pc.output_dim && load_k < pc.input_dim
                ? weight[weight_col * pc.input_dim + load_k] : 0.0;
        weight_tile[weight_slot + 17u] =
            weight_col < pc.output_dim && load_k + 1u < pc.input_dim
                ? weight[weight_col * pc.input_dim + load_k + 1u] : 0.0;

        barrier();
        if (lane_valid) {
            uint count = min(INPUT_TILE, pc.input_dim - k_base);
            for (uint k = 0u; k < count; ++k) {
                sum = fma(input_tile[local_y * 33u + k],
                          weight_tile[k * 17u + local_x], sum);
            }
        }
        barrier();
    }

    if (lane_valid) {
        uint output_index = row * pc.output_dim + out_col;
        output_values[output_index] = sum + bias[out_col];
    }
}
