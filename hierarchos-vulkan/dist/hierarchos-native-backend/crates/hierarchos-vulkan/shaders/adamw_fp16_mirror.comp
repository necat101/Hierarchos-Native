#version 450

// AdamW for FP32 master parameters/moments with an FP16 execution mirror
// written from the post-update values in the same invocation. One shader lane
// owns one packed u32 word (two logical parameters), avoiding the inter-dispatch
// RAW barrier and second parameter read required by a separate mirror refresh.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer ParameterBuffer { float parameter[]; };
layout(set = 0, binding = 1, std430) readonly buffer GradientBuffer { float gradient[]; };
layout(set = 0, binding = 2, std430) buffer ExpAvgBuffer { float exp_avg[]; };
layout(set = 0, binding = 3, std430) buffer ExpAvgSqBuffer { float exp_avg_sq[]; };
layout(set = 0, binding = 4, std430) writeonly buffer PackedMirrorBuffer { uint packed_mirror[]; };

layout(push_constant) uniform Push {
    uint len;
    uint step;
    float lr;
    float beta1;
    float beta2;
    float eps;
    float weight_decay;
} pc;

uint fp32_to_fp16_rne(float value) {
    uint bits = floatBitsToUint(value);
    uint sign = (bits >> 16u) & 0x8000u;
    uint exponent = (bits >> 23u) & 0xffu;
    uint mantissa = bits & 0x7fffffu;

    if (exponent == 0xffu) {
        return sign | (mantissa == 0u ? 0x7c00u : 0x7e00u);
    }
    if (exponent == 0u) {
        return sign;
    }

    int unbiased = int(exponent) - 127;
    if (unbiased > 15) {
        return sign | 0x7c00u;
    }

    if (unbiased >= -14) {
        uint half_exponent = uint(unbiased + 15) << 10u;
        uint rounded_mantissa = mantissa >> 13u;
        uint remainder = mantissa & 0x1fffu;
        if (remainder > 0x1000u ||
            (remainder == 0x1000u && (rounded_mantissa & 1u) != 0u)) {
            rounded_mantissa += 1u;
        }
        if (rounded_mantissa == 0x400u) {
            rounded_mantissa = 0u;
            half_exponent += 0x400u;
            if (half_exponent >= 0x7c00u) {
                return sign | 0x7c00u;
            }
        }
        return sign | half_exponent | rounded_mantissa;
    }

    if (unbiased < -25) {
        return sign;
    }
    uint significand = 0x800000u | mantissa;
    uint shift = uint(-unbiased - 1);
    uint rounded = significand >> shift;
    uint remainder_mask = (1u << shift) - 1u;
    uint remainder = significand & remainder_mask;
    uint halfway = 1u << (shift - 1u);
    if (remainder > halfway || (remainder == halfway && (rounded & 1u) != 0u)) {
        rounded += 1u;
    }
    return sign | rounded;
}

uint pack_fp16_rne(float first, float second) {
    return fp32_to_fp16_rne(first) | (fp32_to_fp16_rne(second) << 16u);
}

float update_parameter(uint i, float bias_correction1, float bias_correction2) {
    float g = gradient[i];
    float m = pc.beta1 * exp_avg[i] + (1.0 - pc.beta1) * g;
    float v = pc.beta2 * exp_avg_sq[i] + (1.0 - pc.beta2) * g * g;
    exp_avg[i] = m;
    exp_avg_sq[i] = v;

    float denom = sqrt(v / bias_correction2) + pc.eps;
    float decayed = parameter[i] * (1.0 - pc.lr * pc.weight_decay);
    float updated = decayed - pc.lr * (m / bias_correction1) / denom;
    parameter[i] = updated;
    return updated;
}

void main() {
    uint word = gl_GlobalInvocationID.x;
    uint first = word * 2u;
    if (first >= pc.len) {
        return;
    }

    float bias_correction1 = 1.0 - pow(pc.beta1, float(pc.step));
    float bias_correction2 = 1.0 - pow(pc.beta2, float(pc.step));
    float first_value = update_parameter(first, bias_correction1, bias_correction2);
    float second_value = first + 1u < pc.len
        ? update_parameter(first + 1u, bias_correction1, bias_correction2)
        : 0.0;
    packed_mirror[word] = pack_fp16_rne(first_value, second_value);
}
