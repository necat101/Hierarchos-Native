#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer GradOutputBuffer { float grad_output_values[]; };
layout(set = 0, binding = 1, std430) readonly buffer DoraScaleBuffer { float dora_scale_values[]; };
layout(set = 0, binding = 2, std430) writeonly buffer OutputBuffer { float output_values[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint dim;
    float multiplier;
    float scale_offset;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint len = pc.rows * pc.dim;
    if (i >= len) return;
    uint col = i % pc.dim;
    output_values[i] = grad_output_values[i]
        * (dora_scale_values[col] + pc.scale_offset)
        * pc.multiplier;
}
