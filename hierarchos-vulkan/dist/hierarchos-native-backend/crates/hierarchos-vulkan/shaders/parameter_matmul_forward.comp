#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer { float x[]; };
layout(set = 0, binding = 1, std430) readonly buffer WeightBuffer { float weight[]; };
layout(set = 0, binding = 2, std430) writeonly buffer OutputBuffer { float output_values[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint input_dim;
    uint output_dim;
} pc;

void main() {
    uint out_col = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;
    if (row >= pc.rows || out_col >= pc.output_dim) {
        return;
    }

    float sum = 0.0;
    uint x_base = row * pc.input_dim;
    for (uint in_col = 0; in_col < pc.input_dim; ++in_col) {
        sum = fma(
            x[x_base + in_col],
            weight[in_col * pc.output_dim + out_col],
            sum
        );
    }
    output_values[row * pc.output_dim + out_col] = sum;
}
