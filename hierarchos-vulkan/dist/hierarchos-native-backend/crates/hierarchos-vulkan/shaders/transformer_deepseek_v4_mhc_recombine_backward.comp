#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer HyperBuffer { float hyper_values[]; };
layout(set = 0, binding = 1, std430) readonly buffer PostBuffer { float post_values[]; };
layout(set = 0, binding = 2, std430) readonly buffer CombBuffer { float comb_values[]; };
layout(set = 0, binding = 3, std430) readonly buffer BranchBuffer { float branch_values[]; };
layout(set = 0, binding = 4, std430) readonly buffer GradOutputBuffer { float grad_output[]; };
layout(set = 0, binding = 5, std430) writeonly buffer GradPostBuffer { float grad_post[]; };
layout(set = 0, binding = 6, std430) writeonly buffer GradCombBuffer { float grad_comb[]; };
layout(set = 0, binding = 7, std430) writeonly buffer GradBranchBuffer { float grad_branch[]; };
layout(set = 0, binding = 8, std430) writeonly buffer GradHyperBuffer { float grad_hyper[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint hidden_size;
    uint hc_mult;
    uint sinkhorn_iters;
    float hc_eps;
} pc;

void main() {
    uint index = gl_GlobalInvocationID.x;
    uint hyper_width = pc.hc_mult * pc.hidden_size;
    uint hyper_len = pc.rows * hyper_width;
    uint branch_len = pc.rows * pc.hidden_size;
    uint post_len = pc.rows * pc.hc_mult;
    uint comb_len = pc.rows * pc.hc_mult * pc.hc_mult;

    if (index < hyper_len) {
        uint row = index / hyper_width;
        uint within = index % hyper_width;
        uint source = within / pc.hidden_size;
        uint hidden = within % pc.hidden_size;
        uint grad_base = row * hyper_width + hidden;
        uint comb_base = row * pc.hc_mult * pc.hc_mult + source * pc.hc_mult;
        float sum = 0.0;
        for (uint dest = 0; dest < pc.hc_mult; ++dest) {
            sum += comb_values[comb_base + dest]
                * grad_output[grad_base + dest * pc.hidden_size];
        }
        grad_hyper[index] = sum;
    }
    if (index < branch_len) {
        uint row = index / pc.hidden_size;
        uint hidden = index % pc.hidden_size;
        uint grad_base = row * hyper_width + hidden;
        float sum = 0.0;
        for (uint dest = 0; dest < pc.hc_mult; ++dest) {
            sum += post_values[row * pc.hc_mult + dest]
                * grad_output[grad_base + dest * pc.hidden_size];
        }
        grad_branch[index] = sum;
    }
    if (index < post_len) {
        uint row = index / pc.hc_mult;
        uint dest = index % pc.hc_mult;
        uint grad_base = row * hyper_width + dest * pc.hidden_size;
        uint branch_base = row * pc.hidden_size;
        float sum = 0.0;
        for (uint hidden = 0; hidden < pc.hidden_size; ++hidden) {
            sum += grad_output[grad_base + hidden] * branch_values[branch_base + hidden];
        }
        grad_post[index] = sum;
    }
    if (index < comb_len) {
        uint matrix = pc.hc_mult * pc.hc_mult;
        uint row = index / matrix;
        uint within = index % matrix;
        uint source = within / pc.hc_mult;
        uint dest = within % pc.hc_mult;
        uint hyper_base = row * hyper_width + source * pc.hidden_size;
        uint grad_base = row * hyper_width + dest * pc.hidden_size;
        float sum = 0.0;
        for (uint hidden = 0; hidden < pc.hidden_size; ++hidden) {
            sum += grad_output[grad_base + hidden] * hyper_values[hyper_base + hidden];
        }
        grad_comb[index] = sum;
    }
}
