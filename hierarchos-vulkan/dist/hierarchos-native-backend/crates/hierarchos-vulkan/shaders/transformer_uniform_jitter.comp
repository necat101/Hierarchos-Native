#version 450

layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer InputValues { float input_values[]; };
layout(set = 0, binding = 1, std430) buffer OutputValues { float output_values[]; };
layout(push_constant) uniform PushConstants {
    uint len;
    uint seed;
    uint site;
    uint step;
    float amplitude;
} pc;

// The same Philox4x32-10 key/counter convention as canonical_dropout.comp.
uint canonical_word(uint index) {
    uvec4 counter = uvec4((index >> 2u) | (pc.step << 30u), pc.step >> 2u, 0u, 0u);
    uvec2 key = uvec2(pc.seed, pc.site);
    for (uint round_index = 0u; round_index < 10u; ++round_index) {
        uint hi0, lo0, hi1, lo1;
        umulExtended(0xD2511F53u, counter.x, hi0, lo0);
        umulExtended(0xCD9E8D57u, counter.z, hi1, lo1);
        counter = uvec4(hi1 ^ counter.y ^ key.x, lo1, hi0 ^ counter.w ^ key.y, lo0);
        key += uvec2(0x9E3779B9u, 0xBB67AE85u);
    }
    return counter[index & 3u];
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pc.len) return;
    // Exactly representable 24-bit uniform in [0, 1); replay this multiplier
    // on the input adjoint in backward, without saving a random-number tape.
    float uniform_value = float(canonical_word(index) >> 8u) * (1.0 / 16777216.0);
    float multiplier = (1.0 - pc.amplitude) + (2.0 * pc.amplitude) * uniform_value;
    output_values[index] = input_values[index] * multiplier;
}
