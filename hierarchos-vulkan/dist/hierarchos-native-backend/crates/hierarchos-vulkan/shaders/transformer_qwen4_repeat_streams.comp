#version 450

// HF Qwen4-Exp starts the residual hyper-state with
// inputs_embeds.repeat(1, 1, hc_count), i.e. whole hidden vectors repeated in
// stream-major order along the final dimension.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer { float input_values[]; };
layout(set = 0, binding = 1, std430) writeonly buffer OutputBuffer { float output_values[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint hidden_size;
    uint hc_count;
} pc;

void main() {
    uint index = gl_GlobalInvocationID.x;
    uint hyper_width = pc.hidden_size * pc.hc_count;
    uint len = pc.rows * hyper_width;
    if (index >= len) return;

    uint row = index / hyper_width;
    uint hidden = index % pc.hidden_size;
    output_values[index] = input_values[row * pc.hidden_size + hidden];
}
