#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer PackedStateBuffer { float packed_state[]; };
layout(set = 0, binding = 1, std430) writeonly buffer HiddenBuffer { float hidden[]; };

layout(push_constant) uniform Push {
    uint vector_len;
    uint state_size;
    uint slot;
} pc;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pc.vector_len) {
        return;
    }
    hidden[index] = packed_state[index * pc.state_size + pc.slot];
}
