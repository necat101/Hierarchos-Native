#version 450

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer ProjectedBuffer { float projected[]; };
layout(set = 0, binding = 1, std430) readonly buffer ActiveBuffer { float active_rows[]; };
layout(set = 0, binding = 2, std430) writeonly buffer NextActiveBuffer { float next_active_rows[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint dim;
    float delta_scale;
    float conv_atol;
} pc;

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.rows) {
        return;
    }
    if (active_rows[row] <= 0.0) {
        next_active_rows[row] = 0.0;
        return;
    }
    uint base = row * pc.dim;
    float abs_sum = 0.0;
    for (uint col = 0u; col < pc.dim; ++col) {
        abs_sum += abs(tanh(projected[base + col]) * pc.delta_scale);
    }
    float mean_abs = abs_sum / float(pc.dim);
    next_active_rows[row] = mean_abs >= pc.conv_atol ? 1.0 : 0.0;
}
