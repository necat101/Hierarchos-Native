#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer { float input_values[]; };
layout(set = 0, binding = 1, std430) writeonly buffer OutputBuffer { float output_values[]; };

layout(push_constant) uniform Push {
    uint len;
    float limit;
} pc;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pc.len) {
        return;
    }
    float value = input_values[index];
    // torch.clamp preserves NaNs, while infinities saturate to the finite
    // endpoints. Keep that distinction explicit instead of relying on GLSL's
    // implementation-defined NaN behavior in min/max.
    output_values[index] = isnan(value) ? value : clamp(value, -pc.limit, pc.limit);
}
