#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer { float x[]; };
layout(set = 0, binding = 1, std430) writeonly buffer OutputBuffer { float output_values[]; };

layout(push_constant) uniform Push { uint len; } pc;

float stable_sigmoid(float value) {
    if (value >= 0.0) {
        return 1.0 / (1.0 + exp(-value));
    }
    float e = exp(value);
    return e / (1.0 + e);
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pc.len) {
        return;
    }
    output_values[index] = stable_sigmoid(x[index]);
}
