#version 450

// Convert per-workgroup digit counts into absolute scatter offsets. There are
// only sixteen radix buckets, so one 16-lane workgroup can deterministically
// build global bucket bases while each lane scans block counts for one digit.
layout(local_size_x = 16, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer HistogramBuffer { uint block_histograms[]; };
layout(set = 0, binding = 1, std430) buffer OffsetBuffer { uint block_offsets[]; };

layout(push_constant) uniform Push {
    uint token_count;
    uint shift;
    uint block_count;
    uint source_is_identity;
} pc;

const uint RADIX_BUCKETS = 16u;
shared uint digit_totals[RADIX_BUCKETS];
shared uint digit_bases[RADIX_BUCKETS];

void main() {
    uint digit = gl_LocalInvocationID.x;
    uint total = 0u;
    for (uint block = 0u; block < pc.block_count; ++block) {
        total += block_histograms[block * RADIX_BUCKETS + digit];
    }
    digit_totals[digit] = total;
    barrier();

    if (digit == 0u) {
        uint base = 0u;
        for (uint bucket = 0u; bucket < RADIX_BUCKETS; ++bucket) {
            digit_bases[bucket] = base;
            base += digit_totals[bucket];
        }
    }
    barrier();

    uint cursor = digit_bases[digit];
    for (uint block = 0u; block < pc.block_count; ++block) {
        uint slot = block * RADIX_BUCKETS + digit;
        block_offsets[slot] = cursor;
        cursor += block_histograms[slot];
    }
}
