#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer GateBuffer { float gate_values[]; };
layout(set = 0, binding = 1, std430) readonly buffer UpBuffer { float up_values[]; };
layout(set = 0, binding = 2, std430) writeonly buffer OutputBuffer { float output_values[]; };

layout(push_constant) uniform Push { uint len; } pc;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pc.len) return;

    // Matches Transformers' GptOssExperts exactly:
    //   gate = clamp(gate, max=7)
    //   up = clamp(up, min=-7, max=7)
    //   glu = gate * sigmoid(1.702 * gate)
    //   output = (up + 1) * glu
    float gate = min(gate_values[index], 7.0);
    float up = clamp(up_values[index], -7.0, 7.0);
    float sigmoid_gate = 1.0 / (1.0 + exp(-1.702 * gate));
    output_values[index] = (up + 1.0) * gate * sigmoid_gate;
}
