#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer HyperBuffer { float hyper_values[]; };
layout(set = 0, binding = 1, std430) readonly buffer PreBuffer { float pre_values[]; };
layout(set = 0, binding = 2, std430) writeonly buffer OutputBuffer { float output_values[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint hidden_size;
    uint hc_mult;
    uint sinkhorn_iters;
    float hc_eps;
} pc;

void main() {
    uint index = gl_GlobalInvocationID.x;
    uint len = pc.rows * pc.hidden_size;
    if (index >= len) return;
    uint row = index / pc.hidden_size;
    uint hidden = index % pc.hidden_size;
    uint hyper_width = pc.hc_mult * pc.hidden_size;
    float sum = 0.0;
    for (uint stream = 0; stream < pc.hc_mult; ++stream) {
        sum += pre_values[row * pc.hc_mult + stream]
            * hyper_values[row * hyper_width + stream * pc.hidden_size + hidden];
    }
    output_values[index] = sum;
}
