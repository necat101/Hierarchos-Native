#version 450

// Device-resident source scaling for interleaved records. This is deliberately
// separate from gradient_scale_from_buffer.comp so the optimizer's compact
// contiguous-scale ABI remains unchanged. The first consumer is the fifth
// scalar of each streaming CE row record: forward owns fields 0..3 while field
// 4 carries the exact backward-source coefficient.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer ValueBuffer {
    float values[];
};

layout(set = 0, binding = 1, std430) readonly buffer ScaleBuffer {
    float scale[];
};

layout(push_constant) uniform Push {
    uint len;
    uint stride;
    uint offset;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.len) {
        return;
    }
    values[pc.offset + i * pc.stride] *= scale[0];
}
