#version 450

// Exact adjoint for fixed-offset learned positions. The destination gradient
// buffer is cleared before this dispatch, so the reserved rows remain zero.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer GradOutputBuffer { float grad_output[]; };
layout(set = 0, binding = 1, std430) buffer GradPositionBuffer { float grad_position[]; };

layout(push_constant) uniform Push {
    uint batch_size;
    uint seq_len;
    uint dim;
    uint offset;
    float embedding_scale;
} pc;

void main() {
    uint col = gl_GlobalInvocationID.x;
    uint position = gl_GlobalInvocationID.y;
    if (position >= pc.seq_len || col >= pc.dim) return;

    float sum = 0.0;
    for (uint batch = 0u; batch < pc.batch_size; ++batch) {
        uint row = batch * pc.seq_len + position;
        sum += grad_output[row * pc.dim + col];
    }
    grad_position[(position + pc.offset) * pc.dim + col] = sum;
}
