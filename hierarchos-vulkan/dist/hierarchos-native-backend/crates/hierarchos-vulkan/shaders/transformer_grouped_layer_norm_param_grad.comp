#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer GradOutputBuffer { float grad_output[]; };
layout(set = 0, binding = 1, std430) readonly buffer InputBuffer { float x[]; };
layout(set = 0, binding = 2, std430) readonly buffer MeanBuffer { float mean_values[]; };
layout(set = 0, binding = 3, std430) readonly buffer RstdBuffer { float rstd_values[]; };
layout(set = 0, binding = 4, std430) writeonly buffer GradWeightBuffer { float grad_weight[]; };
layout(set = 0, binding = 5, std430) writeonly buffer GradBiasBuffer { float grad_bias[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint dim;
    uint parameter_groups;
} pc;

void main() {
    uint parameter_index = gl_GlobalInvocationID.x;
    uint parameter_count = pc.dim * pc.parameter_groups;
    if (parameter_index >= parameter_count) {
        return;
    }
    uint group = parameter_index / pc.dim;
    uint col = parameter_index % pc.dim;
    float dw = 0.0;
    float db = 0.0;
    for (uint row = group; row < pc.rows; row += pc.parameter_groups) {
        uint index = row * pc.dim + col;
        float dy = grad_output[index];
        float xhat = (x[index] - mean_values[row]) * rstd_values[row];
        dw += dy * xhat;
        db += dy;
    }
    grad_weight[parameter_index] = dw;
    grad_bias[parameter_index] = db;
}
