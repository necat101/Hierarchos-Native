#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer PackedBuffer { uint packed[]; };
layout(set = 0, binding = 1, std430) writeonly buffer OutputBuffer { float output_values[]; };

layout(push_constant) uniform Push { uint len; } pc;

void main() {
    uint word = gl_GlobalInvocationID.x;
    uint first = word * 2u;
    if (first >= pc.len) {
        return;
    }
    uint bits = packed[word];
    output_values[first] = uintBitsToFloat((bits & 0xffffu) << 16u);
    if (first + 1u < pc.len) {
        output_values[first + 1u] = uintBitsToFloat(bits & 0xffff0000u);
    }
}
