#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer GradientValues {
    float gradient_values[];
};

layout(set = 0, binding = 1, std430) buffer NonfiniteFlag {
    uint nonfinite_flag;
};

layout(push_constant) uniform PushConstants {
    uint len;
} pc;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pc.len) {
        return;
    }
    float value = gradient_values[index];
    if (isnan(value) || isinf(value)) {
        atomicOr(nonfinite_flag, 1u);
    }
}
