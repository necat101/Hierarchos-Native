#version 450

// Scale an in-place gradient from one indexed scalar in a device-resident
// control buffer, with an optional host-known multiplier. Dynamic AMP clipping
// uses this to consume GradScaler's current unscale factor without mirroring
// the scale back to Rust between optimizer windows.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer GradientBuffer {
    float gradient[];
};

layout(set = 0, binding = 1, std430) readonly buffer ScaleBuffer {
    float scale[];
};

layout(push_constant) uniform Push {
    uint len;
    uint scale_index;
    float multiplier;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.len) {
        return;
    }
    gradient[i] *= scale[pc.scale_index] * pc.multiplier;
}
