#version 450

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer TokenBuffer { uint token_ids[]; };
layout(set = 0, binding = 1, std430) readonly buffer GradEmbeddingBuffer { float grad_embedding[]; };
layout(set = 0, binding = 2, std430) buffer GradWeightBuffer { float grad_weight[]; };

layout(push_constant) uniform Push {
    uint token_count;
    uint dim;
    uint vocab_size;
    uint padding_idx;
} pc;

void main() {
    uint col = gl_GlobalInvocationID.x;
    uint position = gl_GlobalInvocationID.y;
    if (position >= pc.token_count || col >= pc.dim) {
        return;
    }
    uint token = token_ids[position];
    if (token >= pc.vocab_size || token == pc.padding_idx) {
        return;
    }

    // Elect exactly one invocation for every active (token, column) target.
    // The elected writer then visits repeated-token contributors in source
    // order. This makes FP32 association independent of workgroup scheduling
    // while retaining sparse work proportional to the active token batch.
    for (uint previous = 0u; previous < position; ++previous) {
        if (token_ids[previous] == token) {
            return;
        }
    }

    float gradient = 0.0;
    for (uint source = position; source < pc.token_count; ++source) {
        if (token_ids[source] == token) {
            gradient += grad_embedding[source * pc.dim + col];
        }
    }
    grad_weight[token * pc.dim + col] += gradient;
}
