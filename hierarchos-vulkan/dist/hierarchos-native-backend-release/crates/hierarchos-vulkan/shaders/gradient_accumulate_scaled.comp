#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer AccumulatorBuffer { float accumulator[]; };
layout(set = 0, binding = 1, std430) readonly buffer GradientBuffer { float gradient[]; };

layout(push_constant) uniform Push {
    uint len;
    float scale;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.len) {
        return;
    }
    accumulator[i] += gradient[i] * pc.scale;
}
