#version 450

// Deterministic scalar reduction for small control-plane vectors. A single
// invocation deliberately preserves left-to-right FP32 accumulation order so
// portable PyTorch/Vulkan controller metadata does not acquire tree-reduction
// rounding differences just to avoid a batch-sized host readback.
layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer {
    float values[];
};
layout(set = 0, binding = 1, std430) writeonly buffer OutputBuffer {
    float total[];
};

layout(push_constant) uniform Push {
    uint len;
} pc;

void main() {
    precise float sum = 0.0;
    for (uint i = 0u; i < pc.len; ++i) {
        sum += values[i];
    }
    total[0] = sum;
}
