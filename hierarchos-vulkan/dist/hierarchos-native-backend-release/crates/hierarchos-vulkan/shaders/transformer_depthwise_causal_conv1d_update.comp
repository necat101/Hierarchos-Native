#version 450

// Single-token cached depthwise causal Conv1D update for Qwen hybrid
// linear-attention blocks. The cache layout is token-major [kernel, channels]
// ordered oldest -> newest. Each invocation owns one channel, shifts only that
// channel's cache entries, appends the current projected Q/K/V value, and emits
// the activated convolution result for that channel.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer { float input_values[]; };
layout(set = 0, binding = 1, std430) readonly buffer WeightBuffer { float weight_values[]; };
layout(set = 0, binding = 2, std430) buffer StateBuffer { float state_values[]; };
layout(set = 0, binding = 3, std430) writeonly buffer OutputBuffer { float output_values[]; };

layout(push_constant) uniform Push {
    uint channels;
    uint kernel_size;
    uint activation;
} pc;

float activate(float value) {
    if (pc.activation == 1u) {
        return value / (1.0 + exp(-value));
    }
    return value;
}

void main() {
    uint channel = gl_GlobalInvocationID.x;
    if (channel >= pc.channels) return;

    for (uint tap = 0u; tap + 1u < pc.kernel_size; ++tap) {
        state_values[tap * pc.channels + channel] =
            state_values[(tap + 1u) * pc.channels + channel];
    }
    state_values[(pc.kernel_size - 1u) * pc.channels + channel] = input_values[channel];

    float sum = 0.0;
    for (uint tap = 0u; tap < pc.kernel_size; ++tap) {
        sum = fma(
            state_values[tap * pc.channels + channel],
            weight_values[channel * pc.kernel_size + tap],
            sum
        );
    }
    output_values[channel] = activate(sum);
}
