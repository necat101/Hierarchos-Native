#version 450

// GLM-5.3 KDA gate preparation.
// The forget gate is vector-valued per head/channel while beta is scalar per
// head.  This mirrors Glm5NextTextForgetGate + sigmoid(b_proj(x)).
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer ForgetBuffer { float forget_values[]; };
layout(set = 0, binding = 1, std430) readonly buffer BetaLogitBuffer { float beta_logits[]; };
layout(set = 0, binding = 2, std430) readonly buffer ALogBuffer { float a_log_values[]; };
layout(set = 0, binding = 3, std430) readonly buffer DtBiasBuffer { float dt_bias_values[]; };
layout(set = 0, binding = 4, std430) writeonly buffer DecayBuffer { float decay_values[]; };
layout(set = 0, binding = 5, std430) writeonly buffer BetaBuffer { float beta_values[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint num_heads;
    uint head_dim;
    uint has_lower_bound;
    float lower_bound;
} pc;

float stable_softplus(float x) {
    return max(x, 0.0) + log(1.0 + exp(-abs(x)));
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    uint channels = pc.num_heads * pc.head_dim;
    uint total = pc.rows * channels;
    if (index < total) {
        uint channel = index % channels;
        uint head = channel / pc.head_dim;
        float u = forget_values[index] + dt_bias_values[channel];
        float rate = exp(a_log_values[head]);
        if (pc.has_lower_bound != 0u) {
            float s = 1.0 / (1.0 + exp(-(rate * u)));
            decay_values[index] = pc.lower_bound * s;
        } else {
            decay_values[index] = -rate * stable_softplus(u);
        }
    }
    uint beta_total = pc.rows * pc.num_heads;
    if (index < beta_total) {
        beta_values[index] = 1.0 / (1.0 + exp(-beta_logits[index]));
    }
}
