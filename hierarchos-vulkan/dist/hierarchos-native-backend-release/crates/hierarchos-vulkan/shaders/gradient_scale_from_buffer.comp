#version 450

// Device-controlled companion to gradient_scale.comp. The scale is produced by
// gradient_clip_coefficient.comp in the same command stream, so the CPU never
// has to materialize the global norm before AdamW can proceed.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) buffer GradientBuffer {
    float gradient[];
};

layout(set = 0, binding = 1, std430) readonly buffer ScaleBuffer {
    float scale[];
};

layout(push_constant) uniform Push {
    uint len;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.len) {
        return;
    }
    gradient[i] *= scale[0];
}
