#version 450

// Stable per-digit scatter. Global stability comes from block-order prefix
// offsets. Within each 256-position block, the first sixteen lanes each own one
// digit and walk the cached source block monotonically, emitting matching
// positions in source order. Equal full keys therefore retain original source
// order across every LSD pass without a quadratic per-position rank scan.
layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer TokenBuffer { uint token_ids[]; };
layout(set = 0, binding = 1, std430) readonly buffer SourcePositionBuffer { uint source_positions[]; };
layout(set = 0, binding = 2, std430) readonly buffer OffsetBuffer { uint block_offsets[]; };
layout(set = 0, binding = 3, std430) buffer DestinationPositionBuffer { uint destination_positions[]; };

layout(push_constant) uniform Push {
    uint token_count;
    uint shift;
    uint block_count;
    uint source_is_identity;
} pc;

const uint RADIX_BUCKETS = 16u;
const uint RADIX_BLOCK_SIZE = 256u;
shared uint local_digits[RADIX_BLOCK_SIZE];
shared uint local_sources[RADIX_BLOCK_SIZE];

void main() {
    uint lane = gl_LocalInvocationID.x;
    uint block = gl_WorkGroupID.x;
    uint index = block * RADIX_BLOCK_SIZE + lane;
    bool is_active = block < pc.block_count && index < pc.token_count;
    uint source = 0u;
    uint digit = 0xffffffffu;
    if (is_active) {
        source = pc.source_is_identity != 0u ? index : source_positions[index];
        digit = (token_ids[source] >> pc.shift) & (RADIX_BUCKETS - 1u);
    }
    local_digits[lane] = digit;
    local_sources[lane] = source;
    barrier();

    if (lane >= RADIX_BUCKETS || block >= pc.block_count) {
        return;
    }

    uint destination = block_offsets[block * RADIX_BUCKETS + lane];
    uint block_start = block * RADIX_BLOCK_SIZE;
    uint block_length = min(RADIX_BLOCK_SIZE, pc.token_count - block_start);
    for (uint local_index = 0u; local_index < block_length; ++local_index) {
        if (local_digits[local_index] == lane) {
            destination_positions[destination] = local_sources[local_index];
            ++destination;
        }
    }
}
