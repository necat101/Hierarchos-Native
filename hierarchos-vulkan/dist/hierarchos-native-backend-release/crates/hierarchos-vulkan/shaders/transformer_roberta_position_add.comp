#version 450

// RoBERTa/XLM-RoBERTa learned absolute positions are generated from input IDs,
// not from the attention mask. Non-padding tokens receive cumulative positions
// starting at padding_idx + 1; padding tokens read the embedding padding row.
layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer TokenEmbeddingBuffer { float token_values[]; };
layout(set = 0, binding = 1, std430) readonly buffer PositionEmbeddingBuffer { float position_values[]; };
layout(set = 0, binding = 2, std430) readonly buffer TokenIdBuffer { uint token_ids[]; };
layout(set = 0, binding = 3, std430) writeonly buffer OutputBuffer { float output_values[]; };

layout(push_constant) uniform Push {
    uint batch_size;
    uint seq_len;
    uint dim;
    uint table_rows;
    uint padding_idx;
    float embedding_scale;
} pc;

void main() {
    uint col = gl_GlobalInvocationID.x;
    uint row = gl_GlobalInvocationID.y;
    uint rows = pc.batch_size * pc.seq_len;
    if (row >= rows || col >= pc.dim) return;

    uint batch_start = (row / pc.seq_len) * pc.seq_len;
    uint sequence_index = row % pc.seq_len;
    uint cumulative = 0u;
    for (uint position = 0u; position <= sequence_index; ++position) {
        if (token_ids[batch_start + position] != pc.padding_idx) cumulative += 1u;
    }

    bool is_padding = token_ids[row] == pc.padding_idx;
    uint embedding_index = is_padding ? pc.padding_idx : (pc.padding_idx + cumulative);
    if (embedding_index >= pc.table_rows) return;

    uint index = row * pc.dim + col;
    output_values[index] =
        token_values[index] * pc.embedding_scale + position_values[embedding_index * pc.dim + col];
}
