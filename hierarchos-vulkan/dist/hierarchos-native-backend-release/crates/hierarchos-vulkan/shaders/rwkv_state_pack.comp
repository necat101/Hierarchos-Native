#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer XNormBuffer { float x_norm[]; };
layout(set = 0, binding = 1, std430) readonly buffer XNorm2Buffer { float x_norm2[]; };
layout(set = 0, binding = 2, std430) readonly buffer VFirstBuffer { float v_first[]; };
layout(set = 0, binding = 3, std430) readonly buffer OutputBuffer { float output_values[]; };
layout(set = 0, binding = 4, std430) readonly buffer MatrixStateBuffer { float matrix_state[]; };
layout(set = 0, binding = 5, std430) writeonly buffer PackedStateBuffer { float packed_state[]; };

layout(push_constant) uniform Push {
    uint batch;
    uint width;
    uint head_size;
    uint matrix_offset;
    float state_clamp;
} pc;

float clamp_preserve_nonfinite(float value) {
    if (isnan(value) || isinf(value) || pc.state_clamp <= 0.0) {
        return value;
    }
    return clamp(value, -pc.state_clamp, pc.state_clamp);
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    uint vector_len = pc.batch * pc.width;
    uint state_size = pc.matrix_offset + pc.head_size;
    uint packed_len = vector_len * state_size;
    if (index >= packed_len) {
        return;
    }
    uint vector_index = index / state_size;
    uint slot = index - vector_index * state_size;
    float value;
    if (slot == 0u) {
        value = x_norm[vector_index];
    } else if (slot == 1u) {
        value = x_norm2[vector_index];
    } else if (slot == 2u) {
        value = v_first[vector_index];
    } else if (pc.matrix_offset == 4u && slot == 3u) {
        value = output_values[vector_index];
    } else {
        uint column = slot - pc.matrix_offset;
        value = matrix_state[vector_index * pc.head_size + column];
    }
    packed_state[index] = clamp_preserve_nonfinite(value);
}
