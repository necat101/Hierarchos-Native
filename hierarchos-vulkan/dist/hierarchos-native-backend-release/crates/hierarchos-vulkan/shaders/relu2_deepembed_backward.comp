#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer GradOutputBuffer { float grad_output[]; };
layout(set = 0, binding = 1, std430) readonly buffer KeyBuffer { float key_values[]; };
layout(set = 0, binding = 2, std430) readonly buffer DeepEmbedBuffer { float deepembed[]; };
layout(set = 0, binding = 3, std430) writeonly buffer GradKeyBuffer { float grad_key[]; };
layout(set = 0, binding = 4, std430) writeonly buffer GradDeepEmbedBuffer { float grad_deepembed[]; };

layout(push_constant) uniform Push {
    uint len;
    float key_clamp;
    float deepembed_clamp;
} pc;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pc.len) {
        return;
    }
    float raw_key = key_values[index];
    float raw_deep = deepembed[index];
    float key = raw_key;
    float deep = raw_deep;
    float key_scale = 1.0;
    float deep_scale = 1.0;
    if (pc.key_clamp > 0.0 && !isnan(raw_key) && !isinf(raw_key)) {
        key = clamp(raw_key, -pc.key_clamp, pc.key_clamp);
        key_scale = abs(raw_key) <= pc.key_clamp ? 1.0 : 0.0;
    }
    if (pc.deepembed_clamp > 0.0 && !isnan(raw_deep) && !isinf(raw_deep)) {
        deep = clamp(raw_deep, -pc.deepembed_clamp, pc.deepembed_clamp);
        deep_scale = abs(raw_deep) <= pc.deepembed_clamp ? 1.0 : 0.0;
    }
    float activated = max(key, 0.0);
    float grad = grad_output[index];
    grad_key[index] = grad * deep * 2.0 * activated * key_scale;
    grad_deepembed[index] = grad * activated * activated * deep_scale;
}
