#version 450

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer GradOutputBuffer { float grad_output[]; };
layout(set = 0, binding = 1, std430) readonly buffer InputBuffer { float x[]; };
layout(set = 0, binding = 2, std430) readonly buffer WeightBuffer { float weight[]; };
layout(set = 0, binding = 3, std430) readonly buffer MeanBuffer { float mean_values[]; };
layout(set = 0, binding = 4, std430) readonly buffer RstdBuffer { float rstd_values[]; };
layout(set = 0, binding = 5, std430) writeonly buffer GradInputBuffer { float grad_input[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint dim;
    uint parameter_groups;
} pc;

void main() {
    uint row = gl_GlobalInvocationID.x;
    if (row >= pc.rows) {
        return;
    }
    uint base = row * pc.dim;
    uint parameter_base = (row % pc.parameter_groups) * pc.dim;
    float mean = mean_values[row];
    float rstd = rstd_values[row];
    float sum_dxhat = 0.0;
    float sum_dxhat_xhat = 0.0;
    for (uint col = 0; col < pc.dim; ++col) {
        float xhat = (x[base + col] - mean) * rstd;
        float dxhat = grad_output[base + col] * weight[parameter_base + col];
        sum_dxhat += dxhat;
        sum_dxhat_xhat = fma(dxhat, xhat, sum_dxhat_xhat);
    }
    float inv_dim = 1.0 / float(pc.dim);
    float mean_dxhat = sum_dxhat * inv_dim;
    float mean_dxhat_xhat = sum_dxhat_xhat * inv_dim;
    for (uint col = 0; col < pc.dim; ++col) {
        float xhat = (x[base + col] - mean) * rstd;
        float dxhat = grad_output[base + col] * weight[parameter_base + col];
        grad_input[base + col] = rstd * (dxhat - mean_dxhat - xhat * mean_dxhat_xhat);
    }
}
