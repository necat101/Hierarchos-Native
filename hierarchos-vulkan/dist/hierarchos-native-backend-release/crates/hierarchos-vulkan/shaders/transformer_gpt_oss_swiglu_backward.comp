#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer GradOutputBuffer { float grad_output[]; };
layout(set = 0, binding = 1, std430) readonly buffer GateBuffer { float gate_values[]; };
layout(set = 0, binding = 2, std430) readonly buffer UpBuffer { float up_values[]; };
layout(set = 0, binding = 3, std430) writeonly buffer GradGateBuffer { float grad_gate[]; };
layout(set = 0, binding = 4, std430) writeonly buffer GradUpBuffer { float grad_up[]; };

layout(push_constant) uniform Push { uint len; } pc;

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= pc.len) return;

    float raw_gate = gate_values[index];
    float raw_up = up_values[index];
    float gate = min(raw_gate, 7.0);
    float up = clamp(raw_up, -7.0, 7.0);
    float sigmoid_gate = 1.0 / (1.0 + exp(-1.702 * gate));
    float glu = gate * sigmoid_gate;
    float grad = grad_output[index];

    float d_glu_d_gate = sigmoid_gate
        + 1.702 * gate * sigmoid_gate * (1.0 - sigmoid_gate);
    float gate_clamp_grad = raw_gate <= 7.0 ? 1.0 : 0.0;
    float up_clamp_grad = (raw_up >= -7.0 && raw_up <= 7.0) ? 1.0 : 0.0;

    grad_gate[index] = grad * (up + 1.0) * d_glu_d_gate * gate_clamp_grad;
    grad_up[index] = grad * glu * up_clamp_grad;
}
