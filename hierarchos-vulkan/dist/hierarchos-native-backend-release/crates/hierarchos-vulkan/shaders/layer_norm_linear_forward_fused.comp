#version 450

// Fuses the final out_norm LayerNorm with the tied LM-head projection while
// preserving the exact LayerNorm tape needed by backward. Each workgroup owns
// one row and a 64-column vocabulary tile. The row statistics are recomputed
// per tile so the vocabulary dimension stays massively parallel; only tile 0
// materializes norm_hidden/mean/rstd for the existing backward kernels.
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0, std430) readonly buffer InputBuffer { float x[]; };
layout(set = 0, binding = 1, std430) readonly buffer NormWeightBuffer { float norm_weight[]; };
layout(set = 0, binding = 2, std430) readonly buffer NormBiasBuffer { float norm_bias[]; };
layout(set = 0, binding = 3, std430) readonly buffer LinearWeightBuffer { float linear_weight[]; };
layout(set = 0, binding = 4, std430) writeonly buffer NormOutputBuffer { float norm_output[]; };
layout(set = 0, binding = 5, std430) writeonly buffer MeanBuffer { float mean_values[]; };
layout(set = 0, binding = 6, std430) writeonly buffer RstdBuffer { float rstd_values[]; };
layout(set = 0, binding = 7, std430) writeonly buffer LogitsBuffer { float logits[]; };

layout(push_constant) uniform Push {
    uint rows;
    uint input_dim;
    uint output_dim;
    float eps;
} pc;

shared float shared_mean;
shared float shared_rstd;
shared float normalized_tile[64];

void main() {
    uint row = gl_WorkGroupID.y;
    uint lane = gl_LocalInvocationID.x;
    uint out_col = gl_GlobalInvocationID.x;
    bool valid_row = row < pc.rows;

    if (lane == 0) {
        if (valid_row) {
            uint x_base = row * pc.input_dim;
            float mean = 0.0;
            for (uint col = 0; col < pc.input_dim; ++col) {
                mean += x[x_base + col];
            }
            mean /= float(pc.input_dim);

            float variance = 0.0;
            for (uint col = 0; col < pc.input_dim; ++col) {
                float centered = x[x_base + col] - mean;
                variance = fma(centered, centered, variance);
            }
            variance /= float(pc.input_dim);
            float rstd = inversesqrt(variance + pc.eps);
            shared_mean = mean;
            shared_rstd = rstd;

            // A single vocabulary tile owns the backward tape, avoiding
            // same-address multi-workgroup writes while preserving the old
            // standalone LayerNorm outputs bit-for-bit where the driver does.
            if (gl_WorkGroupID.x == 0) {
                mean_values[row] = mean;
                rstd_values[row] = rstd;
            }
        } else {
            shared_mean = 0.0;
            shared_rstd = 0.0;
        }
    }

    barrier();

    float mean = shared_mean;
    float rstd = shared_rstd;
    float sum = 0.0;
    uint x_base = row * pc.input_dim;
    bool valid_output = valid_row && out_col < pc.output_dim;

    for (uint col_base = 0u; col_base < pc.input_dim; col_base += 64u) {
        uint col = col_base + lane;
        float value = 0.0;
        if (valid_row && col < pc.input_dim) {
            float normalized = (x[x_base + col] - mean) * rstd;
            value = fma(normalized, norm_weight[col], norm_bias[col]);
            if (gl_WorkGroupID.x == 0u) {
                norm_output[x_base + col] = value;
            }
        }
        normalized_tile[lane] = value;

        barrier();

        if (valid_output) {
            uint tile_count = min(64u, pc.input_dim - col_base);
            uint w_base = out_col * pc.input_dim + col_base;
            for (uint tile_col = 0u; tile_col < tile_count; ++tile_col) {
                sum = fma(normalized_tile[tile_col], linear_weight[w_base + tile_col], sum);
            }
        }

        barrier();
    }

    if (valid_output) {
        logits[row * pc.output_dim + out_col] = sum;
    }
}
